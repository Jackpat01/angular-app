@*
    DO NOT MODIFY OUTSIDE OF MSLC.STATLOG
    This file comes from MSLC.Statlog, any changes to it will be wiped out when the nuget package is updated.
    Please make the appropriate enhancements to MSLC.Statlog instead of here.
*@

@Styles.Render("~/Content/StatLog.css")
@using MSLC.Portal.MVC.Utility
@using MSLC.StatLog.MVC.ViewModels
@using MSLC.StatLog.UI.Models
@model AddMetadataViewModel.View
@Html.Script("~/Scripts/Pages/StatLog/ShowAddInteractive.js", "jquery")
<script src="@Url.AbsoluteContent("~/Scripts/MSLCComponents/XMLSchemaDisplay.js")"></script>
@{
    Layout = null;
}
<script type="text/javascript">
    $(document).ready(function () {
        $('.datefield').datepicker({
            onClose: function () {
                $(this).valid();
            }
        });
    });
</script>
<div class="modal-content">
    <div class="modal-header">
        <span id="myModalLabel" style="text-align: left; font-size: 1.5em; font-weight: bolder;" color:black;>
            Metadata for "@Model.InitialEventName"
        </span>
        <button href="#" class="close" data-dismiss="modal">&times;</button>
    </div>
    @using (Html.BeginForm("SaveAddMetadata", "Metadata", FormMethod.Post, new { id = "frmSubmit", enctype = "multipart/form-data", @class = "modal-form" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(x => x.sHistoryID, new { id = "hdnHistoryID" })

        <div class="myImage" style="display: none;">
            <center>
                <img src="~/Images/loading.gif" alt="Loading" width="32" height="32" />
                <h3>Saving...</h3>
            </center>
        </div>
        <div class="myControls">
            <div style="padding-left:15px; margin: 8px;" class="d-flex flex-column">
                <div>
                    @foreach (AddMetadataViewModel.XMLSchemaList schema in Model.XMLSchemas)
                    {
                        @Html.Raw(@Html.XMLSchemaDisplay(schema.XMLSchemaString, schema.ID, schema.DefaultXMLData))
                    }
                </div>
                <div class="d-flex justify-content-center">
                    <button type="submit" name="Command" id="btnSave" value="Save" class="btn btn-success BoldMe">Save</button>
                    <button class="btn btn-primary BoldMe" data-dismiss="modal" aria-hidden="true">Close</button>
                </div>
            </div>
        </div>
    }
</div>
<div id="SyncFusionScript">
    <script src="@Url.AbsoluteContent("~/Scripts/ej/common/ej.unobtrusive.min.js")"></script>
</div>