@* DO NOT MODIFY OUTSIDE OF MSLC.STATLOG
    This file comes from MSLC.Statlog, any changes to it will be wiped out when the nuget package is updated.
    Please make the appropriate enhancements to MSLC.Statlog instead of here.*@

@using MSLC.StatLog.MVC.ViewModels
@using MSLC.Portal.MVC.Utility
@Styles.Render("~/Content/StatLog.css")
@model PHIWarningViewModel.View
@{
    Layout = null;
}

<script>
    function Download() {
        document.getElementById("btnClose").click();
    }
</script>

<div id="PHIWarningModal" class="modal-content">
    <div class="modal-header">
        <span id="myModalLabel" style="text-align: left; font-size: 1.5em; font-weight: bolder; color: black;">
            PHI Warning
        </span>
        <button href="#" class="close" data-dismiss="modal">&times;</button>
    </div>
    <div style="padding-left: 15px; margin: 8px;">
        WARNING: You are about to download a file that may contain PHI
        <div class="myControls">
            @using (Html.BeginForm("PHIWarning", "Statlog", FormMethod.Post, new { id = "frmSubmit", enctype = "multipart/form-data", @class = "modal-form", defaultbutton = "btnDownload" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(x => x.sHistoryID)
                <div style="text-align:center; padding:20px">

                    <button id="btnClose" class="btn btn-basic BoldMe" data-dismiss="modal" aria-hidden="true">Close</button>
                    <button id="btnDownload" style="margin-left:20px" class="btn btn-success BoldMe" name="Command" value="Download" onclick="Download()">Download</button>

                </div>
            }
            <div id="modalFooter" class="modal-footer">
            </div>
        </div>
    </div>
</div>
