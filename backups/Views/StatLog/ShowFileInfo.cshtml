@*
    DO NOT MODIFY OUTSIDE OF MSLC.STATLOG
    This file comes from MSLC.Statlog, any changes to it will be wiped out when the nuget package is updated.
    Please make the appropriate enhancements to MSLC.Statlog instead of here.
*@

@Styles.Render("~/Content/StatLog.css")
@using MSLC.StatLog.Configuration
@model MSLC.StatLog.MVC.ViewModels.FileInfoViewModel.View
@{
    Layout = null;
}
<div class="modal-content">
    <div class="modal-header">
        <span id="myModalLabel" style="text-align: left; font-size: 1.5em; font-weight: bolder; color: black;">
            File Information - @Model.InitialEventName
        </span>
        <button href="#" class="close" data-dismiss="modal">&times;</button>
    </div>
    <div style="padding-left:15px; margin: 8px;">
        <table width="100%" cellpadding="2" cellspacing="2">
            @{
                if (Model.FileFoundInARUM)
                {
                    <tr>
                        <td width="20%" align="right">
                            File:
                        </td>
                        <td width="80%" align="left">
                            @Html.DisplayFor(x => x.FileName, new { id = "lblFileName" })
                        </td>
                    </tr>
                    <tr>
                        <td width="20%" nowrap align="right">
                            Modified Date:
                        </td>
                        <td width="80%" align="left">
                            @Html.DisplayFor(x => x.ModifiedDate, new { id = "lblModifiedDate" })
                        </td>
                    </tr>
                    <tr>
                        <td width="20%" align="right">
                            Size:
                        </td>
                        <td width="80%" align="left">
                            @Html.DisplayFor(x => x.FileSizeString, new { id = "lblFileSize" })
                        </td>
                    </tr>
                    <tr>
                        <td width="20%" align="right">
                            Uploaded By:
                        </td>
                        <td width="80%" align="left">
                            @Html.DisplayFor(x => x.UploadedBy, new { id = "lblUploadedBy" })
                        </td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td width="20%" align="right">
                            File Information:
                        </td>
                        <td width="80%" align="left">
                            File Inactive
                        </td>
                    </tr>
                }
            }

            <tr>
                <td width="20%" valign="top" align="right">
                    <label for="txtNotes">Notes:</label>
                </td>
                <td width="80%" align="left">
                    <textarea rows="10" cols="1" id="txtNotes" readonly style="width: 95% !important; text-align: left;">@MvcHtmlString.Create(Model.Notes.Trim())</textarea>
                </td>
            </tr>
            <tr>
                <td colspan="2" align="center">
                    <button class="btn btn-primary BoldMe" data-dismiss="modal" aria-hidden="true">Close</button>
                </td>
            </tr>
        </table>
    </div>
</div>
