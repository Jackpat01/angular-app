@*
    DO NOT MODIFY OUTSIDE OF MSLC.STATLOG
    This file comes from MSLC.Statlog, any changes to it will be wiped out when the nuget package is updated.
    Please make the appropriate enhancements to MSLC.Statlog instead of here.
*@

@Styles.Render("~/Content/StatLog.css")
@model MSLC.StatLog.MVC.ViewModels.NotApplicableViewModel.View
@{
    Layout = null;
}

<div class="modal-content">
    <div class="modal-header">
        @*
            DO NOT MODIFY OUTSIDE OF MSLC.STATLOG
            This file comes from MSLC.Statlog, any changes to it will be wiped out when the nuget package is updated.
            Please make the appropriate enhancements to MSLC.Statlog instead of here.
        *@

        <span id="myModalLabel" style="text-align: left; font-size: 1.5em; font-weight: bolder; color: black;">
            N/A Event - @Model.InitialEventName
        </span>
        <a href="#" class="close" data-dismiss="modal">&times;</a>
    </div>
    @using (Html.BeginForm("SaveNA", "StatLog", FormMethod.Post, new { id = "frmSubmitFile", enctype = "multipart/form-data", @class = "modal-form" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(x => x.sHistoryID)
        <div class="myImage" style="display: none;">
            <center>
                <img src="~/Images/loading.gif" alt="Loading" width="32" height="32" />
                <h3>Saving...</h3>
            </center>
        </div>
        <div class="myControls">
            <div style="padding-left:15px; margin: 8px;">
                <table style="width: 100%;">
                    <tr>
                        <td width="85%" align="left">
                            <label for="txtNotes">Notes:</label>
                            @if (Model.ReadOnly)
                            {
                                @Html.TextAreaFor(x => x.Notes, 20, 1, new { id = "txtNotes", @readonly = true, @style = "width: 95% !important;", maxLength = 1000 })
                            }
                            else
                            {
                                @Html.TextAreaFor(x => x.Notes, 20, 1, new { id = "txtNotes", @style = "width: 95% !important;", maxLength = 1000 })
                            }
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2" align="center">
                            @if (!Model.ReadOnly)
                            {
                                <button type="submit" name="Command" id="btnSave" value="Save" class="btn btn-success BoldMe" onclick="return CheckNotes();">Save</button>
                            }
                            <button class="btn btn-primary BoldMe" data-dismiss="modal" aria-hidden="true">Close</button>
                            <br />
                            <br />
                            <div class="errorLabel" id="spannotes"></div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    }
</div>