@*
    DO NOT MODIFY OUTSIDE OF MSLC.STATLOG
    This file comes from MSLC.Statlog, any changes to it will be wiped out when the nuget package is updated.
    Please make the appropriate enhancements to MSLC.Statlog instead of here.
*@

@Styles.Render("~/Content/StatLog.css")
@using MSLC.Portal.MVC.Utility
@using MSLC.StatLog.MVC.ViewModels
@model AddInteractiveViewModel.View
@Html.Script("~/Scripts/Pages/StatLog/ShowAddInteractive.js", "jquery")
<script src="@Url.AbsoluteContent("~/Scripts/MSLCComponents/XMLSchemaDisplay.js")"></script>

@{
    Layout = null;
}
<script type="text/javascript">
    $(document).ready(function () {
        $('.datefield').datepicker({
            onClose: function () {
                $(this).valid();
            }
        });
    });
</script>
<div class="modal-content">
    <div class="modal-header">
        <span id="myModalLabel" style="text-align: left; font-size: 1.5em; font-weight: bolder; color:black;">
            Add "@Model.Event"
        </span>
        <button href="#" class="close" data-dismiss="modal">&times;</button>
    </div>
    @using (Html.BeginForm("SaveAddInteractive", "StatLog", FormMethod.Post, new { id = "frmSubmit", enctype = "multipart/form-data", @class = "modal-form" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(x => x.sCostReportID, new { id = "hdnCostReportID" })
        @Html.HiddenFor(x => x.sEventID, new { id = "hdnEventID" })
        @Html.HiddenFor(x => x.SetEventDateState, new { id = "hdnSetEventDateState" })
        @Html.HiddenFor(x => x.SetExpectedDateState, new { id = "hdnSetExpectedDateState" })
        @Html.HiddenFor(x => x.AssignUser, new { id = "hdnAssignStateUser" })

        <div class="myImage" style="display: none;">
            <center>
                <img src="~/Images/loading.gif" alt="Loading" width="32" height="32" />
                <h3>Saving...</h3>
            </center>
        </div>
        <div class="myControls">
            <div style="padding-left:15px; margin: 8px;">
                <table style="width: 100%;">

                    @if (Model.SetEventDateState)
                    {
                        <tr>
                            <td width="20%" align="right">
                                <label for="txtEventDate">Event Date:</label>
                            </td>
                            <td width="75%" align="left">
                                @Html.TextBoxFor(x => x.EventDate, "{0:MM/dd/yyyy}", new { ID = "txtEventDate", @class = "datefield", type = "text", @style = "width: 100px" })
                            </td>
                        </tr>
                        if (Model.SetExpectedDateState)
                        {
                            <tr>
                                <td width="20%" align="right">
                                    <label for="txtExpectedDate">Expected Date:</label>
                                </td>
                                <td width="75%" align="left">
                                    @Html.TextBoxFor(x => x.ExpectedDate, new { ID = "txtExpectedDate", @class = "datefield", type = "text", @style = "width: 100px" })
                                </td>
                            </tr>
                        }
                    }
                    @if (Model.AssignUser)
                    {
                        <tr>
                            <td width="20%" valign="top" align="right">
                                <label for="ddlAssignableUsers">Assign To:</label>
                            </td>
                            <td width="75%" align="left">
                                @Html.DropDownListFor(x => x.sAssignedUserID, Model.AssignableUsersSelectList, new { ID = "ddlAssignableUsers" })
                            </td>
                        </tr>
                    }
                    <tr>
                        <td width="20%" valign="top" align="right">
                            <label for="txtNotes">Notes:</label>
                        </td>
                        <td width="75%" align="left">
                            @Html.TextAreaFor(x => x.Notes, 5, 1, new { id = "txtNotes", @style = "width: 95% !important;", maxLength = 1000 })
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2" align="center">
                            <button type="submit" name="Command" id="btnSave" value="Save" class="btn btn-success BoldMe">Save</button>
                            <button class="btn btn-primary BoldMe" data-dismiss="modal" aria-hidden="true">Close</button>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    }
</div>
<div id="SyncFusionScript">
    <script src="@Url.AbsoluteContent("~/Scripts/ej/common/ej.unobtrusive.min.js")"></script>
</div>