@*
    DO NOT MODIFY OUTSIDE OF MSLC.STATLOG
    This file comes from MSLC.Statlog, any changes to it will be wiped out when the nuget package is updated.
    Please make the appropriate enhancements to MSLC.Statlog instead of here.
*@

@model MSLC.StatLog.MVC.ViewModels.ReviewViewModel.View
@Styles.Render("~/Content/StatLog.css")
@{
    Layout = null;
}
<div class="modal-content">
    <div class="modal-header">
        <span id="myModalLabel" style="text-align: left; font-size: 1.5em; font-weight: bolder; color:black">
            Review - @Model.InitialEventName
        </span>
        <button href="#" class="close" data-dismiss="modal">&times;</button>
    </div>
    <div style="padding-left: 15px; margin: 8px;">
        @using (Html.BeginForm("SaveReview", "StatLog", FormMethod.Post, new { id = "frmReview", enctype = "multipart/form-data", @class = "modal-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(x => x.sHistoryID)
            <div class="myImage" style="display: none;">
                <center>
                    <img src="~/Images/loading.gif" alt="Loading" width="32" height="32" />
                    <h3>Saving...</h3>
                </center>
            </div>
            <div class="myControls">
                <table width="100%" cellpadding="4" cellspacing="4">
                    <tr>
                        <td width="20%" nowrap align="right">
                            Review User ID:
                        </td>
                        <td width="80%" align="left">
                            @Html.DisplayFor(x => x.ReviewUserName, new { id = "lblReviewUserID" })
                        </td>
                    </tr>
                    @if (!String.IsNullOrWhiteSpace(Model.FileType) && !Model.IsEventReview)
                    {
                        <tr>
                            <td width="20%" nowrap align="right">
                                Review File Type:
                            </td>
                            <td width="80%" align="left">
                                @Html.DisplayFor(x => x.FileType, new { id = "lblFileType" })
                            </td>
                        </tr>
                    }
                    <tr>
                        <td width="20%" nowrap align="right">
                            Review Date:
                        </td>
                        <td width="80%" align="left">
                            @Html.DisplayFor(x => x.ReviewDate, new { id = "lblReviewDate" })
                        </td>
                    </tr>
                    @if (!String.IsNullOrWhiteSpace(Model.ReviewText))
                    {
                        <tr>
                            <td width="20%" nowrap align="right">
                                Review Text:
                            </td>
                            <td align="left" style="background: white;">
                                <div>
                                    @Html.TextAreaFor(x => x.ReviewText, new { id = "txtReviewText", @style = "width:95%; height: 275px;", @readonly = true, aria_label="Review Text" })
                                </div>
                            </td>
                        </tr>
                    }
                    <tr>
                        <td width="20%" valign="top" align="right">
                            Notes:
                        </td>
                        <td width="80%" align="left">
                            @Html.TextAreaFor(x => x.Notes, 10, 1, new { id = "txtReviewNotes", @style = "width: 95% !important; text-align: left;", aria_label="Review Notes" })
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2" align="center">
                            @if (Model.CanReleaseReview)
                            {
                                <button type="submit" name="Command" id="btnReleaseReview" value="ReleaseReview" class="btn btn-warning BoldMe">Release Review</button>
                            }
                            @if (Model.CanAcceptReview)
                            {
                                <button type="submit" name="Command" id="btnAccept" value="Accept" class="btn btn-success BoldMe">@Model.ReviewAcceptText</button>
                            }
                            @if (Model.CanRejectReview)
                            {
                                <button type="submit" name="Command" id="btnReject" value="Reject" class="btn btn-danger BoldMe" onclick="return CheckNotes();">@Model.ReviewRejectText</button>
                            }
                            <button class="btn btn-primary BoldMe" data-dismiss="modal" aria-hidden="true">Close</button>
                            <br />
                            <br />
                            <div class="errorLabel" id="spannotes"></div>
                        </td>
                    </tr>
                </table>
            </div>
        }
    </div>
</div>