@*
    DO NOT MODIFY OUTSIDE OF MSLC.STATLOG
    This file comes from MSLC.Statlog, any changes to it will be wiped out when the nuget package is updated.
    Please make the appropriate enhancements to MSLC.Statlog instead of here.
*@

@model MSLC.StatLog.MVC.ViewModels.NotesViewModel.View
@Styles.Render("~/Content/StatLog.css")
@{
    Layout = null;
}

<div class="modal-content">
    <div class="modal-header">
        <span id="myModalLabel" style="text-align: left; font-size: 1.5em; font-weight: bolder;" color:black;>
            Event Notes - @Model.InitialEventName
        </span>
        <button href="#" class="close" data-dismiss="modal">&times;</button>
    </div>
    @using (Html.BeginForm("SaveNotApplicable", "StatLog", FormMethod.Post, new { id = "frmSubmitFile", enctype = "multipart/form-data", @class = "modal-form" }))
    {
        @Html.AntiForgeryToken()
        <div class="myImage" style="display: none;">
            <center>
                <img src="~/Images/loading.gif" alt="Loading" width="32" height="32" />
                <h3>Saving...</h3>
            </center>
        </div>
        <div class="myControls">
            <div style="padding-left:15px; margin: 8px;">
                <table style="width: 100%;">
                    <tr>
                        <td width="10%" valign="top" align="right">Notes:</td>
                        <td width="85%" align="left">
                            @Html.TextAreaFor(x => x.Notes, 20, 1, new { id = "txtNotes", @readonly = true, @style = "width: 95% !important;", maxLength = 1000 })
                        </td>
                    </tr>
                </table>
                <div align="center" style="margin-left: auto; margin-right: auto;"><button class="btn btn-primary BoldMe" data-dismiss="modal" aria-hidden="true" style="margin-left: auto; margin-right: auto;">Close</button></div>
            </div>
        </div>

    }
</div>