@model WebPortal_OH_FI.Models.CostReportSubmissionModel
<div>
    <div id="noticeTextHeader" style="text-align: left; margin: .5rem 0">
        <h1>Cost Report Upload</h1>
        <p>Uploading a facility cost report sets a flag to indicate that this facility cost report is the one that you wish to upload as your final submission to @Model.SubmissionAuthority.</p>
    </div>
    <div id="lockedText" style="text-align: left; display: none; margin: .5rem 0">
        <p>
            <b>This cost report version has been Locked; cost report cannot be changed at this time.</b>
        </p>
    </div>
    @*<div id="serverCalcText" style="text-align: left; display: none; margin: .5rem 0">
            <p><b>Using server calculations.</b></p>
        </div>*@
    @*<div id="localCalcText" style="text-align: left; display: none; margin: .5rem 0">
            <p><b>Using local calculations.</b></p>
        </div>*@
    <div style="text-align: left; margin: .5rem 0">
        <p>
            <b>
                <span id="costReportMessage">@Model.CostReportMessage</span>
            </b>
        </p>
    </div>
    <div style="text-align: left">
        <button type="submit" id="buttonLockCostReport" class="btn btn-success" value="Lock" disabled=@(!Model.CanLockCostReport) title="Lock cost report for submission">Lock</button>
        <button type="submit" id="buttonSubmitCostReport" class="btn btn-success" value="Upload" disabled=@(!Model.CanSubmitCostReport) title="Submit/Generate upload file for cost report">Upload</button>
        <!--
        <button type="submit" id="buttonLocalCalculation" class="btn btn-success" value="LocalCalc" title="Toggle local/server calculations">Toggle Calculations</button>
        -->
    </div>
</div>

<script>
    $(document).ready(function() {
        var unresolvedExceptions = false; //@Json.Encode(Model.UnresolvedExceptions);
        var isSubmitted = @Json.Encode(Model.CostReportIsSubmitted);
        var isLocked = @Json.Encode(Model.CostReportIsLocked);
        window.useLocalCalculations = @Json.Encode(Model.LocalCalculations);
        var isOutsideScope = @Json.Encode(Model.CostReportIsOutsideScope);
        var canSubmitCostReport = @Json.Encode(Model.CanSubmitCostReport);
        var costReportUsed = @Json.Encode(Model.CostReportUsedInRate);

        @*// show toggle button to all users.
        $("#buttonLocalCalculation").show();
        if (@Json.Encode(@Model.CanToggleLocalCalculations)) $("#buttonLocalCalculation").show();
        else $("#buttonLocalCalculation").hide();*@

        function CheckStatus() {
            $("#lockedText").hide();

            if (isSubmitted) {
                // If it is submitted, there is nothing more to do.
                $("#buttonSubmitCostReport").prop("disabled", true);
                $("#buttonLockCostReport").prop("disabled", true);
            } else if (unresolvedExceptions) {
                // Exceptions need to be resolved, cannot lock or submit.
                $("#buttonSubmitCostReport").prop("disabled", true);

                if (isLocked) {
                    $("#buttonLockCostReport").text("Unlock");
                    $("#lockedText").show();
                } else {
                    $("#lockedText").hide();
                    $("#buttonLockCostReport").text("Lock");
                }
            } else if (isOutsideScope) {
                // If it is outside scope, cannot submit.
                $("#buttonSubmitCostReport").prop("disabled", true);

                // However, can still lock cost report to keep from editing.
                if (isLocked) {
                    $("#buttonLockCostReport").text("Unlock");
                    $("#lockedText").show();
                } else {
                    $("#lockedText").hide();
                    $("#buttonLockCostReport").text("Lock");
                }
            } else {
                // No errors or other blockers
                // At this point, if it is locked, we can submit.
                if (isLocked) {
                    if (canSubmitCostReport && costReportUsed) {
                        $("#lockedText").show();
                        $("#buttonLockCostReport").text("Unlock");
                        $("#buttonSubmitCostReport").prop("disabled", false);
                    } else {
                        $("#lockedText").show();
                        $("#buttonLockCostReport").text("Unlock");
                        $("#buttonSubmitCostReport").prop("disabled", true);
                    }
                }
                else {
                    $("#lockedText").hide();
                    $("#buttonLockCostReport").text("Lock");
                    $("#buttonSubmitCostReport").prop("disabled", true);
                }
            }

            //if (window.useLocalCalculations) {
            //    $("#localCalcText").show();
            //    $("#serverCalcText").hide();
            //}
            //else {
            //    $("#localCalcText").hide();
            //    $("#serverCalcText").show();
            //}
        }

        // Update buttons
        CheckStatus();

        $("#buttonLockCostReport").bind("click",
            function() {
                var url = '@Url.AbsoluteAction("LockCostReport", "CostReport")';
                var dialogText = "";
                if ($("#buttonLockCostReport").text() === "Unlock") {
                    url = '@Url.AbsoluteAction("UnLockCostReport", "CostReport")';
                    dialogText = "Unlocking Cost Report...";
                } else {
                    dialogText = "Locking Cost Report...";
                }
                LoadNotificationDialog(`${dialogText}`).then(() => {
                    return new Promise((resolve, reject) => {
                        $.ajax({
                            async: true,
                            url: url,
                            data: {},
                            type: "POST",
                            success: function(response) {
                                if (response === null) {
                                    StaticAlert({ content: "There was no response for the request." }).then(() => {
                                        resolve();
                                    });
                                    return;
                                }

                                if (!!response.Message) {
                                    StaticAlert({ content: response.Message }).then(() => {
                                        resolve();
                                    });
                                    return;
                                }

                                if (!!response.Success) {
                                    if ($("#buttonLockCostReport").text() === "Unlock") {
                                        // we unlocked the cost report.
                                        isLocked = false;
                                        window.CostReport.CostReportLocked = false;
                                        window.CostReport.CostReportEditable = !window.CostReport.CostReportIsSubmitted;
                                        window.CostReportLocked = window.CostReport.CostReportIsSubmitted || window.CostReport.CostReportLocked || !window.CostReport.CostReportEditable;
                                    } else {
                                        // we locked the cost report.
                                        isLocked = true;
                                        window.CostReport.CostReportLocked = true;
                                        window.CostReport.CostReportEditable = false;
                                        window.CostReportLocked = window.CostReport.CostReportIsSubmitted || window.CostReport.CostReportLocked || !window.CostReport.CostReportEditable;
                                    }
                                }

                                // Regardless of success, we need to continue processing to unlock UI.
                                resolve();
                            },
                            error: function(a, b, c) {
                                StaticAlert({ content: "An error occured while submitting the cost report." }).then(() => {
                                    reject();
                                });
                                return false;
                            }
                        });
                    });
                }).then(() => {
                    CheckStatus();
                }).then(() => {
                    return ClearNotificationDialog();
                });
            });

        $("#buttonSubmitCostReport").bind("click",
            function() {
                LoadNotificationDialog("Submitting Cost Report...").then(() => {
                    return new Promise((resolve, reject) => {
                        $("#buttonSubmitCostReport").prop("disabled", true);
                        $("#SubmitWait").show();

                        $.ajax({
                            async: true,
                            url: '@Url.AbsoluteAction("SubmitCostReport", "CostReport")',
                            data: {},
                            type: "POST",
                            success: function(response) {
                                if (response === null) {
                                    StaticAlert({ content: "There was no response for the request." }).then(() => {
                                        resolve();
                                    });
                                } else {

                                    // update flag.
                                    unresolvedExceptions = response.unresolvedExceptions;

                                    if (!!response.Message) {
                                        return StaticAlert({ content: response.Message }).then(() => {
                                            resolve();
                                        });
                                    }

                                    if (!!response.Success) {
                                        var url = '@Url.AbsoluteAction("GetFile", "Download")' + "?key=" + response.Key + "&filename=" + response.Filename;
                                        window.location = url;

                                        // update flag
                                        isSubmitted = true;
                                        window.CostReport.CostReportIsSubmitted = true;
                                        window.CostReport.CostReportEditable = false;
                                        window.CostReportLocked = window.CostReport.CostReportIsSubmitted || window.CostReport.CostReportLocked || !window.CostReport.CostReportEditable;
                                        $("#costReportMessage").text(response.CostReportMessage);

                                        CheckStatus();

                                        // Update document number UI
                                        $("#Document").text(response.DocumentNumber);
                                        // this is an asynchronous call, and execution will "fall through" before it returns.
                                        // update: wrapping in a promise, have it return when complete.
                                        window.CostReport.Selection.LoadDocumentIndex().then(() => {
                                            resolve();
                                        });
                                    } else {
                                        // if there is no "Success" property, or the property is not TRUE, then there is an issue.
                                        resolve();
                                    }
                                }
                            },
                            error: function(a, b, c) {
                                StaticAlert({ content: "An error occured while submitting the cost report." }).then(() => {
                                    reject();
                                });
                                return;
                            }
                        });
                    });
                }).then(() => {
                    $("#SubmitWait").hide();
                    CheckStatus();
                }).then(() => {
                    return ClearNotificationDialog();
                });
            });

        @*$("#buttonLocalCalculation").bind("click", function () {
            LoadNotificationDialog("Toggling local calculations...").then(() => {
                return new Promise((resolve, reject) => {
                    $.ajax({
                        async: true,
                        url: '@Url.AbsoluteAction("ToggleLocalCalculations", "CostReport")',
                        data: {},
                        type: "POST",
                        success: function (response) {
                            if (response === null) {
                                StaticAlert({ content: "There was no response for the request." }).then(() => {
                                    resolve();
                                });
                                return;
                            }

                            if (!!response.Message) {
                                StaticAlert({ content: response.Message }).then(() => {
                                    resolve();
                                });
                                return;
                            }

                            if (!!response.Success) {
                                window.useLocalCalculations = response.LocalCalculations;
                            }

                            // Regardless of success, we need to continue processing to unlock UI.
                            resolve();
                        },
                        error: function (a, b, c) {
                            StaticAlert({ content: "An error occured while submitting the cost report." }).then(() => {
                                reject();
                            });
                            return false;
                        }
                    });
                });
            }).then(() => {
                CheckStatus();
            }).then(() => {
                return ClearNotificationDialog();
            });
        });*@
    });
</script>
