@using MSLC.Portal.MVC.Utility
@using System.Linq
@using WebPortal_OH_FI.Common
@using WebPortal_OH_FI.Web
@model List<WebPortal_OH_FI.Models.ViewModels.SectionQViewModel>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutWithMenu.cshtml";
}
@Html.Script("~/Scripts/Pages/BulkProcessing/SectionQReportJobs.js", "jquery")

<h2>Section Q Reports</h2>

<div id="dialogDiv" class="modal fade" tabindex="-1" aria-labelledby="windowTitleLabel" aria-hidden="true" role="dialog">
    <div id="modal-dialog" class="modal-dialog" role="document">
        <div id="dialogContent" style="font-size: 14px; width:100%"></div>&nbsp;&nbsp;
        <div id="dialogMessage" style="font-size: 14px; width:100%"></div>&nbsp;&nbsp;
    </div>
</div>

@if (TempData["Message"] != null)
{
    <br />
    <div class="errorLabel" style="text-align: center;">
        @Html.Raw(TempData["Message"].ToString())
    </div>
}

<div id="dvProviders" style="margin-left: 50px; margin-right: 50px;">
    <div class="button-box">
        <a href="@Url.AbsoluteAction("SectionQReport", "Reports")" class="btn btn-kyBlue BoldMe">Generate Section Q Report</a>
    </div>

    @(Html.EJ().Grid<object>("tblBulkProcessing")
        .CssClass("mslcTable")
        .Datasource(Model.ToList())
        .AllowPaging()
        .Locale("en-US")
        .AllowSelection(false)
        .AllowSorting(true)
        .AllowFiltering(true)
        .AllowTextWrap(true)
        .MinWidth(100)
        .TextWrapSettings(wrap => { wrap.WrapMode(WrapMode.Both); })
        .FilterSettings(filter =>
        {
            filter.FilterType(FilterType.Menu);
            filter.ShowPredicate(false);
        })
        .ToolbarSettings(toolbar =>
        {
            toolbar.ShowToolbar().ToolbarItems(items =>
            {
                items.AddTool(ToolBarItems.Search);
            });
        })
        .Columns(col =>
        {
            col.Field("JobName").HeaderText("Job Name").TextAlign(TextAlign.Center).Width(35).Add();
            col.Field("ReportVersion").HeaderText("Report Version").TextAlign(TextAlign.Center).Width(20).Add();
            col.Field("ReportType").HeaderText("Report Type").TextAlign(TextAlign.Center).Width(18).Add();
            col.Field("CLSProvGrouping").HeaderText("CLS Provider Group").TextAlign(TextAlign.Center).Width(20).Add();
            col.Field("template.ReportEndDate").HeaderText("Reporting Period End Date").Type("date").Format("{0:MM/dd/yyyy}").TextAlign(TextAlign.Center).Width(22).Add();
            col.Field("template.ReportEndDateString").Visible(false).Add();
            col.Field("CreatedBy").HeaderText("Created By").TextAlign(TextAlign.Center).Width(30).Add();
            col.Field("CreateDate").HeaderText("Create Date").Format("{0:MM/dd/yyyy}").TextAlign(TextAlign.Center).Width(20).Add();
            col.Template("#viewStatus").HeaderText("View Status").CssClass("icon").TextAlign(TextAlign.Center).Width(15).Add();
            col.Template("#downloadReport").HeaderText("Download Report").CssClass("icon").TextAlign(TextAlign.Center).Width(15).Add();
        }).ClientSideEvents(events =>
        {
            events.Load("tblSectionQReportJobsLoad");
            events.TemplateRefresh("loadIcons");
        }))
    <script id="viewStatus" type="text/x-template">
        <a onclick="return modalButton(this, '9080')" href="@Url.AbsoluteAction("ViewSectionQStatus", "BulkProcessing")?jobID={{:ID}}&jobName={{:JobName}}">
            <i data-feather="settings"></i>
        </a>
    </script>
    <script id="downloadReport" type="text/x-template">
        {{if Downloadable}}
        <a href="@Url.AbsoluteAction("DownloadSectionQ", "BulkProcessing")?jobIDString={{:ID}}">
            <i data-feather="download-cloud"></i>
        </a>
        {{else Error}}
        <a title='Error' onclick='return false'>
            <i data-feather='x'></i>
        </a>
        {{else}}
        <a title='Report not created yet' onclick='return false' style='cursor: not-allowed;opacity: 0.5;'>
            <i data-feather='download-cloud'></i>
        </a>
        {{/if}}
    </script>
</div>
