    function collectIdsFromHierarchical(nodes, acc) {
        if (!nodes || !nodes.length) return;
        for (var i = 0; i < nodes.length; i++) {
            var n = nodes[i];
            acc.push(n[idKey]);
            if (n[childKey])
                collectIdsFromHierarchical(n[childKey], acc);
        }
    }
    function getAllIds() {
        var ids = [];
        collectIdsFromHierarchical(dataSrc, ids);
        return ids;
    }
    function checkAll() {
        isBulkChecking = true;
        LoadNotificationDialog("Select All Data Points").then(() => {
            return new Promise((resolve, reject) => {
                getAllIds().forEach(function (id) {
                    tree.checkNode(id);
                });
                var bulkCheckedData = $("#treeView").ejTreeView("instance");
                var checkedIds = bulkCheckedData.getCheckedNodes();
                var fields = bulkCheckedData.model.fields;
                var data = fields.dataSource;
                var idMap = {};
                var selectedNodes = [];
                var treeData = null;

                for (var i = 0; i < checkedIds.length; i++) {
                    var id = checkedIds[i];
                    idMap[id] = true;
                }

                for (var j = 0; j < data.length; j++) {
                    var item = data[j];
                    treeData = {
                        id: item.ID,
                        parentId: item.parentID,
                        text: item.Text,
                        ischecked: item.isChecked
                    };
                    selectedNodes.push(treeData);
                }

                // ---- rebind ----           
                var $selected = $("#treeViewSP");
                if ($selected.data("ejTreeView")) {
                    $selected.ejTreeView("destroy");
                }
                resetSDPTreeview();
                LoadingSelectedDataPointsTreeData(selectedNodes);
                $("#treeViewSP").show();
                resolve();
            });
        }).then(() => {
            isBulkChecking = false;
            return ClearNotificationDialog();
        });
    } 

