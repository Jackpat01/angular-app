@model WebPortal_OH_FI.Models.CostReportDataWizardViewModel
@{
    ViewBag.Title = "CostReportDataWizard";
    Layout = "~/Views/Shared/_LayoutWithMenu.cshtml";
}

<style>
    .e-grid .e-pager .e-pagercontainer {
        float: left;
    }

    .e-grid .e-pager .e-pager-itemsinterval {
        float: left;
    }

    .e-rowcell {
        cursor: pointer;
    }

    .SelectionBrief {
        margin: .5rem 0;
        padding: 8px 0;
        background-color: #f1f1f1;
        border: solid #4e4c4c 1px;
        border-radius: .25rem;
        overflow: hidden;
    }

    .SelectionVerbose {
        margin: .5rem 0;
        padding: 8px 0;
        background-color: #f1f1f1;
        border: solid #4e4c4c 1px;
        border-radius: .25rem;
        min-height: 2rem;
        overflow: hidden;
    }

    .flexBox {
        display: flex;
        flex-flow: row;
        gap: 30px;
    }

    .treeviewFont {
        font-weight: bold;
    }
</style>


<div id="savedSearches" class="myControlsSaveSearch">
    <div id="SelectionBriefSS" class="SelectionBrief">
        <div style="float: left; padding: .25rem .5rem;">
            <b>Saved Reports</b>
        </div>
        <div style="float: right; width: 14rem; text-align: right; padding: 0 .5rem 0 0;">
            <button type="button" class="expands" aria-label="Expand"></button>
        </div>
    </div>
    <div id="SelectionVerboseSS" class="SelectionVerbose">
        <div style="float: left; padding: 0 .5rem;">
            <b>Saved Reports</b>
        </div>
        <div style="float: right; width: 16rem; text-align: right; padding: 0 .5rem 0 0;">
            <div style="padding-bottom: .5rem"><button aria-label="Collapse/Expand" type="button" class="collapses"></button></div>
        </div>
        <br />

        <center id="divTableSavedSearches">
            @(Html.EJ().Grid<object>("tblSavedSearches")
                        .CssClass("mslcTable")
                        .Datasource(Model.DataPointsReportsViewModel)
                        .Locale("en-US")
                        .EnableRowHover(true)
                        .AllowSelection(true)
                        .AllowSorting(true)
                        .AllowFiltering(true)
                        .AllowTextWrap(true)
                        .AllowPaging(true)
    .TextWrapSettings(wrap => { wrap.WrapMode(WrapMode.Both); })
    .FilterSettings(filter =>
    {
        filter.FilterType(FilterType.Menu);
        filter.ShowPredicate(false);
    })
    .ToolbarSettings(toolbar =>
    {
        toolbar.ShowToolbar().ToolbarItems(items =>
        {
            items.AddTool(ToolBarItems.Search);
        });
    })
    .PageSettings(page =>
    {
        page.PageSize(25);
        page.PageSizeList(new List<int>() { 25, 50, 75, 100 });
    })
    .Columns(col =>
    {
        col.Field("ReportId").HeaderText("PrimaryKey Id").IsPrimaryKey(true).Visible(false).Add();
        col.Field("ReportName").HeaderText("Saved Report Name").TextAlign(TextAlign.Left).Width(18).Add();
        col.Field("CRYear").HeaderText("CR Year").TextAlign(TextAlign.Left).Width(5).CssClass("noWrap").Add();
        col.Field("CRLength").HeaderText("CR Length").TextAlign(TextAlign.Left).Width(5).CssClass("noWrap").Add();
        col.Field("CRType").HeaderText("CR Type").TextAlign(TextAlign.Left).Width(5).CssClass("noWrap").Add();
        col.Field("CRStatus").HeaderText("CR Status").TextAlign(TextAlign.Left).Width(6).CssClass("noWrap").Add();
        col.Field("Creator").HeaderText("Creator").TextAlign(TextAlign.Left).Width(10).CssClass("noWrap").Add();
        col.Field("DateCreated").HeaderText("Date Created").TextAlign(TextAlign.Left).Width(8).CssClass("noWrap").Add();
        col.Template("#deleteSavedSearch").CssClass("icon").HeaderText("Delete").TextAlign(TextAlign.Left).Width(4).Add();

    }).ClientSideEvents(events =>
    {
        events.TemplateRefresh("loadIcons");
        events.RecordClick("recordClick");
    }))
            <script id="deleteSavedSearch" type="text/x-template">
                <div style="display:flex">
                    <a onclick="DeleteSavedSearch('{{:ReportId}}')" href="#" type="submit" data-toggle="tooltip" data-placement="top" title="Delete">
                        <i data-feather="trash-2"></i>
                    </a>
                </div>
            </script>

        </center>
        <br />
        <div class="flexBox" style="padding:.5rem .1rem;">
            <input id="btnLoadReport" value="Load Report" onclick="LoadExistingReport()" type="button" class="btn btn-success" />
            <input id="btnDownloadReport" value="Process and Download" onclick="DownloadReport()" type="button" class="btn btn-success" />
        </div>
    </div>
</div>


<div id="newSearchCriteria" class="myControlsNewSearchCriteria">
    <div id="SelectionBriefNSC" class="SelectionBrief">
        <div style="float: left; padding: .25rem .5rem;">
            <b>New Reports/New Criteria</b>
        </div>
        <div style="float: right; width: 14rem; text-align: right; padding: 0 .5rem 0 0;">
            <button type="button" class="expands" aria-label="Expand"></button>
        </div>
    </div>
    <div id="SelectionVerboseNSC" class="SelectionVerbose">
        <div style="float: left; padding: 0 .5rem;">
            <b>New Reports/New Criteria</b>
        </div>
        <div style="float: right; width: 16rem; text-align: right; padding: 0 .5rem 0 0;">
            <div style="padding-bottom:.5rem"><button aria-label="Collapse/Expand" type="button" class="collapses"></button></div>
        </div>
        <br />
        <br />
        <div style="float: left; padding: .25rem .5rem;">
            <table style="width:70%">
                <tr>
                    <td width="15%">
                        <label for="drpCostReportYears">Cost Report Year:</label>
                    </td>
                    <td width="55%">
                        @Html.DropDownListFor(x => x.CostReportYear, (IEnumerable<SelectListItem>)Model.CostReportYears, "Select a Cost Report Year", new { ID = "drpCostReportYears" })
                    </td>
                </tr>
                <tr>
                    <td>
                        <label for="drpCostReportLength">Length of Cost Report:</label>
                    </td>
                    <td>
                        @Html.DropDownListFor(x => x.CostReportLength, Model.CostReportLengths, "Select a Cost Report Length", new { ID = "drpCostReportLengths" })
                    </td>
                </tr>
                <tr>
                    <td>
                        <label for="drpCostReportTypes">Cost Report Type:</label>
                    </td>
                    <td>
                        @Html.DropDownListFor(x => x.CostReportType, (IEnumerable<SelectListItem>)Model.CostReportTypes, "Select a Cost Report Type", new { ID = "drpCostReportTypes" })
                    </td>
                </tr>
                <tr>
                    <td>
                        <label for="drpCostReportStatus">Cost Report Status:</label>
                    </td>
                    <td>
                        @Html.DropDownListFor(x => x.CostReportStatus, (IEnumerable<SelectListItem>)Model.CostReportStatuses, "Select a Cost Report Status", new { ID = "drpCostReportStatus" })
                        <input id="btnLoad" value="Load" onclick="LoadNewReport()" type="button" class="btn btn-success" />
                    </td>
                </tr>
                <tr>
                    <td width="15%">
                        <label for="txtReportName">Report Name:</label>
                    </td>
                    <td width="55%">
                        @Html.TextBoxFor(model => model.ReportName, new { placeholder = "Please Enter Report Name", id = "txtReportName", @class = "form-control", style = "width: 75%;" })
                        <input id="btnSaveReport" value="Save Report" onclick="SaveReport()" type="button" class="btn btn-success" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>


<div id="providerGrid" class="myControls">
    <div id="SelectionBrief" class="SelectionBrief">
        <div style="float: left; padding: .25rem .5rem;">
            <b>Providers</b>
        </div>
        <div style="float: right; width: 14rem; text-align: right; padding: 0 .5rem 0 0;">
            <button type="button" class="expands" aria-label="Expand"></button>
        </div>
    </div>
    <div id="SelectionVerbose" class="SelectionVerbose">
        <div style="float: left; padding: 0 .5rem;">
            <b>Providers</b>
        </div>
        <div style="float: right; width: 16rem; text-align: right; padding: 0 .5rem 0 0;">
            <div style="padding-bottom: .5rem"><button aria-label="Collapse/Expand" type="button" class="collapses"></button></div>
        </div>
        <div id="tblDataWizardProviders"></div>
    </div>
</div>

<div id="dataPoints" class="myControlss" style="width:100%">
    <div id="SelectionBrieff" class="SelectionBrief">
        <div style="float: left; padding: .25rem .5rem;">
            <b>Data Points</b>
        </div>
        <div style="float: right; width: 14rem; text-align: right; padding: 0 .5rem 0 0;">
            <button type="button" class="expands" aria-label="Expand"></button>
        </div>
    </div>
    <div id="SelectionVerbosef" class="SelectionVerbose">
        <div style="float: left; padding: 0 .5rem;">
            <b>Data Points</b>
        </div>

        <div style="float: right; width: 16rem; text-align: right; padding: 0 .5rem 0 0;">
            <div style="padding-bottom: .5rem"><button aria-label="Collapse/Expand" type="button" class="collapses"></button></div>
        </div>
        <br />
        <br />
        <div>
            <label style="display: inline-flex; gap: .5rem; align-items: center;">
                <input type="checkbox" id="chkAllNodes" aria-label="Select/Deselect All">
                <span>Select / Deselect all</span>
            </label>
        </div>
        <br />
        <div id="treeView" style="width:100%"> </div>
        </div>
    </div>

<div id="selectedPoints" class="myControlsSP">
    <div id="SelectionBriefSP" class="SelectionBrief">
        <div style="float: left; padding: .25rem .5rem;">
            <b>Selected Points</b>
        </div>
        <div style="float: right; width: 14rem; text-align: right; padding: 0 .5rem 0 0;">
            <button type="button" class="expands" aria-label="Expand"></button>
        </div>
    </div>
    <div id="SelectionVerboseSP" class="SelectionVerbose">
        <div style="float: left; padding: 0 .5rem;">
            <b>Selected Points</b>
        </div>
        <div style="float: right; width: 16rem; text-align: right; padding: 0 .5rem 0 0;">
            <div style="padding-bottom: .5rem"><button aria-label="Collapse/Expand" type="button" class="collapses"></button></div>
        </div>
        <br />
        <br />
        <div id="treeViewSP"> </div>
    </div>
</div>



<script id="treeTemplate" type="text/x-jsrender">
    <div>
        <i data-feather="trash"></i>
        <div>{{:Text}}</div>
        <div>{{:text}}</div>
    </div>
</script>

<div class="flexBox">
    <input id="btnSave" value="Save Report" onclick="SaveReport()" type="button" class="btn btn-success" />
    <input id="btnSaveDownloadReport" value="Process and Download" onclick="SaveDownloadReport()" type="button" class="btn btn-success" />
</div>
<script>

    // #region Document Ready
    $(document).ready(function () {
        window.selection.expandSS(500);
        $("#drpCostReportLengths").prop('disabled', true);
        $("#drpCostReportTypes").prop('disabled', true);
        $("#drpCostReportStatus").prop('disabled', true);

        $("#btnLoadReport").prop('disabled', true);
        $("#btnDownloadReport").prop('disabled', true);

        $("#btnLoad").prop("disabled", true);
        $("#btnSaveReport").prop('disabled', true);

        $("#btnSave").prop("disabled", true);
        $("#btnSaveDownloadReport").prop('disabled', true);

        $("#txtReportName").text("");

        $("#txtReportName").keyup(function () {
            var val = $("#txtReportName").val();
            if (val != "") {
                $("#btnSaveReport").prop("disabled", false);
            } else {
                $("#btnSaveReport").prop("disabled", true);
            }
          });

        // GetSelectedDataPointsTreeData("BE9FA230-4985-4095-84AE-7D717FD55C2E");
        resetSDPTreeview();
    });
    // #endregion

    //#region Dropdown Selected events
    $("#drpCostReportYears").change(function () {
        if ($("#drpCostReportYears option:selected").text() !== "Select a Cost Report Year") {
            $("#drpCostReportLengths").prop("disabled", false);
            $("#btnLoad").prop("disabled", !isExistingReport);
        } else {
            $("#txtReportName").val("");
            $("#btnLoad").prop("disabled", true);
            $("#btnSaveReport").prop('disabled', true);

            $("#drpCostReportLengths").val($("#drpCostReportLengths option:first").val());
            $("#drpCostReportLengths").prop("disabled", true);

            $("#drpCostReportTypes").val($("#drpCostReportTypes option:first").val());
            $("#drpCostReportTypes").prop("disabled", true);

            $("#drpCostReportStatus").val($("#drpCostReportStatus option:first").val());
            $("#drpCostReportStatus").prop("disabled", true);

            $("#tblDataWizardProviders").hide();
            $("#treeView").hide();
            $("#treeViewSP").hide();
            window.selection.collapse(0);
            window.selection.collapses(0);
            window.selection.collapseSP(0);
        }
    });

    $('#drpCostReportLengths').change(function () {
        if ($("#drpCostReportLengths option:selected").text() !== "Select a Cost Report Length") {
            $("#drpCostReportTypes").prop("disabled", false);
            $("#btnLoad").prop("disabled", !isExistingReport);
        } else {
            $("#txtReportName").val("");
            $("#btnLoad").prop("disabled", true);
            $("#btnSaveReport").prop('disabled', true);

            $("#drpCostReportTypes").val($("#drpCostReportTypes option:first").val());
            $("#drpCostReportTypes").prop("disabled", true);

            $("#drpCostReportStatus").val($("#drpCostReportStatus option:first").val());
            $("#drpCostReportStatus").prop("disabled", true);

            $("#tblDataWizardProviders").hide();
            $("#treeView").hide();
            $("#treeViewSP").hide();
            window.selection.collapse(0);
            window.selection.collapses(0);
            window.selection.collapseSP(0);
        }
    });

    $("#drpCostReportTypes").change(function () {
        if ($("#drpCostReportTypes option:selected").text() !== "Select a Cost Report Type") {
            $("#drpCostReportStatus").prop("disabled", false);
            $("#btnLoad").prop("disabled", !isExistingReport);
        }
        else {
            $("#txtReportName").val("");
            $("#btnLoad").prop("disabled", true);
            $("#btnSaveReport").prop('disabled', true);

            $("#drpCostReportStatus").val($("#drpCostReportStatus option:first").val());
            $("#drpCostReportStatus").prop("disabled", true);

            $("#tblDataWizardProviders").hide();
            $("#treeView").hide();
            $("#treeViewSP").hide();
            window.selection.collapse(0);
            window.selection.collapses(0);
            window.selection.collapseSP(0);
        }
    });

    $("#drpCostReportStatus").change(function () {
        if ($("#drpCostReportStatus option:selected").text() !== "Select a Cost Report Status") {
            $("#btnLoad").prop('disabled', false);
        } else {
            $("#btnLoad").prop('disabled', true);
        }
    });

    //New Reports/New Criteria
    var isExisting;
    function LoadNewReport() {
        isExisting = false;
        LoadProviderGrid(isExisting);
        LoadDataPointsTreeView();
        $("#btnSave").prop("disabled", false);
        $("#btnSaveDownloadReport").prop('disabled', false);
    }

    //#region Accordian Open/ Close Selection
    window.selection = {
        isCollapsed: "true",
        isCollapsedd: "true",
        isCollapsedSP: "true",
        isCollapsedSS: "true",
        isCollapsedNSC: "true",
        collapse: function (speed) {
            if (!speed) speed = 0;
            $(".myControls .collapses").hide();
            $("#SelectionVerbose").slideUp(speed, function () { //  <b>Providers</b>
                $(".myControls .expands").show();
                $("#SelectionBrief").slideDown(speed);
            });
        },
        collapses: function (speed) {
            if (!speed) speed = 0;
            $(".myControlss .collapses").hide();
            $("#SelectionVerbosef").slideUp(speed, function () { // <b>Data Points</b>
                $(".myControlss .expands").show();
                $("#SelectionBrieff").slideDown(speed);
            });
        },
        collapseSP: function (speed) {
            if (!speed) speed = 0;
            $(".myControlsSP .collapses").hide();
            $("#SelectionVerboseSP").slideUp(speed, function () { // <b>Selected Points</b>
                $(".myControlsSP .expands").show();
                $("#SelectionBriefSP").slideDown(speed);
            });
        },
        collapseSS: function (speed) {
            if (!speed) speed = 0;
            $(".myControlsSaveSearch .collapses").hide();
            $("#SelectionVerboseSS").slideUp(speed, function () { // <b>Saved Reports</b>
                $(".myControlsSaveSearch .expands").show();
                $("#SelectionBriefSS").slideDown(speed);
            });
        },

        collapseNSC: function (speed) {
            if (!speed) speed = 0;
            $(".myControlsNewSearchCriteria .collapses").hide();
            $("#SelectionVerboseNSC").slideUp(speed, function () { //  <b>New Reports/New Criteria</b>
                $(".myControlsNewSearchCriteria .expands").show();
                $("#SelectionBriefNSC").slideDown(speed);
            });
        },

        expand: function (speed) {
            if (!speed) speed = 0;
            $(".myControls .expands").hide();
            $("#SelectionBrief").slideUp(speed, function () {
                $(".myControls .collapses").show();
                $("#SelectionVerbose").slideDown(speed);
            });
        },
        expands: function (speed) {
            if (!speed) speed = 0;
            $(".myControlss .expands").hide();
            $("#SelectionBrieff").slideUp(speed, function () {
                $(".myControlss .collapses").show();
                $("#SelectionVerbosef").slideDown(speed);
            });
        },
        expandSP: function (speed) {
            if (!speed) speed = 0;
            $(".myControlsSP .expands").hide();
            $("#SelectionBriefSP").slideUp(speed, function () {
                $(".myControlsSP .collapses").show();
                $("#SelectionVerboseSP").slideDown(speed);
            });
        },
        expandSS: function (speed) {
            if (!speed) speed = 0;
            $(".myControlsSaveSearch .expands").hide();
            $("#SelectionBriefSS").slideUp(speed, function () {
                $(".myControlsSaveSearch .collapses").show();
                $("#SelectionVerboseSS").slideDown(speed);
            });
        },
        expandNSC: function (speed) {
            if (!speed) speed = 0;
            $(".myControlsNewSearchCriteria .expands").hide();
            $("#SelectionBriefNSC").slideUp(speed, function () {
                $(".myControlsNewSearchCriteria .collapses").show();
                $("#SelectionVerboseNSC").slideDown(speed);
            });
        },
    };

    if (window.selection.isCollapsed) {
        window.selection.collapse(0);
    } else {
        window.selection.expand(0);
    }

    if (window.selection.isCollapsedd) {
        window.selection.collapses(0);
    } else {
        window.selection.expands(0);
    }

    if (window.selection.isCollapsedSP) {
        window.selection.collapseSP(0);
    } else {
        window.selection.expandSP(0);
    }

    if (window.selection.isCollapsedSS) {
        window.selection.collapseSS(0);
    } else {
        window.selection.expandSS(0);
        }

        if (window.selection.isCollapsedNSC) {
            window.selection.collapseNSC(0);
        } else {
            window.selection.expandNSC(0);
        }

        $(".myControls .collapses")
            .off(".sizing")
            .on("click.sizing", function () {
                window.selection.collapse(500);
                $.ajax({ async: true, url: "@Url.AbsoluteAction("Collapse", "CostReport")", cache: false, type: "POST" });
            });

        $(".myControls .expands")
            .off(".sizing")
            .on("click.sizing", function () {
                window.selection.expand(500);
                $.ajax({ async: true, url: "@Url.AbsoluteAction("Expand", "CostReport")", cache: false, type: "POST" });
            });

    $(".myControlss .collapses")
            .off(".sizing")
            .on("click.sizing", function () {
                window.selection.collapses(500);
                $.ajax({ async: true, url: "@Url.AbsoluteAction("Collapse", "CostReport")", cache: false, type: "POST" });
            });

    $(".myControlss .expands")
            .off(".sizing")
            .on("click.sizing", function () {
                window.selection.expands(500);
                $.ajax({ async: true, url: "@Url.AbsoluteAction("Expand", "CostReport")", cache: false, type: "POST" });
            });

    $(".myControlsSP .collapses")
            .off(".sizing")
            .on("click.sizing", function () {
                window.selection.collapseSP(500);
                $.ajax({ async: true, url: "@Url.AbsoluteAction("Collapse", "CostReport")", cache: false, type: "POST" });
            });

    $(".myControlsSP .expands")
            .off(".sizing")
            .on("click.sizing", function () {
                window.selection.expandSP(500);
                $.ajax({ async: true, url: "@Url.AbsoluteAction("Expand", "CostReport")", cache: false, type: "POST" });
            });

    $(".myControlsSaveSearch .collapses")
            .off(".sizing")
            .on("click.sizing", function () {
                window.selection.collapseSS(500);
                $.ajax({ async: true, url: "@Url.AbsoluteAction("Collapse", "CostReport")", cache: false, type: "POST" });
            });

        $(".myControlsSaveSearch .expands")
            .off(".sizing")
            .on("click.sizing", function () {
                window.selection.expandSS(500);
                $.ajax({ async: true, url: "@Url.AbsoluteAction("Expand", "CostReport")", cache: false, type: "POST" });
            });

        $(".myControlsNewSearchCriteria .collapses")
         .off(".sizing")
         .on("click.sizing", function () {
             window.selection.collapseNSC(500);
             $.ajax({ async: true, url: "@Url.AbsoluteAction("Collapse", "CostReport")", cache: false, type: "POST" });
         });

        $(".myControlsNewSearchCriteria .expands")
         .off(".sizing")
            .on("click.sizing", function () {
                window.selection.expandNSC(500);
                $.ajax({ async: true, url: "@Url.AbsoluteAction("Expand", "CostReport")", cache: false, type: "POST" });
            });
     //#endregion

    //#region Accordian One - Provider - Grid
    var selectedProviderList;
    function LoadProviderGrid(isExisting) {
        var costReportYearSelected = $('#drpCostReportYears option:selected').val();
        var costReportLengthSelected = $('#drpCostReportLengths option:selected').val();
        var costReportTypeSelected = $('#drpCostReportTypes option:selected').val();
        var costReportStatusSelected = $('#drpCostReportStatus option:selected').val();
        var reportName = $('#txtReportName').val();
        var costReportYearSelectedText = $('#drpCostReportYears option:selected').text();
        var costReportTypeSelectedText = $('#drpCostReportTypes option:selected').text();
        var costReportStatusSelectedText = $('#drpCostReportStatus option:selected').text();

        if (costReportYearSelectedText != "Select a Cost Report Year" && costReportTypeSelectedText != "Select a Cost Report Type"
            && costReportStatusSelectedText != "Select a Cost Report Status") {
            return LoadNotificationDialog("Loading Data Points").then(() => {
                return new Promise((resolve, reject) => {
                    $.ajax({
                        async: true,
                        url: "@Url.AbsoluteAction("GetSelectedProviders", "Reports")",
                        data: JSON.stringify({ "costReportYear": costReportYearSelected, "costReportLength": costReportLengthSelected, "costReportType": costReportTypeSelected, "costReportStatus": costReportStatusSelected, "reportName": reportName, "isExisting": isExisting }),
                        type: "POST",
                        cache: false,
                        contentType: "application/json;charset=utf-8",
                        success: function (result) {

                            // Providers that should be checked on grid load
                            selectedProviderList = result.SelectedProviders;
                            // Build Grid - Data binding
                            LoadDataWizardProviderList(result.Providers);
                            checkSavedProviders(selectedProviderList);

                            new Promise((res, rej) => {
                                $.ajax({
                                    async: true,
                                    url: "@Url.AbsoluteAction("Expand", "CostReport")",
                                    cache: false,
                                    type: "POST",
                                    success: function (result) {
                                        resolve();
                                    },
                                    error: function (errormessage) {
                                        StaticAlert({ content: errormessage.responseText }).then(() => {
                                            resolve();
                                        });
                                    }
                                });
                            });
                        },
                        error: function (errormessage) {
                            StaticAlert({ content: errormessage.responseText }).then(() => {
                                resolve();
                            });
                        }
                    });
                });
            }).then(() => {
                return ClearNotificationDialog();
            });
        }
        else {
            $("#providerGrid").hide();

            // Need to return a promise here.
            return Promise.resolve();
        }
    }

    function LoadDataWizardProviderList(providerList) {
        var cols = [];
        cols.push({ type: 'checkbox', width: '15', visible: true });
        //cols.push({ type: 'checkbox', width: '15' });
        cols.push({ field: 'ProviderName', headerText: '', width: '200', visible: true });
        cols.push({ field: 'ProviderValue', headerText: 'Value', width: '10', visible: false });
        $("#tblDataWizardProviders").show();
        $("#tblDataWizardProviders").ejGrid({
            dataSource: providerList,
            selectionSettings: {
                selectionMode: ["row", "checkbox"], // Enable row and checkbox selection
                enableToggle: true
            },
            columns: cols,
            height: 150,
