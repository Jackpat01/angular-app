    window.GetSelectedTreeViewData = function () {
        var out = [];

        var $tv = $("#treeView");
        if (!$tv.length) return out;

        var tree = $tv.data("ejTreeView");
        if (!tree) return out;

        function getNodeData(nodeId) {
            var node = null;
            if (typeof tree.getNode === "function") {
                node = tree.getNode(nodeId);
            }
            if (!node && typeof tree.getTreeDataById === "function") {
                node = tree.getTreeDataById(nodeId);
            }
            if (!node) {
                var f = tree.model.fields || {};
                var ds = f.dataSource;
                var data = Array.isArray(ds) ? ds : (ds && ds.dataSource && (ds.dataSource.json || ds.dataSource.data)) || [];
                var idField = f.id || "ID";
                var guess = String(nodeId).replace(/-/g, "_");

                for (var i = 0; i < data.length; i++) {
                    if (String(data[i][idField]) === guess) {
                        node = data[i];
                        break;
                    }
                }
            }
            return node;
        }

        var fields = tree.model.fields;
        var dataNode = fields.dataSource;
        var checkedIds = tree.getCheckedNodes();

        for (var i = 0; i < checkedIds.length; i++) {
            var id = checkedIds[i];
            var node = getNodeData(id);
            if (!node) continue;

            for (var j = 0; j < dataNode.length; j++) {
                var item = dataNode[j];
                if (!item || item.ID !== node.id) continue;

                var scheduleName = item.ScheduleName || item.Text || "";
                if (item.RangeName != null) {
                    out.push(scheduleName + ":" + item.RangeName + ":" + item.DisplayColumn);
                } else if (item.DisplayColumn != null) {
                    out.push(scheduleName + ":" + item.DisplayColumn);
                }
            }
        }
        return out;
    };


    // Helper function to check if node already exists in collection
    function nodeExists(id, collection) {
        return collection.some(function (x) { return x.id === id; });
    }

    function nodeChecked(args) {
        if (isBulkChecking) return; //ignore eventd during bulk check
        LoadNotificationDialog("Updating Selected Points").then(() => {
            return new Promise((resolve, reject) => {
                var treeObj = $("#treeView").data("ejTreeView");
                var treeSPObj = $("#treeViewSP").data("ejTreeView");
                // Get all current nodes in the Selected Points tree **once**           
                var treeDataSP = treeSPObj.getTreeData();
                // Create a quick lookup set for faster ID existence checks
                var existingIDs = new Set(treeDataSP.map(item => item.id));
                var treeNode_Collection_All = []; // Collect all nodes to add
                for (var node = 0; node < args.currentCheckedNodes.length; node++) {

                    var nodeObj = args.currentCheckedNodes[node];
                    var parentNode = treeObj.getParent(nodeObj.id);
                    var grandChild_treeData = null;
                    var child_treeData = null;
                    var parent_treeData = null;
                    // ---- Grandchild ----               
                    if (!existingIDs.has(nodeObj.id)) {
                        grandChild_treeData = {
                            id: nodeObj.id,
                            parentId: parentNode[0]?.id || "",
                            text: nodeObj.text
                        };
                        treeNode_Collection_All.push(grandChild_treeData);
                        existingIDs.add(nodeObj.id); // Avoid duplicates later
                    }
                    // ---- Child ----
                    if (parentNode[0] && !existingIDs.has(parentNode[0].id)) {
                        var rootParentNode = treeObj.getParent(parentNode[0].id);
                        child_treeData = {
                            id: parentNode[0].id,
                            parentId: rootParentNode[0]?.id || "",
                            text: parentNode[0].name
                        };
                        treeNode_Collection_All.push(child_treeData);
                        existingIDs.add(parentNode[0].id);
                    }
                    // ---- Parent ----               
                    var rootParentNode = parentNode[0] ? treeObj.getParent(parentNode[0].id) : null;
                    if (rootParentNode && rootParentNode[0] && !existingIDs.has(rootParentNode[0].id)) {
                        parent_treeData = {
                            id: rootParentNode[0].id,
                            parentId: "", text: rootParentNode[0].name,
                            ischecked: true
                        };
                        treeNode_Collection_All.push(parent_treeData);
                        existingIDs.add(rootParentNode[0].id);
                    }
                }
                // ---- Add all nodes at once ----           
                if (treeNode_Collection_All.length > 0) {
                    treeSPObj.addNodes(treeNode_Collection_All);
                }
                // ---- Sort and rebind ----           
                var treeDataSP_Final = treeSPObj.getTreeData();
                var sortedData = sortTreeData(treeDataSP_Final);
                resetSDPTreeview();
                LoadingSelectedDataPointsTreeData(sortedData);
                $("#treeViewSP").show();
                resolve();
            });
        }).then(() => {
            return ClearNotificationDialog();
        });
    }
    //#endregion

    function sortTreeData(data) {
        return data.sort(function (a, b) {
            var aParts = a.id.split('_').map(Number);
            var bParts = b.id.split('_').map(Number);

            for (var i = 0; i < Math.max(aParts.length, bParts.length); i++) {
                var aVal = aParts[i] || 0;
                var bVal = bParts[i] || 0;

                if (aVal !== bVal) {
                    return aVal - bVal;
                }
            }
            return 0;
        });
    }

