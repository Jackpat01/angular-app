                        var isExistingReport = false;
                        let isEditing = (savedReportID != null && isExistingReport);
                        var dataPointReportsViewModel = {
                            IsExistingReport: isEditing,
                            ReportName: reportName,
                            CostReportYear: costReportYearSelected,
                            costReportLength: costReportLengthSelected,
                            CostReportType: costReportTypeSelected,
                            CostReportStatus: costReportStatusSelected,
                            ProviderData: selectedProviderIDs,
                            RangeName: selectedTreeData,
                            IsOverrideReport: isOverrideReport
                        };
                        $.ajax({
                            cache: false,
                            crossDomain: true,
                            url: "@Url.AbsoluteAction("SaveDataPoints", "Reports")",
                            data: ({ "DataPointReportsViewModel": dataPointReportsViewModel }),
                            type: "POST",
                            success: function (result) {
                                if (result.Success) {
                                    $("#tblSavedSearches").ejGrid("dataSource", result.DataPointsSavedSearchesViewModel);

                                    refreshUIControls();
                                }

                                resolve();
                            },
                            error: function (errormessage) {
                                StaticAlert({ content: errormessage }).then(() => {
                                    resolve();
                                });
                            }
                        });
                    });
                }).then(() => {
                    return ClearNotificationDialog();
                });
            });

        }
        else { // If User chooses to change the Report Name and Save
            return LoadNotificationDialog("Saving Data Points").then(() => {
                return new Promise((resolve, reject) => {

                    var savedReportID = null;
                    var isExistingReport = false;
                    let isEditing = (savedReportID != null && isExistingReport);
                    var dataPointReportsViewModel = {
                        IsExistingReport: isEditing,
                        ReportName: reportName,
                        CostReportYear: costReportYearSelected,
                        CostReportLength: costReportLengthSelected,
                        CostReportType: costReportTypeSelected,
                        CostReportStatus: costReportStatusSelected,
                        ProviderData: selectedProviderIDs,
                        RangeName: selectedTreeData,
                        IsOverrideReport: isOverrideReport
                    };
                    $.ajax({
                        cache: false,
                        crossDomain: true,
                        url: "@Url.AbsoluteAction("SaveDataPoints", "Reports")",
                        data: ({ "DataPointReportsViewModel": dataPointReportsViewModel }),
                        type: "POST",
                        success: function (result) {
                            if (result.Success) {
                                $("#tblSavedSearches").ejGrid("dataSource", result.DataPointsSavedSearchesViewModel);

                                refreshUIControls();
                            }

                            resolve();
                        },
                        error: function (errormessage) {
                            StaticAlert({ content: errormessage }).then(() => {
                                resolve();
                            });
                        }
                    });
                });
            }).then(() => {
                return ClearNotificationDialog();
            });
        }
    }
        // #endregion

    //#region Helper Functions
    let getSelectedTreeNodeArray = (treeData, desired_keyOne, desired_keyTwo) => {
        let desiredValue = treeData.filter((element) => element[desired_keyOne] == true).map(x => x[desired_keyTwo]);
        return desiredValue;
    }

    let getSelectedProviderArray = (arrayProviders, desired_keyOne) => {
        let desiredValue = arrayProviders.map(x => x[desired_keyOne]);
        return desiredValue;
    }

    function ValidateSubmitButtons() {
        var providersArray = $("#tblDataWizardProviders").ejGrid("getSelectedRecords");
        var treeObj = $("#treeView").ejTreeView('instance');
        var checkedNodesArray = treeObj.getCheckedNodes();
        if (providersArray.length > 0 && checkedNodesArray.length > 0) {
            $("#btnLoadReport").prop('disabled', false);
            $("#btnDownloadReport").prop('disabled', false);
            $("#btnSave").prop("disabled", false);
            $("#btnSaveDownloadReport").prop('disabled', false);
        }
        else {
            $("#btnLoadReport").prop('disabled', true);
            $("#btnDownloadReport").prop('disabled', true);
            $("#btnSave").prop("disabled", true);
            $("#btnSaveDownloadReport").prop('disabled', true);
        }
        //$("#btnSave").prop("disabled", false);
    }
    //#endregion

    function loadTrashIcon(args) {
        // Grids use args.cell, tree grids use args.rowElement
        $(args.cell ?? args.rowElement).find("i").each(function (index, element) {
            const iconSelection = element.attributes["data-feather"];
            if (iconSelection) {
                const svgFile = feather.icons[iconSelection.value];
                let newAttriubtes = {};
                for (let i = 0; i < element.attributes.length; i++) {
                    newAttriubtes[element.attributes[i].name] = element.attributes[i].value;
                }
                element.outerHTML = svgFile ? svgFile.toSvg(newAttriubtes) : "Invalid Icon Selection";
            }
        });
        if (args.data && args.data.IsActive == false)
            args.cell.parentElement.classList.add("hidden-event");
    }

    function refreshUIControls() {

        $("#txtReportName").val("");

        $("#btnLoadReport").prop('disabled', true);
        $("#btnDownloadReport").prop('disabled', true);

        $("#btnLoad").prop("disabled", true);
        $("#btnSaveReport").prop('disabled', true);

        $("#btnSave").prop("disabled", true);
        $("#btnSaveDownloadReport").prop('disabled', true);

        $("#drpCostReportYears option").prop("selected", false);
        $("#drpCostReportYears option").filter(function () {
            return this.text == "Select a Cost Report Year";
        }).attr('selected', true).trigger('change');

        $('#drpCostReportLengths option').filter(function () {
            return this.text == "Select a Cost Report Length";
        }).attr('selected', true).trigger('change');

        $("#drpCostReportTypes option").filter(function () {
            return this.text == "Select a Cost Report Type";
        }).attr('selected', true).trigger('change');

        $("#drpCostReportStatus option").filter(function () {
            return this.text == "Select a Cost Report Status";
        }).attr('selected', true).trigger('change');



        resetSDPTreeview();

        var gridObj = $("#tblDataWizardProviders").ejGrid("instance");

        gridObj.enablePersistence = false;
        // Clear grid’s local storage data
        window.localStorage.setItem("gridGrid", "");
        // Destroy the grid
        gridObj.destroy();

        window.selection.collapseNSC(0);
        window.selection.collapse(0);
        window.selection.collapses(0);
        window.selection.collapseSP(0);
        $.ajax({ async: true, url: "@Url.AbsoluteAction("Collapse", "CostReport")", cache: false, type: "POST" });
    }

    function resetSDPTreeview() {
        var emptyArray = new Array();
        $("#treeViewSP").ejTreeView({
            showCheckbox: false, // shows each node with checkboxes
            autoCheck: true,// turns off auto check of parent and child nodes
            fullRowSelect: true,
            autoCheckParentNode: false,
            nodeUncheck: nodeUncheckedSP,
            height: 300,
            fields: {
                dataSource: emptyArray, id: 'id', text: 'text', parentID: 'parentId', isChecked: 'ischecked'
            },
            htmlAttributes: { class: "treeviewFont" }
        });


    }
</script>
