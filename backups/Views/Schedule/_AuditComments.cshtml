<!-- #region Can Edit Functions -->
@if (Model.CanEdit)
{
	<script>
		// ========== Ajax Requests ==========
		/** Request to save audit comment to currently selected cost report */
		function saveAuditComment(commentNumber, specialNarrId, onSuccess) {
            var auditCommentToSave = {
                NarrativeNumber: commentNumber,
                SpecialNarrativeId: specialNarrId
            };
			return new Promise((resolve, reject) => {
				$.ajax({
					async: true,
					url: '@Url.AbsoluteAction("SaveCostReportAuditCommentModel","Schedule")',
					type: 'POST',
                    data: JSON.stringify({ model: auditCommentToSave }),
					contentType: 'application/json;charset=utf-8',
					success: (result) => resolve(result),
					error: (result) => handleError(result, resolve)
				});
			});
		}
		/** Request to save special narrative to currently selected cost report */
		function saveNewSpecialNarrative(narrativeNumber, description) {
			return new Promise((resolve, reject) => {
				var newSpecialNarrative = {
					NarrativeNumber: narrativeNumber,
					Description: description
				};

				$.ajax({
					async: true,
					url: '@Url.AbsoluteAction("SaveCostReportSpecialNarrativeModel","Schedule")',
					type: 'POST',
					data: JSON.stringify({ model: newSpecialNarrative }),
					contentType: 'application/json;charset=utf-8',
					success: (result) => resolve(result),
					error: (result) => handleError(result, resolve)
				});
			});
		}
		/** Request to delete audit comment from currently selected cost report */
		function deleteAuditComment(data) {
			return new Promise((resolve, reject) => {
				$.ajax({
					async: true,
					url: '@Url.AbsoluteAction("DeleteCostReportAuditCommentModel","Schedule")',
					data: JSON.stringify({model: data}),
					type: 'POST',
					contentType: 'application/json;charset=utf-8',
					success: (result) => resolve(result),
					error: (result) => handleError(result, resolve)
				});
			});
		}
		/** Handles creating the static alert whenever an Ajax request defined above fails */
		function handleError(result, promiseResolve) {
			StaticAlert({ content: `Audit Comments Error: ${result.Message}` }).then(() => {
				promiseResolve();
			});
		}

		// ========== UI Functionality ==========
        /** Opens special narratives modal and initializes events for its UI elements */
		function openSpecialNarrativeModal(gridItem, fromButton, specialNarr, $input) {
			var $number = $('#sNarrativeNumber');
			var $description = $('#sNarrativeDescription');
			var $saveBtn = $('#saveSNarrativeBtn');
			var $cnclBtn = $('#cancelSNarrativeBtn');
			var $error = $('#sNarrativeError');

			var existingNarrative = null;
			var lookupTimer = null;
			var LOOKUP_DELAY = 400;
			var isSpecialNarrNull = specialNarr == null

			// Reset state
			$number.val(specialNarr);
			$description.val('');
			$description.prop('disabled', isSpecialNarrNull);
            $saveBtn.prop('disabled', isSpecialNarrNull);
			$error.hide().text('');
			existingNarrative = null;

			// Number input
			$number.off('input.snarr').on('input.snarr', function () {
				$number.val($number.val().replace('x', 'X'));
				var entered = $.trim($number.val());

				$error.hide();

				if (!entered) {
					$description.val('').prop('disabled', true);
					$saveBtn.prop('disabled', true);
					existingNarrative = null;
					return;
				}

				var found = findSpecialNarrative(entered);
				
				if (found) {
					existingNarrative = found;
					$description.val(found.Description).prop('disabled', true);
					$saveBtn.prop('disabled', false);
				} else {
					if (existingNarrative != null) {
						$description.val('');
						$saveBtn.prop('disabled', true);
					}

					existingNarrative = null;
					$description.prop('disabled', false);

					// Save button enables once there is text in the description box
					var hasDescription = $.trim($description.val()).length > 0;
					$saveBtn.prop('disabled', false);
				}
			});
			$number.off('change.snarr').on('change.snarr', function () {
                $input.val($number.val());
			});

			// NFOFI-6682 Description being blank should not disable the save button
			// Description input for adding new Special Narrative
			// $description.off('input.snarr').on('input.snarr', function () {
			// 	if (existingNarrative) return;
			// 	var hasContent = $.trim($description.val()).length > 0;
			// 	$saveBtn.prop('disabled', !hasContent);	// A character has been entered, enable saving
			// });

			// Save button
			$saveBtn.off('click.snarr').on('click.snarr', function () {
				var number = $.trim($number.val());
				var description = $.trim($description.val());

                if (number == '') {
                    StaticAlert({
                        title: 'Special Narrative Save Notification',
                        content: 'Please enter a special narrative.',
                        callback: () => $description.focus()
                    });
                    return;
                }

				if (description == '') {
                    StaticAlert({
                        title: 'Special Narrative Save Notification',
						content: 'Please enter a description.',
						callback: () => $description.focus()
					});
					return;
				}

                /** if special narrative exists, this will attempt to save the audit comment
				 * if special narrative does not exist, this will attempt to save the special narrative and upon success it will save the audit comment as well 
				 * on success, the special narratives modal will close, if there was a failure, modal with persist with error text inside 
				 * NOTICE: This also covers how the callback function in the current invocation below works as well */
				function persistNarrativeIfNeeded(callback) {
					if (existingNarrative) {
						callback(true, existingNarrative.RecordId);	// Already exists, nothing to save
					} else {
						saveNewSpecialNarrative(number, description).then(function (result) {
							//TODO: make call to save audit comment here
							if (!result || !result.Success) {
								callback(false, null);
								return;
							}

							//Update current specialNarratives with what returns from server, since it is the source of truth
							specialNarratives = result.Data;

							//If the record is not null, that means that the save attempt was successful
							var newRecord = null;
							if (specialNarratives.some(s => s.NarrativeNumber === number)) {
								newRecord = specialNarratives.find(s => s.NarrativeNumber === number);
							}

							callback(newRecord != null, newRecord ? newRecord.RecordId : null);
						});
					}
				}
				
				persistNarrativeIfNeeded(function (success, narrativeRecordId) {
					if (!success) {
						$error.text('Could not save narrative. Please contact support.').show();
						return;
					}

					let ogVal = $input.attr('data-originalval');
					let newVal = $input.val()

					if (newVal != ogVal && ogVal !== '') {
                        var existing = findCommentByCode(gridItem.NarrativeNumber);
						deleteAuditComment(existing).then(function (result) {
                            if (result && result.Success) {
                                currentAuditComments = result.Data;
                                if (!success) {
                                    $error.text('Could not save audit comment. Please contact support.').show();
                                    return;
                                }
                            }
						}).then(function () {
							saveAuditComment(gridItem.NarrativeNumber, narrativeRecordId).then(function (result) {
								if (result && result.Success) {
									currentAuditComments = result.Data;
									if (!success) {
										$error.text('Could not save audit comment. Please contact support.').show();
										return;
									}
									applyExistingState();
									$input.trigger('focusout');
								}
								$('#window_SpecialNarrative').modal('hide');
							});
						});
					} else {
						saveAuditComment(gridItem.NarrativeNumber, narrativeRecordId).then(function (result) {
                    		if (result && result.Success) {
								currentAuditComments = result.Data;
								if (!success) {
									$error.text('Could not save audit comment. Please contact support.').show();
									return;
								}
								applyExistingState();
								$input.trigger('focusout');
							}
                    		$('#window_SpecialNarrative').modal('hide');
						});
					}

				});
			});

            $cnclBtn.off('click.snarr').on('click.snarr', function () {
                setTimeout(() => {
					if (hasUnsavedChanges($input)) $input.val('');
					$input.trigger('click');
                    $input.focus();
                }, 300);

                $('#window_SpecialNarrative').modal('hide');
			});

			$('#window_SpecialNarrative').modal('show');
			setTimeout(function () {
                isSpecialNarrNull ? $number.focus() : $description.focus();
			}, 500);
		}
	</script>
	<!-- #endregion -->
}


