    function GetGridDef(providerCostReportId, schedule, mask, skipEdits) {
        //debugger;
        //console.log("GetGridDef");

        //  NOTE: The providerCostReportId and schedule parameters are not used here as it is
        //        pulled from the selected schedule in the menu system. This prevents circumventing
        //        the system and does not allow arbitrary schedule informaiton pull without
        //        actually selecting and accessing the schedule.
        let options = {
            //providerCostReportIdString: providerCostReportId,
            //worksheetName: schedule,
            skipEdits: skipEdits
        };

        if (!skipEdits) createEditsGrid();
           // Pass the server-side Razor variable into JavaScript
       // const loadAuditAdjustments = @loadAuditAdjustments.ToString().ToLower();

        //if (loadAuditAdjustments) getAuditAdjustmentPopupWindow("AuditAdjustments");
            //createAuditAdjustmentsGrid();
        //debugger;
        return LoadNotificationDialog("Loading Schedule " + schedule + ", please wait...").then(() => {
            return new Promise((resolve, reject) => {
                $.ajax({
                    async: true,
                    url: "@Url.AbsoluteAction("GetGridDef", "Schedule")",
                    data: options,
                    cache: false,
                    type: "POST",
                    dataType: "json",
                    success: function (response) {
                        if (response === null) {
                            resolve();
                            return;
                        }

                        if (!!response.Success && !!response.Grid) {
                            let gridJsonParse = response.Grid;
                            //let gridCellDefArray = evaluate(gridJsonParse.GridCellDef);
                            let gridModelDefArray = evaluate(gridJsonParse.GridModelDef);
                            //gridTitleText = gridJsonParse.GridTitle;
                            let gridNameDefArray = evaluate(gridJsonParse.GridNameDef);
                            //console.log(gridJsonParse.GridCellDef);
                            //console.log(gridJsonParse.GridModelDef);
                            //console.log(gridJsonParse.GridTitle);
                            //console.log(gridJsonParse.GridNameDef);

                            if (!!gridNameDefArray && gridNameDefArray.length > 0 && !!gridModelDefArray && gridModelDefArray.length > 0) {
                                for (let i = 0; i < gridNameDefArray.length; i++) {
                                    gridNameDefArray[i] = decodeEntities(gridNameDefArray[i]);
                                }

                                window.CostReport.Grid.GroupHeaders = [];
                                let header = evaluate(gridJsonParse.GridHeaderDef);
                                if (!!header) {
                                    let start = "";
                                    let t = $("<table>");
                                    for (let r = 0; r < header.tr.length; r++) {
                                        let row = header.tr[r];
                                        let tr = $("<tr>");
                                        for (let c = 0; c < row.td.length; c++) {
                                            let cell = row.td[c];
                                            let td = $("<td>").html(cell.text);
                                            if (cell.span > 1) {
                                                td.attr("colspan", cell.span);
                                            }
                                            if (!!cell.reference) {
                                                if (!start || start > cell.reference) {
                                                    start = cell.reference;
                                                }
                                                td.attr("data-ColumnRef", cell.reference);
                                                if (header.tr.length - r > 1) {
                                                    td.attr("rowspan", header.tr.length - r);
                                                }
                                            }
                                            tr.append(td);
                                        }
                                        t.append(tr);
                                    }
                                    //console.log(start);

                                    window.CostReport.Grid.GroupHeaders.push({
                                        startColumnName: start,
                                        numberOfColumns: !!gridModelDefArray ? gridModelDefArray.length : 0,
                                        titleText: $("<div>").append(t).html()
                                    });
                                }

                                return createGrid(gridNameDefArray, gridModelDefArray).then(() => {
                                    @Html.Raw(Model.SummaryGridCreateFunctionCall)
                                }).then(() => {
                                    return ClearNotificationDialog();
                                }).then(() => {
                                    if (!!response.Message) {
                                        StaticAlert({ content: response.Message }).then(() => {
                                            resolve();
                                        });
                                    }
                                    else {
                                        resolve();
                                    }
                                });
                            }
                        }
                        if (!!response.Message) {
                            StaticAlert({ content: response.Message }).then(() => {
                                resolve();
                            });
                        }
                        else {
                            return ClearNotificationDialog().then(() => {
                                resolve();
                            });
                        }
                    },
                    error: function (a, b, c) {
                        StaticAlert({ content: "AJAX callback error, GetGridDef: " + a.responseText }).then(() => {
                            resolve();
                        });
                    }
                });
            });
        });
    }

