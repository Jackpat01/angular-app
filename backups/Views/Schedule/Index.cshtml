    function isScheduleE(schedule) { return schedule === 'E'; }
    function isAttachment1(schedule) { return schedule && (schedule.indexOf('Att 1') === 0 || schedule.indexOf('AT1') === 0); }
    function isLine2Locked(schedule) { return isScheduleE(schedule) || isAttachment1(schedule); }

    function setButtonStates(mode) {
        uiMode = mode;
        var $add = $('#btnAddAdjustment');
        var $edit = $('#btnEditAdjustment');
        var $del = $('#btnDeleteAdjustment');
        var $save = $('#btnSaveAdjustments');
        var $cancel = $('#btnCancelAdjustments');


        // Helper to toggle the disabled state on bootstrap buttons
        function toggle($btn, disabled) {
            if (!$btn || !$btn.length) return;
            $btn.prop('disabled', !!disabled);
            if (disabled) $btn.addClass('disabled'); else $btn.removeClass('disabled');
        }

        if (mode === 'readonly') {
            // isChangeAuditButtonDisabled === true → everything off
            toggle($add, true); toggle($edit, true); toggle($del, true);
            toggle($save, true); toggle($cancel, true);
        } else if (mode === 'editing') {
            // While adding/editing a pair: only Delete, Save & Cancel available
            toggle($add, true); toggle($edit, true); toggle($del, false);
            var hasDirty = Object.keys(dirtyPairs).length > 0;
            toggle($save, narrCheck.isInvalid); toggle($cancel, false);
        } else { // idle
            toggle($add, false); toggle($edit, false); toggle($del, false);
            // Save/Cancel only enabled when there are dirty pairs
            var hasDirty = Object.keys(dirtyPairs).length > 0;
            toggle($save, !hasDirty && !narrCheck.isInvalid); toggle($cancel, !hasDirty);
        }
    }

