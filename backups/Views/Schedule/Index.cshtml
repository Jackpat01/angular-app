    window.HandleResize = function () {
        let container = $("#GridContainer").parent();
        if (!container)
            return;

        let grid = $("#Grid");
        if (grid.length === 0) {
            return;
        }

        let width = container.attr('clientWidth');
        let top = container.attr('clientTop');
        if (width == null || width < 1) {
            width = container[0].clientWidth;
        }
        if (width == null || width < 1) {
            width = container.attr('offsetWidth');
        }

        //width = width - 10; // Fudge factor to prevent horizontal scrollbars
        if (width > 0 && Math.abs(width - grid.width()) > 5) {
            // Only resize if new width exceeds a minimal threshold
            // Fixes IE issue with in-place resizing when mousing-over frame bars
            grid.setGridWidth(width);
        }

        let instTop = $("#ScheduleInstructions").position().top;
        let instHeight = $("#ScheduleInstructions").height();
        let headerHeight = 0;
        let colHeader = $(".ui-jqgrid-htable");
        if (colHeader.length > 0) {
            headerHeight = colHeader.height();
        }
        let contentPanelPadding = parseInt($("div#contentPanel").css("padding-bottom"));
        let footerHeight = $(".footer_new").height();

        let offset = instTop + instHeight + headerHeight + contentPanelPadding + footerHeight + 30;

        //let height = $(window).height() - offset;
        //if (height < 120) {
        //    height = 120;
        //}
        let height = "@gridHeight";

        grid.setGridHeight(height);
    };

    window.Pager = {
        Reference: null,
        First: 1,
        Last: 1,
        Current: @Model.SchedulePageCounter,
        InitialLoad: true,  // always allow the page createGrid() to function if first loading a paged schedule.
        Refresh: function () {
            window.Pager.Reference = $("#pager");
            if (window.Pager.Reference.length == 0) {
                return Promise.resolve();
            }

            let ref = window.Pager.Reference;

            window.Pager.First = parseInt(ref.find('.btn-first').val());
            window.Pager.Last = parseInt(ref.find('.btn-last').val());
            //window.Pager.Current = window.Pager.First;

            ref.find('.btn-first').click(function () {
                window.Pager.Current = window.Pager.First;
                window.Pager.LoadPage();
            });

            ref.find('.btn-prev').click(function () {
                window.Pager.Current--;
                if (window.Pager.Current < window.Pager.First) {
                    window.Pager.Current = window.Pager.First;
                }
                window.Pager.LoadPage();
            });

            ref.find('.btn-next').click(function () {
                window.Pager.Current++;
                if (window.Pager.Current > window.Pager.Last) {
                    window.Pager.Current = window.Pager.Last;
                }
                window.Pager.LoadPage();
            });

            ref.find('.btn-last').click(function () {
                window.Pager.Current = window.Pager.Last;
                window.Pager.LoadPage();
            });

            ref.find('.btn-delete').click(function () {
                window.Pager.DeletePage();
            });


            ref.find('.btn-goto').click(function () {
                window.Pager.GotoPage().then(() => {
                    return toggleGotoDiv();
                });
            });

            return window.Pager.LoadContent();
        },
        LoadPage: function () {
            this.updatePagingCounter().then(() => {
                return window.CostReport.Navigation.Sub.Show();
            });
        },
        LoadContent: function () {
            let ref = window.Pager.Reference;
            if (ref.length == 0) {
                // return Promise so this can be chained even if it does nothing.
                return new Promise((resolve, reject) => { resolve(); });
            }

            return LoadNotificationDialog("Loading...").then(() => {
                // Make sure the Grid is not in "edit" mode.
                $("#Grid").jqGrid("editCell", 0, 0, false);

                ref.find('input').val(this.Current);
                $("[data-mask]").each(function (index, element) {
                    let mask = $(element).attr('data-mask');
                    let dataref = mask.replace(new RegExp("\\?", 'g'), String.fromCharCode(64 + window.Pager.Current));
                    //alert(ref);
                    $(element).attr('data-reference', dataref);
                });
                $("[data-format]").each(function (index, element) {
                    let format = $(element).attr("data-format");
                    if (typeof (format) != "undefined") {
                        let formatter = eval("formatter" + format);
                        $(element).val(formatter($(element).val(), null, $(element)));
                    }
                });
            }).then(() => {
                // We pass "true" so that it knows that it is the right order
                // for the main LoadContent with an active Pager.
                return window.LoadContent();
            }).then(() => {
                return ClearNotificationDialog();
            });
        },
        updatePagingCounter: function () {
            let counter = 0;

            if (window.Pager.Reference.length > 0) {
                counter = window.Pager.Current;
            }

            let options = {
                counter: counter,
                first: window.Pager.First,
                last: window.Pager.Last
            };

            return new Promise((resolve, reject) => {
                $.ajax({
                    async: false,
                    url: '@Model.UpdatePageCounterURL',
                    data: options,
                    cache: false,
                    type: "POST",
                    dataType: "json",
                    success: function (data) {
                        //console.log("paging counter updated to [" + data + "]");
                        resolve();
                    },
                    error: function (a, b, c) {
                        StaticAlert({ content: "AJAX callback error, Reloading grid: " + a.responseText }).then(() => {
                            resolve();
                        });
                    }
                });
            });
        },
        DeletePage: function () {
            let counter = 0;

            if (window.Pager.Reference.length > 0) {
                counter = window.Pager.Current;
            }

            let options = {
                counter: counter,
                first: window.Pager.First,
                last: window.Pager.Last
            };

            return StaticConfirm({
                title: "Delete Confirm",
                content: "Delete this Administrator?",
                buttons: ["Ok", "Cancel"]
            }).then((key) => {
                if (key != 0) return;
                return LoadNotificationDialog("Deleting Administrator...").then(() => {
                    return new Promise((resolve, reject) => {
                        $.ajax({
                            async: false,
                            url: '@Model.DeletePageURL',
                            data: options,
                            cache: false,
                            type: "POST",
                            dataType: "json",
                            success: function (response) {
                                if (response === null) {
                                    resolve();
                                    return;
                                }

                                if (!!response.Success && !!response.Data) {
                                    window.Pager.HandleSelectedValue(response.Data);

                                    LoadNotificationDialog("Recalculating...").then(() => {
                                        return window.CostReport.Selected.LoadModelOCRT();
                                    }).then(() => {
                                        window.CostReport.Selected.ModelOCRT.Updated = true;
                                        window.CostReport.Selected.Flag_UpdatedOCRT = true;
                                        return window.CostReport.InRuleCalculation.ProcessCostReportCalcHandler(true, false);
                                    }).then(() => {
                                        return window.CostReport.Selected.Show();
                                    }).then(() => {
                                        return ClearNotificationDialog();
                                    }).then(() => {
                                        resolve();
                                    });
                                }
                                resolve();
                            },
                            error: function (a, b, c) {
                                StaticAlert({ content: "AJAX callback error, Deleting Page: " + a.responseText }).then(() => {
                                    resolve();
                                });
                            }
                        });
                    });
                });
            }).then(() => {
                return ClearNotificationDialog();
            });
        },
        GotoPage: function () {
