                            let rowCount = 0;

                            if (!!gridCellDefArray) {
                                // only create the pattern once instead of every
                                // time in the loop since 'page' doesn't change...
                                let pattern = new RegExp(page + "[A-Z]\\b"); // /A[A-Z]\b/;

                                // Reload - we need to ensure the array is reset.
                                window.CostReport.Grid.defArray = [];

                                // Highlight Edit colors in the Grid.
                                for (let i = 0; i < gridCellDefArray.length; i++) {
                                    let element = gridCellDefArray[i];
                                    let def = {
                                        Name: element[0],           // 'Col' + DisplayColumn
                                        DisplayLine: element[1],
                                        ForeColor: element[2],
                                        BackColor: element[3],
                                        CanEdit: element[4],
                                        Align: element[5],
                                        IsBold: element[6],
                                        IsItalic: element[7],
                                        RowSpan: element[8],
                                        ColSpan: element[9],
                                        RangeName: element[10],
                                        ToolTip: element[11]
                                    };

                                    window.CostReport.Grid.defArray.push(def);

                                    // On our way through, determine the column and row counts for the grid.
                                    let colIndex = parseInt(element[0].replace('Col', ''));
                                    if (colIndex > colCount)
                                        colCount = colIndex;

                                    let rowIndex = parseInt(element[1]);
                                    if (rowIndex > rowCount)
                                        rowCount = rowIndex;

                                    if (!!page && page != "") {
                                        if (!pattern.test(def.RangeName)) {
                                            continue;
                                        }
                                    }

                                    if (!row || row != def.DisplayLine) {
                                        row = def.DisplayLine;
                                        skip = 0;
                                    }

                                    //if (def.BackColor != "white") {
                                    //    console.log("checking cell ", def);
                                    //}

                                    let classParam = {};
                                    classParam['color'] = (def.ForeColor) ? def.ForeColor : 'black';
                                    classParam['background-color'] = (def.BackColor) ? def.BackColor : 'white';
                                    if (def.Align) classParam['text-align'] = def.Align;
                                    if (def.IsBold) classParam['font-weight'] = 'bold';
                                    if (def.IsItalic) classParam['font-style'] = 'italic';
                                    if (def.RowSpan != 1) classParam['rowspan'] = def.RowSpan;

                                    //debugger;
                                    $("#Grid").setCell(def.DisplayLine, def.Name, '', classParam, { 'data-rangename': def.RangeName });

                                    //if (def.IsBold) {
                                    //    $("#Grid").setCell(def.DisplayLine, def.Name, '', { 'font-weight': 'bold' });
                                    //}

                                    //if (def.IsItalic) {
                                    //    $("#Grid").setCell(def.DisplayLine, def.Name, '', { 'font-style': 'italic' });
                                    //}

                                    //if (def.RowSpan != 1) {
                                    //    $("#Grid").setCell(def.DisplayLine, def.Name, '', { 'rowspan': def.RowSpan });
                                    //}

                                    if (def.ColSpan != 1 || def.RowSpan != 1) {
                                        let cs = def.ColSpan;
                                        let thisRow = $("#Grid").find("tr[id='" + def.DisplayLine + "']");
                                        let thisCell = thisRow.find("td[aria-describedby='Grid_" + def.Name + "']");
                                        let rs = def.RowSpan;
                                        let theRow = thisRow;
                                        while (rs > 0) {
                                            let cs = def.ColSpan;
                                            let theCell = theRow.find("td[aria-describedby='Grid_" + def.Name + "']");
                                            while (cs > 0) {
                                                if (theCell.is(thisCell)) {
                                                    theCell.attr("rowspan", def.RowSpan).attr("colspan", def.ColSpan);
                                                } else {
                                                    theCell.css("display", "none");
                                                }
                                                theCell = theCell.next();
                                                cs--;
                                            }
                                            theRow = theRow.next();
                                            rs--;
                                        }
                                    }

                                    // if the cost report has been submitted, all grid cells are read-only
                                    if (window.CostReport.CostReportLocked) {
                                        $("#Grid").setCell(def.DisplayLine, def.Name, '', 'not-editable-cell');
                                    } else {
                                        if (def.CanEdit) {
                                            $("#Grid").setCell(def.DisplayLine, def.Name, '', 'editable-cell');
                                        } else {
                                            $("#Grid").setCell(def.DisplayLine, def.Name, '', 'not-editable-cell');
                                        }
                                        $("#Grid").setCell(def.DisplayLine, def.Name, '', '', { 'title': def.ToolTip });
                                    }
                                }

                                // Save the column and row counts as grid attributes.
                                $("#Grid")
                                    .attr("data-colcount", colCount)
                                    .attr("data-rowcount", rowCount);
                            }

                            $("#Grid").parent().css("height", "");
                        }).then(() => {
                            // NOTE: this is the pair to the call done in beforeRequest() above.
                            return ClearNotificationDialog();
                        }).then(() => {
                            // this will clear the "Load Schedule Name" notification above
                            // AFTER the schedule loads, which will be after the promise returns!
                            resolve();
                        });
                    },
                    loadError: function (jqXHR, textStatus, errorThrown) {
                        var message = 'HTTP status code: ' + jqXHR.status + '\n' +
                            'textStatus: ' + textStatus + '\n' +
                            'errorThrown: ' + errorThrown;
                        StaticAlert({ content: message }).then(() => {
                            return StaticAlert({ content: 'HTTP message body (jqXHR.responseText): ' + '\n' + jqXHR.responseText });
                        }).then(() => {
                            // this will clear the "Load Schedule Name" notification above
                            // AFTER the schedule loads, which will be after the promise returns!
                            resolve();
                        });
                    },
                    @Html.Raw(Model.SummaryGridRefreshCall)
                    gridComplete: function () {
                        requestAnimationFrame(() => {
                            window.HandleResize();
                            //$('.ui-jqgrid-hdiv').hide();
                            jQuery("#Grid").closest(".ui-jqgrid-bdiv").scrollTop(0);
                            jQuery("#Grid").setSelection(0);
                        });
                    }
                });
            }).then(() => {
                if (!!(window?.CostReport?.Grid?.GroupHeaders) && window?.CostReport?.Grid?.GroupHeaders?.length > 0) {
                    $("#Grid").jqGrid("setGroupHeaders", {
                        useColSpanStyle: true,
                        groupHeaders: window.CostReport.Grid.GroupHeaders
                    });
                    OnGridResize();
                }

                jQuery("#Grid").jqGrid('setSelection', "1");
                jQuery("#Grid").focus();
            });
        }).then(() => {
            window.scrollTo(0, 0);
            return ClearNotificationDialog();
        });
    }

var isChangeAuditButtonDisabled = '@isEditAuditAdjustment';
