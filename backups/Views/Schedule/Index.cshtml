                                    { name: 'SSN', index: 'SSN', width: 85, align: 'left' },
                                    { name: 'License', index: 'License', width: 85, align: 'left' }
                                ],
                                loadComplete: function (data) {
                                    if (!!mydata && firstLoad) {
                                        for (let i = 0; i < mydata.length; i++) {
                                            completedRows = (i == mydata.length - 1);
                                            jQuery("#GotoGrid").jqGrid('addRowData', i + 1, mydata[i]);
                                        }
                                        firstLoad = false;
                                        $("#GotoGrid").parent().css("height", "");
                                        resolve();
                                    }
                                    else {
                                        $("#GotoGrid").parent().css("height", "");
                                        resolve();
                                    }
