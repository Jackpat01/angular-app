                        return true;
                    },
                    beforeSaveCell: function (rowid, cellname, value, iRow, iCol) {
                        var selfGrid = $("#Grid"), $self = $(this);
                        $self.jqGrid.savingFlag = true;

                        let ref = $("#Grid").find("tr[role=row][id=" + iRow + "]>td[aria-describedby=Grid_" + cellname + "]");
                        let elem = ref.find("input");
                        let defaultValue = $(elem).attr("default");

                        if ($(elem).attr("max")) {
                            var maxVal = Number($(elem).attr("max"));
                            if ($(elem).attr("precision")) {
                                let precisionVal = Number($(elem).attr("precision"));
                                if (precisionVal != undefined && precisionVal > 0) {
                                    maxVal = maxVal.toFixed(precisionVal);
                                }
                            }
                        }

                        // SSN data type
                        if (elem.attr("data-type") === "8" || elem.attr("datatype") === "8") {
                            value = $(elem).val();
                            return formatterSSN(value);
                        }
                        // Federal Tax Id data type
                        else if (elem.attr("data-type") === "13" || elem.attr("datatype") === "13") {
                            value = $(elem).val();
                            return formatterFederalID(value);
                        }
                        // US Postal Code data type
                        else if (elem.attr("data-type") === "11" || elem.attr("datatype") === "11") {
                            value = $(elem).val();
                            return formatterPostalCodeUS(value);
                        }
                        // US Phone Number data type
                        else if (elem.attr("data-type") === "14" || elem.attr("datatype") === "14") {
                            value = $(elem).val();
                            return formatterPostalCodeUS(value);
                        }
                        // VARCHAR data type
                        else if (elem.attr("data-type") === "1") {
                            if (defaultValue != 'undefined' && (elem.val().trim().length === 0 ||
                                (elem.val().trim().length > 0 && (Number(elem.val()) > Number(defaultValue))))) {
                                elem.val(defaultValue);
                                return elem.val();
                            }
                            else if (maxVal != 'undefined' && (elem.val().trim().length > 0 && (Number(elem.val()) > Number(maxVal)))) {
                                elem.val(maxVal);
                                return elem.val();
                            }

                            if (elem.val().trim().length === 0 || elem.val() === "NaN" || elem.val() === "." || elem.val() === "-") {
                                elem.val("");
                                return "";
                            }
                        }
                        // NUMBER data types
                        else if (elem.attr("data-type") === "2" || elem.attr("data-type") === "3" ||
                            elem.attr("data-type") === "9" || elem.attr("data-type") === "10" ||
                            elem.attr("datatype") === "2" || elem.attr("datatype") === "3" ||
                            elem.attr("datatype") === "9" || elem.attr("datatype") === "10") {

                            if (defaultValue != 'undefined' && (elem.val().trim().length === 0 ||
                                (elem.val().trim().length > 0 && (Number(elem.val()) > Number(defaultValue))))) {
                                elem.val(defaultValue);
                                return elem.val();
                            }
                            else if (maxVal != 'undefined' && (elem.val().trim().length > 0 && (Number(elem.val()) > Number(maxVal)))) {
                                elem.val(maxVal);
                                return elem.val();
                            }

                            // If the value has been cleared with spaces or by deleting the value, then return an empty value.
                            // if value is merely a dash, decimal, or "NaN", then we need to return an empty value.
                            if (elem.val().trim().length === 0 || elem.val() === "NaN" || elem.val() === "." || elem.val() === "-") {
                                elem.val("");
                                return "";
                            }

                            let precision = 0;
                            if ($(elem).attr("precision")) {
                                precision = Number($(elem).attr("precision"));
                                if (precision == undefined || precision < 0) {
                                    precision = 0;
                                }
                            }

                            // Set the default length to 10. If a length was provided via the "maxlength" attribute, then use that. If a
                            // non-zero precision was also provided, assume that the decimal point was not accounted for, and increment the
                            // length by 1. If the length still does not allow for at least one character to the left of the decimal point,
                            // then set the length equal to the precision + 2.
                            let length = 10;
                            if ($(elem).attr("maxlength")) {
                                length = Number($(elem).attr("maxlength")) + 1;
                                if (precision > 0) {
                                    length++;
                                    if (length - precision < 2) {
                                        length = precision + 2;
                                    }
                                }
                            }

                            let lengthIntegerPart = length;
                            if (precision > 0) {
                                lengthIntegerPart -= (precision + 1);
                            }
                            if (lengthIntegerPart < 0) {
                                lengthIntegerPart = 0;
                            }

                            let numericValue = Number($(elem).val());
                            if (!isNaN(numericValue)) {
                                let isNegative = numericValue < 0;

                                let minimumNon0 = 1;
                                if (precision > 0) {
                                    minimumNon0 = minimumNon0 / (10 ** precision);
                                }
                                let max = Number(10 ** lengthIntegerPart) - minimumNon0;
                                if ($(elem).attr("max")) {
                                    max = Number($(elem).attr("max"));
                                }

                                if (isNegative) {
                                    let threshold = 0 - max;
                                    if (numericValue < threshold) {
                                        $(elem).val("");
                                        return "";
                                    }
                                } else {
                                    let threshold = max;
                                    if (numericValue > threshold) {
                                        $(elem).val("");
                                        return "";
                                    }
                                }

                                if ("@Model.Schedule" === "A-1" ) {
                                    if ($(elem).val().includes('.')) {
                                        $(elem).val(numericValue.toFixed(precision));
                                    } else {
                                        $(elem).val(numericValue);
                                    }
                                } else {
                                    if (precision > 0) {
                                        $(elem).val(numericValue.toFixed(precision));
                                    } else {
                                        $(elem).val(Math.round(numericValue));
                                    }
                                }
                            }

                            value = $(elem).val();
                            //$("#Grid").jqGrid("setCell", rowid, cellname, value);
                        }
                        // DATE data type
                        else if (elem.attr("data-type") === "6" || elem.attr("datatype") === "6") {
                            // check - it is a valid date or not.
                            var daterequested = $(elem).val();
                            var dateMMDDYYYRegex = /^(0[1-9]|1[0-2]|\d)\/(0[1-9]|1\d|2\d|3[01]|\d)\/(((19|20)\d{2})|\d{2})$/;
                            if (daterequested.match(dateMMDDYYYRegex) && isValidDate(daterequested)) {
                                //console.log("is a valid date: " + daterequested);

                                shortDate = $(elem).val();
                                value = formatShortDate(shortDate);
                            } else {
                                //console.log("is not a valid date: " + daterequested);
                                return "";
                            }
                        }

                        //debugger;
                        // This is for applying any custom formatting that should be saved.
                        return applyCustomFormatter(columnModel[iCol], value, ref);
                        //return { rowId: iRow, colId: iCol + 1, colValue: value, rangeName: ref.attr("data-rangename") }
                    },
                    beforeSubmitCell: function (rowid, cellname, value, iRow, iCol) {
                        ////console.log("beforeSubmitCell");
                        let ref = $("#Grid").find("tr[role=row][id=" + iRow + "]>td[aria-describedby=Grid_" + cellname + "]");
                        let elem = ref.find("input");
                        // This is a promise, but will run async to the server submit.
                        window.CostReport.Selected.UpdateModelOCRT({ ref: elem, rangeName: ref.attr("data-rangename"), value: value, rowId: rowid, col: iCol });
                        return { rowId: iRow, colId: iCol + 1, colValue: value, rangeName: ref.attr("data-rangename") }
                    },
