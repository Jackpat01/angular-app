            .then(() => {
                document.getElementById(`${popUpId}_content`).appendChild(stdNarrGrid);
                stdNarrGrid.hidden = false;
            }).then(() => {
                const closeButton = document.createElement('button');
                closeButton.innerText = 'Close';
                closeButton.id = 'stdNarrSearchCloseBtn';
                closeButton.onclick = handleStdNarrSearchPopUp;
                closeButton.style.height = '60%';

                const title = document.getElementById(`${popUpId}_title`);
                title.style.display = 'flex';

                const space = document.createElement('div');
                space.style.width = '65%';
                space.style.padding = '5px';

                title.appendChild(space);
                title.appendChild(closeButton);
            });
        } else {
            window.PopupWindow.CloseWindow(popUpId);
        }

    }

    function getStdNarrTableData() {
        return new Promise((resolve, reject) => {
            $.ajax({
                async: true,
                url: '@Url.AbsoluteAction("GetStandardNarrativesForSearch", "CostReport")',
                contentType: "application/json;charset=utf-8",
                type: 'POST',
                cache: false,
                success: function (result) {
                    if (result.Success) resolve(result);
                },
                error: function (errorMessage) {
                    StaticAlert({ content: `Standard Narrative Table  Error: ${errorMessage.responseText}` }).then(resolve);
                }
            });
        });
    }

    function renderStdNarrTable(result, tableGrid) {
        var cols = [];
        for (const col of result.Data.Columns) {
            let column = {
                field: col.Field, headerText: col.HeaderText, isPrimaryKey: col.IsPrimaryKey, isIdentity: col.IsIdentity, visible: col.Visible,
                textAlign: col.TextAlign, allowEditing: col.AllowEditing, allowFiltering: col.AllowFiltering, allowSorting: col.AllowSorting,
                width: col.Width, template: col.Template
            };
            cols.push(column);
        }

        const editSettings = { allowEditing: false, allowAdding: false };
        const toolbarSettings = { showToolbar: true, toolbarItems: [ej.Grid.ToolBarItems.Search] };
        const pageSettings = { pageSize: result.Data.Records.length };
        const textWrapSettings = { wrapMode: ej.Grid.WrapMode.Both };

        $(`#${tableGrid}`).ejGrid({
            dataSource: result.Data.Records,
            columns: cols,
            editSettings: editSettings,
            toolbarSettings: toolbarSettings,
            pageSettings: pageSettings,
            enableRowHover: false,
            allowTextWrap: true,
            //allowSearching: true,
            textWrapSettings: textWrapSettings,
            cssClass: 'mslcTable',
            locale: 'en-US'
        });

        $(`#${tableGrid}_searchbar`).on('click', function () {
            $(this).focus();
        });
    }

