                                function () { $(this).css('background', ''); }
                            );
                            $list.append($opt);
                        });

                        $wrapper.append($btn).append($list);
                        $td.append($wrapper);

                        // Toggle list on button click
                        $btn.on('click', function (e) {
                            e.stopPropagation();
                            $list.toggle();
                        });

                        // Pick option on click
                        $list.on('click', 'div', function () {
                            var val = $(this).data('val');
                            var txt = $(this).data('txt');
                            commit(val, txt);
                        });

                        // Close list if clicked outside
                        $(document).off('click.customDD').on('click.customDD', function () {
                            $list.hide();
                        });

                        function commit(val, txt) {
                            var currentValue = String($grid.jqGrid('getCell', rowid, 'AccountTypeValue') || '');
                            var newValue = String(val || '');

                            if (currentValue === newValue) {
                                $list.hide();
                                refocusCell(rowid, 'Adjustment');
                                return;
                            }

                            $grid.jqGrid('setCell', rowid, 'AccountTypeValue', String(val));
                            $grid.jqGrid('setCell', rowid, 'AccountTypeDisplay', txt);
                            $grid.jqGrid('setCell', rowid, 'Adjustment', null);
                            $sel.val(String(val));   // also update hidden native select for consistency
                            markDirty(rowData.AdjustmentPairId);
                            handleCellSaved(rowid, 'AccountTypeDisplay', val);
                            handleCellSaved(rowid, 'Adjustment', null);
                            $list.hide();
                            $btn.text(txt);
                            $btn.append('<span style="position:absolute;right:4px;top:8px;border:4px solid transparent;border-top-color:#444;"></span>');

                            setTimeout(function () {
                                try {
                                    $grid.jqGrid('restoreCell', iRow, iCol);
                                } catch (e) { }
                                // restoreCell may wipe display; re-set
                                $grid.jqGrid('setCell', rowid, 'AccountTypeDisplay', txt);
                                $grid.jqGrid('setCell', rowid, 'AccountTypeValue', String(val));
                                $grid.jqGrid('setCell', rowid, 'Adjustment', null);

                                // Reset jqGrid's iRow/iCol state so next click works
                                $grid.jqGrid('setGridParam', { iRow: null, iCol: null });

                                // Restoring the cell causes a strange bug, where the next column will be readonly
                                // until the user clicks a different editable cell and returns to the one that
                                // was incorrectly readonly. Using these two timeouts simulates doing that process on
                                // the UI in a way the user won't notice.
                                setTimeout(function () {
                                    $grid.jqGrid('editCell', iRow, iCol - 3, true);
                                    document.activeElement.click();
                                }, 10);
                                setTimeout(function () {
                                    $grid.jqGrid('editCell', iRow, iCol + 4, true);
                                }, 20);
                            }, 50);
                        }

                        // Open dropdown right away so user sees options
                        $btn.trigger('click');
                    }, 100);
                }

                var selfGrid = $("#Grid"), $self = $(this);
                var inputControl = $('#' + (iRow) + '_' + cellname); //$("#" + this.id + " tbody>tr:eq(" + iRow + ")>td:eq(" + iCol + ") input, select, textarea", $td);
                inputControl.select();
                window.SetCell(selfGrid, inputControl, cellname, iRow, iCol);

                var rawInput = $("#" + this.id + " tbody>tr:eq(" + iRow + ")>td:eq(" + iCol + ") input");

                //TODO: I hate this, but not able to determine why focus goes back to the keyboard
                //      navigation DIV instead of the cell being edited. So, we have to force it. :(
                //      This may have something to do with the "trick" to process keydown on non-input
                //      elements: https://github.com/free-jqgrid/jqGrid/blob/master/js/grid.celledit.js line 530
                setTimeout(() => {
                    // by requesting an animation frame stable call, this should prevent setting focus
                    // during a JavaScript "reflow event" that could be causing the replacement of cell
                    // data with HTML control content code.
                    requestAnimationFrame(() => {
                        rawInput
                            .select()
                            .focus();
                    });
                }, 1);
            },


