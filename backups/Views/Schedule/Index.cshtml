                }
            },

            afterEditCell: function (rowid, cellname, value, iRow, iCol) {
                //auditAdjustmentHasUnsavedChanges = true;
                var rowData = $grid.jqGrid('getRowData', rowid);

                if (rowData.LineNo === '1' && (cellname === 'Narr1' || cellname === 'Narr2' || cellname === 'Narr3')) {
                    var inputControl = $('#' + (iRow) + '_' + cellname);
                    inputControl.select();

                    inputControl.off("keydown")
                        .on("keydown", function (e) {
                            switch (e.which) {
                                case 9:
                                case 13:
                                        handleNarrativeBlur(rowid, cellname, e.target.value ? e.target.value.trim() : '', iRow, iCol);
                                        markDirty(rowData.AdjustmentPairId);
                                        $grid.jqGrid('editCell', iRow, iCol + 1, true);
                                     break;
                                default:
                                    e.target.value = e.target.value.replace('x', 'X');
                                    break;
                            }
                        });
                    return;
                }
                if (cellname === 'AccountTypeDisplay') {
                    var info = accountInfoCache[$.trim(rowData.AccNum || '')];
                    if (!info || !info.accountTypeOptions || !info.accountTypeOptions.length) return;

                    setTimeout(function () {
                        var $tr = $grid.find('#' + $.jgrid.jqID(rowid));
                        var $td = $tr.children('td').eq(iCol);
                        var $sel = $td.find('select').first();
                        if (!$sel.length) return;

                        // Hide jqGrid's broken native select
                        $sel.hide();

                        // Remove any old custom UI
                        $td.find('.__customDD').remove();

                        var currentValue = String(rowData.AccountTypeValue || '');
                        var currentText = '-- Select --';
                        for (var i = 0; i < info.accountTypeOptions.length; i++) {
                            if (String(info.accountTypeOptions[i].value) === currentValue) {
                                currentText = info.accountTypeOptions[i].text;
                                break;
                            }
