                                cache: false,
                                editable: false,
                                gridview: true,
                                autowidth: true,
                                scrollOffset: 0,
                                height: "auto",
                                shrinkToFit: false,
                                ajaxCellOptions: { async: true },
                                repeatitems: false,
                                colNames: ['PageNo', 'Name', 'SSN', 'License'],
                                colModel: [
                                    { name: 'PageNumber', index: 'PageNumber', width: 60, align: 'center' },
