    function deleteSelected() {
        if (isReadOnly()) return;
        var rowid = $grid.jqGrid('getGridParam', 'selrow');
        if (!rowid) {
            StaticAlert({
                title: 'Audit Adjustment Delete Notification',
                content: 'Select a row to delete'
            });
            return;
        }
        var pairId = $grid.jqGrid('getCell', rowid, 'AdjustmentPairId');

        StaticConfirm({
            title: "Confirm Audit Audjustment Delete",
            content: 'Are you sure you want to Delete Adjustment?',
            buttons: ['Yes', 'No']
        }).then((key) => {
            if (key != 0) {
                //Reload
                reloadAuditGrid();
                return;
            }
            // New (unsaved) pair: just remove the rows
            if (String(pairId).indexOf('NEW_') === 0) {
                var pair = getRowsByPair(pairId);
                if (pair.line1) $grid.jqGrid('delRowData', pair.line1.id);
                if (pair.line2) $grid.jqGrid('delRowData', pair.line2.id);
                delete dirtyPairs[pairId];
                reloadAuditGrid();
                return;
            }

            var pair = getRowsByPair(pairId);
            if (!pair.line1) { return; }
            var l1 = pair.line1.data;
            var l2 = pair.line2 ? pair.line2.data : {};
            //alert(JSON.stringify(l1));

            $.ajax({
                url: "@Url.AbsoluteAction("DeleteAdjustment", "Schedule")",
                type: 'POST',
                data: {
                    adjustmentPairId: pairId,
                    accNum: l1.AccNum,
                    line2RatioAlloc: l2.RatioAlloc
                },
                success: function (r) {
                    if (r.success) {
                        delete dirtyPairs[pairId];
                       // Reload after server delete
                        reloadAuditGrid();
                    } else {
                        StaticAlert({
                            title: 'Audit Adjustment Delete Notification',
                            content: (r && r.message) || 'Delete failed.'
                        });
                    }
                }
            });
        });
    }

    /**
     * Save.
     * - NEW_* pairs go to SaveAuditAdjustment (creates both lines server-side).
     * - Existing pairs go to UpdateAuditAdjustment.
     */
    function saveAll() {
		if (isReadOnly()) return;
        var pairIds = Object.keys(dirtyPairs);
        if (pairIds.length === 0) {
            //StaticAlert({
            //    title: 'Audit Adjustment Save Notification',
            //    content: 'No changes to save.'
            //});

            //Reload 
            reloadAuditGrid();
            return;
        }

        var queue = pairIds.slice();
        var errors = [];

        function next() {
            if (queue.length === 0) {
                if (errors.length) {
                    StaticAlert({
                        title: 'Audit Adjustment Save Notification',
                        content: 'Your action to save records failed'
                    });
                } else {
                    dirtyPairs = {};
                }
                //Reload after save
                reloadAuditGrid();
                return;
            }

            var pairId = queue.shift();
            var pair = getRowsByPair(pairId);
            if (!pair.line1) { next(); return; }
            var l1 = pair.line1.data;
            var l2id = pair.line2 ? pair.line2.id : null;
            if (!l1.AccNum) {
                var msg = 'Account Number missing';
                // show message on AdjustmentPairId matching Line 2           
                showInvalidAccountOnLine2(pairId, msg);
                errors.push('Pair ' + pairId + ': Account Number missing');
                refocusCell(l1.AdjustmentPairId, 'AccNum');
                return;
            }
            if (!l1.Narr1 && !l1.Narr2 && !l1.Narr3) {
                var msg = 'Must supply at least one narrative';
                // show message on AdjustmentPairId matching Line 2 
                showInvalidAccountOnLine2(pairId, msg);
                errors.push('Pair ' + pairId + ': at least one narrative required');
                refocusCell(l1.AdjustmentPairId, 'Narr1');
                return;
            }
            if (!l1.Narr1 && (l1.Narr2 || l1.Narr3)) {
                var msg = 'Narratives must be entered in sequential order.';
                // show message on AdjustmentPairId matching Line 2 
                showInvalidAccountOnLine2(pairId, msg);
                errors.push('Pair ' + pairId + ': Narrative 1 is required');
                refocusCell(l1.AdjustmentPairId, 'Narr1');
                return;
            }
            if (l1.Narr1 && !l1.Narr2 && l1.Narr3) {
                var msg = 'Narratives must be entered in sequential order.';
                // show message on AdjustmentPairId matching Line 2 
                showInvalidAccountOnLine2(pairId, msg);
                errors.push('Pair ' + pairId + ': Narrative 2 is required');
                refocusCell(l1.AdjustmentPairId, 'Narr1');
                return;
            }
            if (!l1.AccountTypeDisplay && !l1.AccountTypeValue) {
                var msg = 'Salary/Other/Period missing';
                showInvalidAccountOnLine2(pairId, msg);
                errors.push('Pair ' + pairId + ': Salary/Other/Period missing');
                refocusCell(l1.AdjusmentPairId, 'AccountTypeDisplay');
                return;
            }
            else
            {
                var ids = $grid.jqGrid('getDataIDs');

                                                for (var i = 0; i < ids.length; i++) {
                                                    var rowData = $grid.jqGrid('getRowData', ids[i]);
                                                    if (parseInt(rowData.LineNo, 10) !== 1) continue;

                                                    var narrs = [
                                                        $.trim(rowData.Narr1 || ''),
                                                        $.trim(rowData.Narr2 || ''),
                                                        $.trim(rowData.Narr3 || '')
                                                    ].filter(function (v) { return v !== ''; });

                                                    var seen = {};
                                                    var hasDuplicate = false;
                                                    narrs.forEach(function (v) {
                                                        if (seen[v]) hasDuplicate = true;
                                                        seen[v] = true;
                                                    });

                                                    if (hasDuplicate) {
                            var msg = 'Narrative numbers in Narr1, Narr2, and Narr3 must all be different'
                        // show message on AdjustmentPairId matching Line 2 
                        showInvalidAccountOnLine2(pairId, msg);
                        errors.push('Row with AccNum ' + rowData.AccNum +
                                                                ' has duplicate narrative numbers in Narr1/Narr2/Narr3. ' +
                                                                'Each must be different.');
                        refocusCell(l1.AdjustmentPairId, 'Narr1');
                        return;
                                                    }
                                                }
                //auditAdjustmentHasUnsavedChanges = false;
            }
            if (l1.Adjustment) {
                var info = validateInteger(l1.Adjustment);

                if (!info) {
                    var msg = 'Adjustments must be a whole number';
                    // show message on AdjustmentPairId matching Line 2           
                    showInvalidAccountOnLine2(pairId, msg);
                    errors.push('Pair ' + pairId + ': Adjustments must be a whole number');
                    refocusCell(l1.AdjustmentPairId, 'Adjustment');
                    return;
                 }
            }

            var isNew = String(pairId).indexOf('NEW_') === 0;
            var url = isNew ? '@Url.Action("SaveAuditAdjustment", "Schedule")' : '@Url.Action("UpdateAuditAdjustment", "Schedule")';
            var payload = {
                AccNum: l1.AccNum,
                WorkPaperReference: l1.WorkPaperReference,
                WorkSheetName: l1.WorkSheetName,
                Narr1: l1.Narr1, Narr2: l1.Narr2, Narr3: l1.Narr3,
                Col: l1.Col || null,
                AccountType: l1.AccountTypeValue,
                //AccountType: parseAccountTypeFromDisplay(l1.AccountTypeDisplay),
                //RatioAlloc: '1.0000',
                RatioAlloc: '',
                ReportedOrAdjusted: l1.ReportedOrAdjusted,
                Adjustment: l1.Adjustment,
                Adjusted: l1.Adjusted,
                Line2Narr2: pair.line2.data.Narr2,
                Line2RatioAlloc: pair.line2 ? pair.line2.data.RatioAlloc : '1.0000'
            };
            if (!isNew) payload.AdjustmentPairId = pairId;

            $.ajax({
                url: url, type: 'POST', data: payload,
                success: function (r) {
                    if (!r.success) errors.push('Pair ' + pairId + ': ' + r.message);
                    next();
                },
                error: function () { errors.push('Pair ' + pairId + ': server error'); next(); }
            });
        }

        //Check if any of the adjustments are empty before saving
        let emptyAdjustment = false;
        for (let pairId of queue) {
            var pair = getRowsByPair(pairId);
            var l1 = pair.line1.data;

            if (l1.Adjustment == '') {
                emptyAdjustment = true;
                break; //once we have determined there is an empty adjustment, no need to continue searching
            }
        }

        if (emptyAdjustment) {
            StaticConfirm({
                title: 'Audit Adjustment Save Notification',
                content: 'At least one adjustment amount is blank, do you want to continue?',
                buttons: ['Yes', 'No']
            }).then(function (key) {
                if (key != 0) {
                    //Reload 
                    reloadAuditGrid();
                    return;
                } else {
                    next();
                }
            });
        } else {
            next();
        }
    }

    function verifyCloseWithUnsavedChanges() {
        // Get the currently selected row in the jqGrid
        var rowId = $grid.jqGrid('getGridParam', 'selrow'); // jqGrid selected row

        return new Promise((res, rej) => {
            var pairIds = Object.keys(dirtyPairs); // Check if there are unsaved changes
            if (pairIds.length !== 0) {
                // Show confirmation dialog
                StaticConfirm({
                    title: "Audit Adjustment Unsaved Changes",
                    content: 'There are unsaved changes, are you sure you want to close without saving your changes?',
                    buttons: ["Yes", "No"]
                }).then((key) => {
                    if (key != 0) { // User clicked "No"
                        // Handle refocusing on the grid and active cell
                        var queue = pairIds.slice();
                        var pairId = queue.shift(); // Get the first pair ID in the queue

                        // Get the pair and its data
                        var pair = getRowsByPair(pairId);

                        // Get the required cell to refocus
                        if (pair && pair.line1 && pair.line1.data) {
                            var l1 = pair.line1.data;

                            // Ensure the grid focuses back on the selected row
                            $grid.jqGrid("setSelection", rowId, true); // Select the row in the grid

                            // Refocus the specific cell for the current row
                            refocusCell(l1.AuditAdjustmentId, 'AccNum');
                        }
                        return; // Exit the promise to stay on the screen
                    } else { // User clicked "Yes"
                        // Clear unsaved changes and proceed
                        cleanPairs(pairIds);
                        return res(); // Resolve the promise
                    }
                });
            } else {
                return res(); // No unsaved changes, resolve the promise
            }
        });
    }

