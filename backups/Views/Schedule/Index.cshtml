    function gridLineShiftDown(min, max) {
        // Handle date picker, if necessary
        if ($("div.datepicker").length > 0) {                       // Is there is a datepicker?
            if (!$(".ui-datepicker").is(":hidden")) {               // If there is a datepicker, check if it is visible.
                $(".datepicker").remove();                            // Is visible; remove the date picker.
            }
        }

        // if already processing a grid line panel operation, prevent another one right now.
        if (window.GridLinePanel.Processing) return;
        // ensure that calculations and save operations are complete first.
        return window.CostReport.Selected.Flush().then(() => {
            window.GridLinePanel.Processing = true;

            if (!window.CostReport.CostReportEditable) {
                return StaticAlert({ content: "Cost report is locked." }).then(() => {
                    window.GridLinePanel.Processing = false;
                });
            }

            var selfGrid = document.getElementById("Grid");
            var row = selfGrid.EditingRow;
            var col = selfGrid.EditingCol;

            if (row == null || col == null) {
                return StaticAlert({ content: "No cell selected in grid." }).then(() => {
                    window.GridLinePanel.Processing = false;
                });
            }

            // Make sure the Grid is not in "edit" mode.
            $("#Grid").jqGrid("editCell", 0, 0, false);

            if (window.GridLineShiftBoundaries != null) {
                let temp = window.GridLineShiftBoundaries(row);
                if (temp != null) {
                    min = temp.min;
                    max = temp.max;
                }
            }

            // Validate there is at least one row to shift down.
            if (row < min || row >= max) {
                window.GridLinePanel.Processing = false;
                return;
            }

            var options = {
                action: @glShiftDown, // Shift specified line down 1
                row: row,
                min: min,
                max: max
            };

            // Update the data model, then use the jqGrid method to update the internal data in the grid
            // https://stackoverflow.com/questions/9145163/how-to-update-value-of-data-in-jqgrid

            // Get a quick reference for the grid cell array
            let cells = window.CostReport.Grid.defArray;

            // Get the current schedule data model for the values.
            let model = window.CostReport.Selected.GetCurrentModelSchedule();

            // Setup array for saving values back to server.
            let valueList = [];

            // Get reference of the HTML grid.
            let myGrid = $("#Grid");

            let rowCells = cells.filter(d => d.DisplayLine == row);
            let thisRowData = {
                length: 0
            };
            let swapRowData = {
                length: 0
            };

            // Get the swap row
            let swapCells = cells.filter(d => d.DisplayLine == row + 1);

            // Loop through the columns
            for (let c = 0; c < rowCells.length; c++) {
                let thisCell = rowCells[c];

                // If there is no range name, skip it.
                if (thisCell.RangeName == null || thisCell.RangeName == '') continue;

                // Get the model for this cell.
                let thisModel = model['Cell_' + thisCell.RangeName] ?? null;

                // If this model was not found, skip it.
                if (thisModel == null) continue;

                // Determine the type and value of the model value.
                let thisVal = determineValueAndType(thisModel);

                // Assign the current row range name the swap row value for the same column.
                let swapCell = null;
                let checkCells = swapCells.filter(d => d.Name == thisCell.Name);
                if (checkCells.length > 0) swapCell = checkCells[0];
                // If unable to find the swap cell, skip it.
                if (swapCell == null) continue;
                let swapModel = model['Cell_' + swapCell.RangeName];
                // If the swap model wasn't found, skip it.
                if (swapModel == null) continue;

                // swapVal the type and value of the model value.
                let swapVal = determineValueAndType(swapModel);

                // If the values match (blank?) there's no reason to do a change.
                if (thisVal === swapVal) continue;
                if (swapVal == undefined) swapVal = '';

                // Add the swap value to the current row's column value.
                valueList.push({
                    RangeName: thisCell.RangeName,
                    ColValue: swapVal
                });

                // Add the current value to the swap row's column value.
                valueList.push({
                    RangeName: swapCell.RangeName,
                    ColValue: thisVal
                });

                // Update the local model
                let cValue = thisModel.cValue;
                let nValue = thisModel.nValue;
                let dValue = thisModel.dValue;
                thisModel.cValue = swapModel.cValue;
                thisModel.nValue = swapModel.nValue;
                thisModel.dValue = swapModel.dValue;
                swapModel.cValue = cValue;
                swapModel.nValue = nValue;
                swapModel.dValue = dValue;

                // Update the object that will set the grid internal data
                // Setting to '' if null so that values in grid clear. This
                // does not affect the data model values.
                thisRowData[thisCell.Name] = swapVal ?? '';
                thisRowData.length++;
                swapRowData[swapCell.Name] = thisVal ?? '';
                swapRowData.length++;
            }

            // Update the grid internal data.
            if (thisRowData.length > 0) myGrid.jqGrid('setRowData', row.toString(), thisRowData);
            if (swapRowData.length > 0) myGrid.jqGrid('setRowData', (row + 1).toString(), swapRowData);

            // Update values
            return new Promise((resolve, reject) => {
                $.ajax({
                    async: false,
                    url: window.URL["UpdateDataBatch"],
                    data: { list: valueList },
                    cache: false,
                    type: "POST",
                    dataType: "json",
                    success: function (data) {
                        if (!!data.Success) {
                            resolve();
                            return;
                        }

                        StaticAlert({ content: "Unable to change lines in grid." }).then(() => {
                            resolve();
                        });
                    },
                    error: function (a, b, c) {
                        StaticAlert({ content: "AJAX callback error, Reloading grid: " + a.responseText }).then(() => {
                            resolve();
                        });
                    }
                });
            }).then(() => {
                return gridLineReload(row, col, options);
            }).then(() => {
                window.GridLinePanel.Processing = false;
            });
        });
    }

    function gridLineInsertRow(min, max) {
        // Handle date picker, if necessary
        if ($("div.datepicker").length > 0) {                       // Is there is a datepicker?
            if (!$(".ui-datepicker").is(":hidden")) {               // If there is a datepicker, check if it is visible.
                $(".datepicker").remove();                            // Is visible; remove the date picker.
            }
        }

        // if already processing a grid line panel operation, prevent another one right now.
        if (window.GridLinePanel.Processing) return;
        // ensure that calculations and save operations are complete first.
        return window.CostReport.Selected.Flush().then(() => {

            window.GridLinePanel.Processing = true;

            if (!window.CostReport.CostReportEditable) {
                return StaticAlert({ content: "Cost report is locked." }).then(() => {
                    window.GridLinePanel.Processing = false;
                });
            }

            var selfGrid = document.getElementById("Grid");
            var row = selfGrid.EditingRow;
            var col = selfGrid.EditingCol;

            if (row == null || col == null) {
                return StaticAlert({ content: "No cell selected in grid." }).then(() => {
                    window.GridLinePanel.Processing = false;
                });
            }

            // Make sure the Grid is not in "edit" mode.
            $("#Grid").jqGrid("editCell", 0, 0, false);

            if (window.GridLineShiftBoundaries != null) {
                let temp = window.GridLineShiftBoundaries(row);
                if (temp != null) {
                    min = temp.min;
                    max = temp.max;
                }
            }

            var options = {
                action: @glAddRow, // Insert at current line and shift everything at or below it down 1
                row: row,
                min: min,
                max: max
            };

            // We need to insert a row based on the row, min, and max values
            // If out of bounds, we don't do anything.
            if (row < min || row >= max) {
                window.GridLinePanel.Processing = false;
                return;
            }

            // Update the data model, then use the jqGrid method to update the internal data in the grid
            // https://stackoverflow.com/questions/9145163/how-to-update-value-of-data-in-jqgrid

            // Get a quick reference for the grid cell array
            let cells = window.CostReport.Grid.defArray;

            // Get the current schedule data model for the values.
            let model = window.CostReport.Selected.GetCurrentModelSchedule();

            // Setup array for saving values back to server.
            let valueList = [];

            // Get reference of the HTML grid.
            let myGrid = $("#Grid");

            // Verify that there is at least one "blank" line in the remainder.
            let allowRow = -1;
            for (let i = row + 1; i <= max; i++) {
                let rowClear = true;
                let rowCells = cells.filter(d => d.DisplayLine == i);
                for (let c = 0; c < rowCells.length; c++) {
                    let thisCell = rowCells[c];

                    // If there is no range name, skip it.
                    if (thisCell.RangeName == null || thisCell.RangeName == '') continue;

                    // Get the model for this cell.
                    let thisModel = model['Cell_' + thisCell.RangeName];

                    // If this model was not found, skip it.
                    if (thisModel == null) continue;

                    // Determine the type and value of the model value.
                    let thisVal = determineValueAndType(thisModel);

                    // If there is a value, then this row is not clear.
                    // Note a '0' value counts as clear - because of totals.
                    if (!(thisVal == null || thisVal == '' || thisVal == '0')) {
                        rowClear = false;
                        break;
                    }
                }

                // If the row was clear, stop looking.
                if (rowClear) {
                    allowRow = i;
                    break;
                }
            }

            // If there is not a clear row, we can't do anything.
            if (allowRow == -1) {
                window.GridLinePanel.Processing = false;
                return;
            }

            // Shift all the rows after down one line until a blank line is reached.
            //debugger;
            for (let i = allowRow; i >= row; i--) {
                let rowCells = cells.filter(d => d.DisplayLine == i);
                let newRowData = {
                    length: 0
                };

                // If we are at the top row, simply clear out the data.
                if (i == row) {
                    // Loop through the columns
                    for (let c = 0; c < rowCells.length; c++) {
                        let thisCell = rowCells[c];

                        // If there is no range name, skip it.
                        if (thisCell.RangeName == null || thisCell.RangeName == '') continue;

                        // Get the model for this cell.
                        let thisModel = model['Cell_' + thisCell.RangeName] ?? null;

                        // If this model was not found, skip it.
                        if (thisModel == null) continue;

                        // Determine the type and value of the model value.
                        let thisVal = determineValueAndType(thisModel);

                        // If no value, no need to blank data.
                        if (thisVal === null || thisVal === '') continue;

                        // Blank out this row's data
                        valueList.push({
                            RangeName: thisCell.RangeName,
                            ColValue: ''
                        });

                        // Update the model
                        thisModel.cValue = null;
                        thisModel.nValue = null;
                        thisModel.dValue = null;

                        // Update the object that will set the grid internal data
                        newRowData[thisCell.Name] = '';
                        newRowData.length++;
                    }
                }
                // Set the current row's value to the previous row's values
                else {
                    // Get the next row
                    let nextCells = cells.filter(d => d.DisplayLine == i - 1);

                    // Loop through the columns
                    for (let c = 0; c < rowCells.length; c++) {
                        let thisCell = rowCells[c];

                        // If there is no range name, skip it.
                        if (thisCell.RangeName == null || thisCell.RangeName == '') continue;

                        // Get the model for this cell.
                        let thisModel = model['Cell_' + thisCell.RangeName];

                        // If this model was not found, skip it.
                        if (thisModel == null) continue;

                        // Determine the type and value of the model value.
                        let thisVal = determineValueAndType(thisModel);

                        // Assign the current row range name the next row value for the same column.
                        let nextCell = null;
                        let checkCells = nextCells.filter(d => d.Name == thisCell.Name);
                        if (checkCells.length > 0) nextCell = checkCells[0];
                        // If unable to find the next cell, skip it.
                        if (nextCell == null) continue;
                        let nextModel = model['Cell_' + nextCell.RangeName];
                        // If the next model wasn't found, skip it.
                        if (nextModel == null) continue;

                        // Determine the type and value of the model value.
                        let nextVal = determineValueAndType(nextModel);

                        // If the values match (blank?) there's no reason to do a change.
                        if (thisVal === nextVal) continue;
                        if (nextVal == undefined) nextVal = '';

                        // Add the value to the current row's column value.
                        valueList.push({
                            RangeName: thisCell.RangeName,
                            ColValue: nextVal
                        });

                        // Update the local model
                        thisModel.cValue = nextModel.cValue;
                        thisModel.nValue = nextModel.nValue;
                        thisModel.dValue = nextModel.dValue;

                        // Update the object that will set the grid internal data
                        // Setting to '' if null so that values in grid clear. This
                        // does not affect the data model values.
                        newRowData[thisCell.Name] = nextVal ?? '';
                        newRowData.length++;
                    }
                }

                //debugger;
                // Update the grid internal data.
                if (newRowData.length > 0) myGrid.jqGrid('setRowData', i.toString(), newRowData);
            }

            // Update values
            return new Promise((resolve, reject) => {
                $.ajax({
                    async: false,
                    url: window.URL["UpdateDataBatch"],
                    data: { list: valueList },
                    cache: false,
                    type: "POST",
                    dataType: "json",
                    success: function (data) {
                        if (!!data.Success) {
                            resolve();
                            return;
                        }

                        StaticAlert({ content: "Unable to change lines in grid." }).then(() => {
                            resolve();
                        });
                    },
                    error: function (a, b, c) {
                        StaticAlert({ content: "AJAX callback error, Reloading grid: " + a.responseText }).then(() => {
                            resolve();
                        });
                    }
                });
            }).then(() => {
                return gridLineReload(row, col, options);
            }).then(() => {
                window.GridLinePanel.Processing = false;
                myGrid.jqGrid('editCell', (row + 1), col, true);
            });
        });
    }

