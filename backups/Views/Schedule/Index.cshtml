    function colorEdits(rows) {
        for (let i = 0; i < rows.length; i++) {
            let status = $("#EditsGrid").getCell(rows[i], "Type");
            switch (status) {
                case "OCRT - ERROR":
                case "OCRT - REQUIRED":
                    // Described as "Red" per NFOFI-5195
                    $("#EditsGrid").jqGrid('setRowData', rows[i], false, { background: '#ffc0c0' });
                    break;
                case "OCRT - WARNING":
                case "REVIEW - WARNING":
                    // Described as "Blue" per NFOFI-5195
                    $("#EditsGrid").jqGrid('setRowData', rows[i], false, { background: '#b0e0e6' });
                    break;
                case "REVIEW - CRITICAL":
                case "REVIEW - ERROR":
                    // Described as "Yellow" per NFOFI-5195
                    $("#EditsGrid").jqGrid('setRowData', rows[i], false, { background: '#ffe0bf' });
                    break;
                case "OCRT - REVIEW / WARNING":
                    // Described as "Pale Green" per NFOFI-5195
                    // Changed to "tan" per NFOFI-5462
                    $("#EditsGrid").jqGrid('setRowData', rows[i], false, { background: '#fdf3c9' });
                    break;
                case "AUDIT - ERROR":
                    $("#EditsGrid").jqGrid('setRowData', rows[i], false, { background: '#D6E865' });
                    break;
                default:
                    break;
            }
        }
    }

    function formatType(cellvalue, options, rowObject) {
        //console.log(cellvalue);
        switch (cellvalue) {
            case 0:
            case "0":
                return "OCRT - ERROR";
            case 1:
            case "1":
                return "OCRT - REQUIRED";
            case 2:
            case "2":
                return "OCRT - WARNING";
            case 3:
            case "3":
                return "REVIEW - CRITICAL";
            case 4:
            case "4":
                return "REVIEW - ERROR";
            case 5:
            case "5":
                return "REVIEW - WARNING";
            case 6:
            case "6":
                return "OCRT - REVIEW / WARNING";
            case 7:
            case "7":
                return "AUDIT - ERROR"
            default:
            // code block
        }
    }

    function ArrayDropDown(ref, json, value) {
        //debugger;
        try {
            let list = $(ref);
            let option = list.find("option:selected");
            let selected = option.length > 0 ? option.value : value;

            list.empty();
            for (var i = 0; i < json.length; i++) {
                let item = json[i];
                list.append($("<option>").val(item).text(item));
            }

            if (typeof value != undefined && list.find("option[value='" + value + "']").length == 1) {
                list.val(value);
            } else if (typeof selected != undefined && list.find("option[value='" + selected + "']").length == 1) {
                list.val(selected);
            } else {
                list.val("");
            }
        }
        catch (e) {
            console.log("ArrayDropDown", e);
        }

        return true;
    };

