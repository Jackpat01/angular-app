    function refocusCell(rowid, cellName) {
        setTimeout(function () { openCellForEdit(rowid, cellName); }, 0);
    }


    function openCellForEdit(rowid, cellname, attempt) {
        attempt = attempt || 0; // Default attempt value to 0
        var iRow = $grid.jqGrid('getInd', rowid, true);

        // If the row doesn't exist or index is invalid
        if (!iRow) {
            if (attempt < 5) {
                // Retry up to 5 times with a small delay
                setTimeout(function () { openCellForEdit(rowid, cellname, attempt + 1); }, 50);
            }
            return;
        }

        // Get column model
        var cm = $grid.jqGrid('getGridParam', 'colModel');

        for (var i = 0; i < cm.length; i++) {
            if (cm[i].name === cellname) {
                // Trigger cell edit
                $grid.jqGrid('editCell', iRow.rowIndex, i, true);

                // Force focus on the input field in the cell
                setTimeout(function () {
                    // Try to locate the input field within the cell
                    var $cell = $grid.find('tr#' + rowid + ' td:eq(' + i + ')');
                    var $input = $cell.find('input, select, textarea'); // Support all input types

                    if ($input.length) {
                        // Focus and select the input field
                        $input.focus().select();
                    }
                }, 100); // Slight delay to ensure jqGrid renders the input
                return;
            }
        }
    }

