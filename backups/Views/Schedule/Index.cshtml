                    loadComplete: function (data) {
                        let gridCellDefArray;
                        new Promise((res, rej) => {
                            gridCellDefArray = evaluate(data.GridCellDefArray);
                            //console.log(gridCellDefArray);
                            res();
                        }).then(() => {
                            let row = null;
