    function updateCostReport() {
        LoadNotificationDialog('Updating Cost Report Data').then(() => {
            return new Promise((resolve, reject) => {
                $.ajax({
                    asnyc: true,
                    url: window.URL['UpdateCostReport'],
                    type: 'POST',
                    cache: false,
                    contentType: 'applicatopm/json;charset=utf-8',
                    success: function () {
                        $.ajax({
                            async: true,
                            url: window.URL['ReadValues'],
                            type: 'POST',
                            cache: false,
                            contentType: 'applicatopm/json;charset=utf-8',
                            success: function (result) {
                                const provDataRefNums = {
                                    providerName: 10010,
                                    nationalProvNum: 10830,
                                    medProvNum: 10020,
                                    cmsCertNum: 10030,
                                    add1: 10040,
                                    add2: 10050,
                                    city: 10060,
                                    zip: 10080,
                                    taxId: 10090,
                                    odhId: 10100,
                                    county: 10110,
                                    from: 10370,
                                    to: 10380
                                };

                                Object.keys(provDataRefNums).forEach(key => {
                                    let dataRefNum = provDataRefNums[key];
                                    let value = result.Index.find(x => x.RangeName == dataRefNum);
                                    if (dataRefNum == "10110") {
                                        $(`select[data-reference='${dataRefNum}']`).val(value.Value);
                                    }
                                    else {
                                        $(`input[data-reference='${dataRefNum}']`).val(value.Value);
                                    }
                                });
                            },
                            error: function (errormessage) {
                                StaticAlert({ content: errormessage.responseText });
                            }
                        })

                        resolve();
                    },
                    error: function (errorMessage) {
                        StaticAlert({ content: errorMessage.responseText || errorMessage }).then(() => {
                            resolve();
                        })
                    }
                });
            });
        }).then(() => {
            return ClearNotificationDialog();
        });
    }

