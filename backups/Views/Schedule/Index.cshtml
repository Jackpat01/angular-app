                        }
                    },
                    beforeEditCell: function (rowid, cellname, value, iRow, iCol) {
                        //debugger;
                        var row = iRow;
                        var col = iCol;
                        // Take note of the row and column for the cell (or TD element).
                        let cell = $(this).find("tr").eq(iRow).find("td").eq(iCol);
                        cell.attr("data-row", iRow)
                            .attr("data-col", iCol)
                            .attr("data-value", cell.html());
                        cell.off(".dropdown");

                        // Note: If the cell is supposed to have a drop-down list, the list might not be available
                        // right away, so we define a delegate function for when the list shows up an gains focus.
                        if (window.PopulateDropdown) {
                            cell.on("focus.dropdown", "select", function () {
                                let list = $(this);
                                let cell = list.parent();
                                //let row = cell.attr("data-row");
                                //let col = cell.attr("data-col");
                                let value = cell.attr("data-value");
                                window.PopulateDropdown(list, row, col, value);
