                                ondblClickRow: function (rowid) {
                                    // Handle double-click event
                                    //debugger;
                                    const rowData = $("#GotoGrid").jqGrid('getRowData', rowid);
                                    window.Pager.HandleSelectedValue(rowData.PageNumber);
                                }
                            });
                        }

                        else if (response.Message != null) {
                            $("#gotoSection").hide();

                            StaticAlert({ content: "AJAX callback error, Goto Listing: " + a.responseText }).then(() => {
                                resolve();  // need to actually do here instead of complete()
                            });
                        }

                        else {
                            resolve();
                        }
                    },
                    error: function (a, b, c) {
                        $("#gotoSection").hide();

                        StaticAlert({ content: "AJAX callback error, Goto Listing: " + a.responseText }).then(() => {
                            resolve();  // need to actually do here instead of complete()
                        });
                    }
                });
            }).then(() => {
                // close goto spinner.
                $('.gotoLoading').hide();
            });
        },
        HandleSelectedValue: function (rowData) {
            // Access the selected row data here
            window.Pager.Current = rowData;
            return window.Pager.LoadPage();
        }
     };

