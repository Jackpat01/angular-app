
@model  WebPortal_OH_FI.Models.ScheduleViewModel
@{
    int auditProviderCostReportId = 0;
    string auditCostReportTypeId = "";
    var loadTrialBalanceImportControls = false;
    var loadSchA1Controls = false;
    var loadAuditAdjustments = true;
    if (@Model.Schedule == "TrialBal")
    {
        loadTrialBalanceImportControls = true;
    }
    if (@Model.Schedule == "A-1")
    {
        loadSchA1Controls = true;
    }
    if (@Model.Schedule == "audit adjustments")
    {
        auditProviderCostReportId = ViewBag.ProviderCostReportId;
        auditCostReportTypeId = ViewBag.CostReportTypeId;
        loadAuditAdjustments = true;
    }

    var glShiftUp = (int)WebPortal_OH_FI.ProjectSpecific.Data.Models.crdata.GridLineAction.ShiftUp;
    var glShiftDown = (int)WebPortal_OH_FI.ProjectSpecific.Data.Models.crdata.GridLineAction.ShiftDown;
    var glAddRow = (int)WebPortal_OH_FI.ProjectSpecific.Data.Models.crdata.GridLineAction.AddRow;
    var glDelete = (int)WebPortal_OH_FI.ProjectSpecific.Data.Models.crdata.GridLineAction.DeleteRow;

    bool canCollapse = false;
    string gridHeight = "100%";
    if (!string.IsNullOrWhiteSpace(Model.Style))
    {
        Dictionary<string, string> style = Model.Style.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Split(':'))
            .Where(x => x.Length == 2)
            .ToDictionary(x => x[0], x => x[1]);

        KeyValuePair<string, string>? value;

        if (!string.IsNullOrWhiteSpace(Model.Instructions))
        {
            value = style
                .Where(x => x.Key == "collapse")
                .Select(x => (KeyValuePair<string, string>?)x).FirstOrDefault();
            if (value != null && value.HasValue)
            {
                canCollapse = value.Value.Value.Trim() == "true";
            }
        }

        value = style
            .Where(x => x.Key == "grid-height")
            .Select(x => (KeyValuePair<string, string>?)x).FirstOrDefault();
        if (value != null && value.HasValue)
        {
            gridHeight = value.Value.Value.Trim();
        }
    }

    bool isChangeButtonDisabled = !Model.CanEditCostReport;
    bool isEditAuditAdjustment = !Model.CanEditAuditAdjustment;

    bool isCollapsed = canCollapse && Model.Collapsed;

    bool hasScript = Model.Instructions != null && Model.Instructions.Contains("<script>");
    bool resetAfterContentLoaded = false;

    if (!string.IsNullOrWhiteSpace(Model.Instructions) && (!hasScript || !Model.Instructions.Contains("AfterLoadContent = function () {")))
    {
        // We need to add a script block to clear out AfterContentLoaded assignments.
        resetAfterContentLoaded = true;
    }
}
@if(Model.Schedule == "special narratives")
{
    Html.RenderAction("SpecialNarratives");
}
else if (Model.Schedule == "audit comments")
{
    Html.RenderAction("AuditComments");
}
else
{
    if (loadTrialBalanceImportControls)
    {
        <div id="window_ImportDocument" class="modal fade" role="dialog">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    @{
                        Html.RenderPartial("Import");
                    }
                </div>
            </div>
        </div>
        <div>
            <table style="width: 100%; float: right;">
                <tbody>
                    <tr>
                        <td align="right">
                            <button id="TrialBal_Clear" class="btn btn-success" disabled=@isChangeButtonDisabled>Clear</button>
                            <button id="TrialBal_Import" data-toggle="modal" data-target="#window_ImportDocument" data-backdrop="static" class="btn btn-success" disabled=@isChangeButtonDisabled>Import</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

    }

    if (loadSchA1Controls)
    {
        <div id="window_A1ImportDocument" class="modal fade" role="dialog">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    @{
                        Html.RenderPartial("SchA1Import", Model.IsAuditCostReport);
                    }
                </div>
            </div>
        </div>
    }
    <div id="ScheduleTitle">
        <table style="table-layout: fixed;float:right;">
            <tr>
                <td style="width:80%">
                    @if (loadSchA1Controls)
                    {
                        bool a1Buttons = isChangeButtonDisabled || Model.IsAuditCostReport;
                        <button id="SchA1_Clear" class="btn btn-success" disabled=@a1Buttons>Clear</button>
                        <button id="SchA1_Import" data-toggle="modal" data-target="#window_A1ImportDocument" data-backdrop="static" class="btn btn-success" disabled=@a1Buttons>Import</button>
                    }
                </td>
                <td id="collapseButtons" style="width:30%">
                    <button type="button" class="collapses" aria-label="Collapse"></button>
                    <button type="button" class="expands" aria-label="Expand"></button>
                </td>
            </tr>
        </table>
        @if (!string.IsNullOrWhiteSpace(Model.Title))
        {
            <h1>@Html.Raw(Model.Title)</h1>
        }
    </div>
}

<div id="ScheduleInstructions"><p>@Html.Raw(Model.Instructions)</p></div>
<div id="GridContainer"><table id="Grid"></table></div>

<!-- <div id="GridPager"></div> -->
@Html.Raw(Model.SummaryGridDiv)

<script>
    window.CostReport.Navigation.Main.IsAuditReport = @Json.Encode(Model.IsAuditCostReport);
    //let gridTitleText, gridNameDefArray, gridModelDefArray, gridCellDefArray, gridFacilityRevisionId, defArray = [];
    if (window.CostReport == null) window.CostReport = {};
    if (window.CostReport.Grid == null) window.CostReport.Grid = {};
    window.CostReport.Grid.defArray = [];
    //let scrollPosition, gridRowArray, lastCCAction = "", lastSelRowId = 0, lastSelRowIdPrev = 0, lastSelRowIdNext = 0, oldCellVal, newCellVal;
    window.CostReport.Grid.GroupHeaders = [];
    //let groupHeaders, editsGridDefData;
    window.CostReport.CostReportIsSubmitted =  @Json.Encode(Model.CostReportIsSubmitted);
    window.CostReport.CostReportLocked = @Json.Encode(!string.IsNullOrWhiteSpace(Model.LockedOn));
    window.CostReport.CostReportEditable = @Json.Encode(Model.CanEditCostReport);
    window.CostReport.DateMask = "mm/dd/yyyy";

    window.CostReportLocked = window.CostReport.CostReportIsSubmitted || window.CostReport.CostReportLocked || !window.CostReport.CostReportEditable;

    function refreshGridData() {
        return LoadNotificationDialog("Refreshing Grid...").then(() => {
            if (window.CostReport.Selected.LastSchedule == 'TrialBal') return window.CostReport.Selected.LoadModelTB();
            else return window.CostReport.Selected.LoadModelOCRT();
        }).then(() => {
            $("#Grid").trigger("reloadGrid");
            $("#Grid").click();
        }).then(() => {
            return ClearNotificationDialog();
        });
    };

    function getBedSizePopupWindow(tableName) {
        LoadNotificationDialog("Creating lookup...").then(() => {
            return new Promise((resolve, reject) => {
                $.ajax({
                    async: true,
                    url: "@Url.AbsoluteAction("GetCorpOfficeSalaryCeilingBedSize", "Schedule")",
                    type: "POST",
                    cache: false,
                    contentType: "application/json;charset=utf-8",
                    success: function (result) {
                        if (result.Success) {
                            var jsonData = JSON.parse(result.Data);
                    window.PopupWindow.CreateWindow(tableName, document.getElementById('contentPanel'), 500, 500, jsonData.Width, jsonData.Height).then(() => {
                        return window.PopupWindow.SetTitle(tableName, jsonData.Title);
                            }).then(() => {
                                return window.PopupWindow.SetHeaders(tableName, jsonData.Headers);
                            }).then(() => {
                                return window.PopupWindow.SetData(tableName, jsonData.Data);
                            });
                        }

                        resolve();
                    },
                    error: function (errormessage) {
                        StaticAlert({ content: errormessage.responseText || errormessage }).then(() => {
                            resolve();
                        });
                    }
                });
            });
        }).then(() => {
            return ClearNotificationDialog();
        });
    }


    function editsforcolumntwoAtt11(value, colname) {
        // Allow "I", "E", "i", "e", or "" (to allow removing the value).
        if (value == "I" || value == "E" || value == "i" || value == "e" || value == "") {
            return [true, ''];
        }
        else
            return [false, ': Input allowed should be "I" or "E" only'];
    }

    function TelephoneValidation(ref) {
        let reference = $(ref);
        let daterequested = $(reference).val();
        let telephoneRegex = /^(\([0-9]{3}\) |[0-9]{3}-)[0-9]{3}-[0-9]{4}$/;
        if (daterequested.length > 0 && !daterequested.match(telephoneRegex)) {
            //Reset the text box.
            StaticAlert({
                title: 'Invalid Telephone Entry',
                content: 'Invalid telephone entry value, use format `(123) 456-7890`. Your value may not be saved.'
            });
        }
    }

    function DateValidation(ref) {
        let reference = $(ref);
        let daterequested = $(reference).val();
        dateArray = daterequested.split("/");
        if (dateArray.length != 3) {
            $(reference).val('').datepicker('update');
            return;
        }
        if (dateArray[2].length == 1) {
            dateArray[2] = "0" + dateArray[2]
        }
        daterequested = dateArray[0] + "/" + dateArray[1] + "/" + dateArray[2];
        let dateMMDDYYYRegex = /^(0[1-9]|1[0-2]|\d)\/(0[1-9]|1\d|2\d|3[01]|\d)\/(((19|20)\d{2})|\d{2})$/;
        //let dateYYYYMMDDRegex = /^[1-9][0-9][0-9]{2}-([0][1-9]|[1][0-2])-([1-2][0-9]|[0][1-9]|[3][0-1])$/gm
        if (!daterequested.match(dateMMDDYYYRegex) || !isValidDate(daterequested)) {
            //console.log("invalid date")
            //To reset the datepicker and clear the selected date, pass an empty string with 'update'.
            $(reference).val('').datepicker('update');
        }
    }

    function isValidDate(s) {
        return Date.parse(s) != Math.NaN;
    }

    function formatShortDate(shortDate) {
        dateArray = shortDate.split("/");
        if (dateArray.length != 3) {
            return "";
        }
        if (dateArray[0].length < 2) {
            dateArray[0] = "0" + dateArray[0];
        }
        if (dateArray[1].length < 2) {
            dateArray[1] = "0" + dateArray[1];
        }
        if (dateArray[2].length == 1) {
            dateArray[2] = "0" + dateArray[2]
        }
        if (dateArray[2].length == 2) {
            if (Number(dateArray[2]) >= 70) {
                dateArray[2] = "19" + dateArray[2];
            }
            else {
                dateArray[2] = "20" + dateArray[2];
            }
        }

        return dateArray[0] + "/" + dateArray[1] + "/" + dateArray[2];
    }

    //#region Grid Formatters

    /// <summary>
    /// Method to check for and apply certain custom formatters depending on the formatter name
    ///     Types:
    ///     ProviderNumber - if "ProviderNumber" is in the formatter name, apply the formatting and return the formatted value.
    ///     PhoneNumber - if "PhoneNumber" is in the formatter name, apply the formatting and return the formatted value.
    /// </summary>
    /// <param name="col">jQuery INPUT entity reference.</param>
    /// <param name="value">The cell value</param>
    /// <param name="ref">The jqGrid cell reference.</param>
    /// <returns>string</returns>
    function applyCustomFormatter(col, value, ref) {
        if (col == null) return value;
        if (col.formatter == null) return value;
        if (col.formatter.name == null) return value;

        let c = col.formatter.name;
        if (c.indexOf("ProviderNumber") > -1) return col.formatter(value, null, ref);
        if (c.indexOf("PhoneNumber") > -1) return col.formatter(value, null, ref);
        if (c.indexOf("PostalCode") > -1) return col.formatter(value, null, ref);
        if (c.indexOf("Uppercase") > -1) return col.formatter(value, null, ref);
        if (c.indexOf("Uppercase") > -1) return col.formatter(value, null, ref);
        if (c.indexOf("Currency") > -1) return col.formatter(value, null, ref);
    }

    function formatterProviderNumberOH(cellvalue, options, rowobject) {
        if (cellvalue == "") return "";
        // pad with "0" characters to meet a lenth of 7.
        return "0".repeat(7 - cellvalue.length) + cellvalue;
    }

    function unformatterProviderNumberOH(cellvalue, options, rowobject) {
        if (cellvalue == "") return "";
        // pad with "0" characters to meet a lenth of 7.
        return "0".repeat(7 - cellvalue.length) + cellvalue;
    }

    function formatterCurrencyAccount(cellvalue, options, rowobject) {
        if (cellvalue === "") return "0";

        if (cellvalue.substring(0, 1) === "-") {
            // Negative numbers are wrapped in parenthesis.
            return "(" + Math.abs(cellvalue) + ")";
        } else {
            // Otherwise have a "$" at the front.
            return "$" + cellvalue;
        }
    }

    function unformatterCurrencyAccount(cellvalue, options, rowobject) {
        if (cellvalue === "") return "0";

        if (cellvalue.substring(0, 1) === "(") {
            // Handle turning the "(nnnn)" number to "nnnn".
            return "-" + cellvalue.substring(1, cellvalue.length - 2);
        } else {
            // remove the "$"
            return cellvalue.substring(1);
        }
    }

    function formatterFederalID(cellvalue, options, rowobject) {
        if (cellvalue === "") return "";
        let v = cellvalue.replace("-", "");
        if (v.length == 9) {
            let firstSplit = v.substring(0, 2);
            let secondSplit = v.substring(2);
            return firstSplit + "-" + secondSplit;
        }
        else {
            return cellvalue;
        }
    }

    function formatterPostalCodeUS(cellvalue, options, rowobject) {
        if (cellvalue === "") return "";
        return cellvalue.replace("-","").replace(/^(\d{5})(\d{4})$/g, '$1-$2');
    }

    function unformatterPostalCodeUS(cellvalue, options, rowobject) {
        return cellvalue;
    }

    function unformatterRemoveHyphen(cellvalue, options, rowobject) {
        if (cellvalue === "") return "";
        return cellvalue.replace("-", "");
    }

    function formatterCurrency(cellvalue, options, rowobject) {
        if (cellvalue === "") return "";
        return "$" + cellvalue;
    }

    function unformatterCurrency(cellvalue, options, rowobject) {
        if (cellvalue === "") return "";
        return cellvalue.replace("$", "");
    }

    function formatterPhoneNumberUSFull(cellvalue, options, rowobject) {
        if (cellvalue === "") return "";
        return unformatterPhoneNumberUSFull(cellvalue, null, null).replace(/^(\d{3})(\d{3})(\d{4})$/g, '($1) $2-$3');
   }

    function unformatterPhoneNumberUSFull(cellvalue, options, rowobject) {
        if (cellvalue === "") return "";
        return cellvalue.replaceAll("+1", "").match(/[0-9]/gm).join("");
    }

    function formatterPhoneNumberInternational(cellvalue, options, rowobject) {
        if (cellvalue === "") return "";
        return unformatterPhoneNumberInternational(cellvalue, null, null).replace(/^(\d{3})(\d{3})(\d{4})$/g, '($1) $2-$3');
    }

    function unformatterPhoneNumberInternational(cellvalue, options, rowobject) {
        if (cellvalue === "") return "";
        return cellvalue.replaceAll("+1", "").replace(/\(\)\-\s/g, "");
    }

    function formatterDateControl(cellvalue, options, rowobject) {
        if (cellvalue == null) return cellvalue;
        if (cellvalue == "") return cellvalue;
        let v = Date.parse(cellvalue);
        if (v != null) return v.toString("yyyy-MM-dd");
        return cellvalue;
    }

    function unformatterDateControl(cellvalue, options, rowobject) {
        if (cellvalue == null) return cellvalue;
        if (cellvalue == "") return cellvalue;
        let v = Date.parse(cellvalue);
        if (v != null) {
            if (v < Date.parse('1900-01-01')) return "";
            return v.toString("MM/dd/yyyy");
        }
        return "";
    }

    function formatterSSN(cellvalue, options, rowobject) {
        if (cellvalue === "") return "";
        let unformatted = unformatterSSN(cellvalue, null, null);
        if (unformatted.length != 9 && $(rowobject).prop('nodeName') === "INPUT") {
            StaticAlert({ content: "Invalid SSN entered. Verify appropriate number of characters were entered." }).then(() => {
                if (typeof rowobject != undefined && rowobject != null) {
                    $(rowobject).select();
                }
            });
            return cellvalue;
        }
        return unformatted.replace(/^(\d{3})(\d{2})(\d{4})$/g, '$1-$2-$3');
    }

    function unformatterSSN(cellvalue, options, rowobject) {
        if (cellvalue === "") return "";
        return cellvalue.match(/([^\-]+)/gm).join("");
    }

    function formatterUppercase(cellvalue, options, rowobject) {
        if (cellvalue === "") return "";
        return cellvalue.toUpperCase();
    }
    //#endregion

    window.LoadContent = function () {

        return LoadNotificationDialog("Loading Schedule...").then(() => {
            let a = [];
            // If there is no TB model, load it.
            if (window.CostReport.Selected.ModelTB == null) a.push(window.CostReport.Selected.LoadModelTB());

            // If there is no OCRT model, load it.
            if (window.CostReport.Selected.ModelOCRT == null) a.push(window.CostReport.Selected.LoadModelOCRT());

            // Ensure the correct script is loaded for the schedule.
            a.push(window.CostReport.InRuleCalculation.LoadScript("@Model.InRuleEngineURL"));

            // Wait until all of them are loaded.
            return Promise.all(a);
        }).then(() => {
            $("input:checkbox[data-show]").click(function () {
                let ref = $(this);
                let target = $(ref.attr("data-show"));
                if (ref.is(":checked"))
                    target.show();
                else
                    target.hide();
            });

            $("input:radio[data-show]").click(function () {
                $($(this).attr("data-show")).show();
            });

            $("input:radio[data-hide]").click(function () {
                // Ensure any values that should be cleared.
                $($(this).attr("data-clear")).each(function (item) {
                    console.log(this);
                    // Clear any check
                    $(this).prop("checked", false);
                    $(this).change();
                });

                // Tlear the values of hiding elements.
                $($(this).attr("data-hide")).val("");
                // Trigger change even on those elements.
                $($(this).attr("data-hide")).change();
                // Then hide those elements.
                $($(this).attr("data-hide")).hide();
            });

            $("input:radio[data-show]").each(function (index, element) {
                let ref = $(element);
                let target = $(ref.attr("data-show"));
                if (ref.is(":checked"))
                    target.show();
            });

            $("input:radio[data-hide]").each(function (index, element) {
                let ref = $(element);
                let target = $(ref.attr("data-hide"));
                if (ref.is(":checked"))
                    target.hide();
            });

            if ($("[data-reference]").length > 0) {
                let options = {};
                if (window.Pager.Reference.length > 0) {
                    options.mask = "%" + String.fromCharCode(64 + window.Pager.Current) + "_";
                }
                return LoadNotificationDialog("Loading Non-Grid Schedule Data...").then(() => {
                    return new Promise((resolve, reject) => {
                        $.ajax({
                            async: true,
                            url: "@Url.AbsoluteAction("ReadValues", "Schedule")",
                            data: options,
                            cache: false,
                            type: "POST",
                            dataType: "json",
                            success: function (results) {
                                if (!results) {
                                    return resolve();
                                }

                                if (!!results.Index) {
                                    $("input:text[data-reference]").val("");
                                    $("input[type='tel']").val("");
                                    $("select[data-reference]").val("");
                                    $("input:checkbox[data-reference]").prop("checked", false);
                                    $("input:radio[data-reference]").prop("checked", false);

                                    var control = null;
                                    // Update values of controls.
                                    for (let i = 0; i < results.Index.length; i++) {
                                        let item = results.Index[i];

                                        // Check text boxes
                                        control = $("input:text[data-reference='" + item.RangeName + "']");
                                        if (control.length > 0) {
                                            control.attr("data-type", item.DataType);
                                            control.val(item.Value);
                                        }

                                        // Check telephone specific text boxes
                                        control = $("input[type='tel'][data-reference='" + item.RangeName + "']");
                                        if (control.length > 0) {
                                            control.attr("data-type", item.DataType);
                                            control.val(item.Value);
                                        }

                                        // Check selection lists/dropdowns
                                        control = $("select[data-reference='" + item.RangeName + "']");
                                        if (control.length > 0) {
                                            control.attr("data-type", item.DataType);
                                            control.val(item.Value);
                                        }

                                        // Check checkboxes
                                        control = $("input:checkbox[data-reference='" + item.RangeName + "']");
                                        if (control.length > 0) {
                                            //debugger;
                                            control.attr("data-type", item.DataType);
                                            control.prop("checked", item.Value == 1);
                                        }

                                        // see if this is a checkbox that also makes another control group visible.
                                        control = $("input:checkbox[data-reference='" + item.RangeName + "'][data-show]");
                                        if (control.length > 0) {
                                            //debugger;
                                            control.each(function (index, element) {
                                                let ref = $(element);
                                                let target = $(ref.attr("data-show"));
                                            });
                                        }

                                        // Check radio button groups
                                        control = $("input:radio[data-reference='" + item.RangeName + "']").filter("[value='" + item.Value.replace(/'/g, "\\'") + "']");
                                        if (control.length > 0) {
                                            control.attr("data-type", item.DataType);
                                            control.attr("disabled", false);
                                            control.click();
                                            if (results.ViewOnly || window.CostReportLocked) control.attr("disabled", true);
                                        }
                                    }

                                    // Update for any edits that hit on this schedule
                                    $("[data-reference]").css("background-color", "");
                                    for (let i = 0; i < results.EditResult.length; i++) {
                                        let item = results.EditResult[i];
                                        // Ensure that text boxes are highlighted and have pop-over text.
                                        control = $("input:text[data-reference='" + item.DataReference + "']");
                                        if (control.length > 0) {
                                            control.css("background-color", item.Color);
                                            control.prop("title", item.Message);
                                        }
                                        // Ensure that telephone boxes are highlighted and have pop-over text.
                                        control = $("input[type='tel'][data-reference='" + item.DataReference + "']");
                                        if (control.length > 0) {
                                            control.css("background-color", item.Color);
                                            control.prop("title", item.Message);
                                        }
                                        // Ensure that date boxes are highlighted and have pop-over text.
                                        control = $("input[type='date'][data-reference='" + item.DataReference + "']");
                                        if (control.length > 0) {
                                            control.css("background-color", item.Color);
                                            control.prop("title", item.Message);
                                        }
                                        // Ensure that drop downs are highlighted and have pop-over text.
                                        control = $("select[data-reference='" + item.DataReference + "']");
                                        if (control.length > 0) {
                                            control.css("background-color", item.Color);
                                            control.prop("title", item.Message);
                                        }
                                        // Ensure that check boxes are highlighted and have pop-over text.
                                        control = $("input:checkbox[data-reference='" + item.DataReference + "']");
                                        parent = control.parent();
                                        if (control.length > 0) {
                                            control.prop("title", item.Message);
                                            parent.css("border", "6px solid " + item.Color);
                                            parent.css("padding", "0px");
                                        }
                                    }
                                }

                                if (!!results.Message && results.Message != "") {
                                    StaticAlert({ content: results.Message }).then(() => {
                                        resolve();
                                    });
                                }
                                else {
                                    resolve();
                                }
                            },
                            error: function (a, b, c) {
                                //debugger;
                                StaticAlert({ content: "An error occured while retrieving the cost report selection." }).then(() => {
                                    resolve();
                                });
                            }
                        });
                    }).then(() => {
                        $("input:text[data-reference], input:radio[data-reference]")
                            .off(".field")
                            .on("change.field", function (event) {
                                //debugger;
                                let ref = $(this);

                                let val = ref.val();
                                if (val === "NaN") {
                                    val = "";
                                }

                                let rangeName = ref.attr("data-rangename");
                                if (typeof rangeName === 'undefined' || rangeName === false) {
                                    rangeName = ref.attr("data-reference");
                                }

                                // handle formating of field-entered values.
                                let datatype = ref.attr("data-type");
                                if (datatype == null) datatype = ref.attr("datatype");
                                let orig = val;
                                if (datatype == 8) val = formatterSSN(val);
                                else if (datatype == 11) val = formatterPostalCodeUS(val);
                                else if (datatype == 13) val = formatterFederalID(val);
                                else if (datatype == 14) val = formatterPhoneNumberUS(val);

                                // If there was a change, update the control.
                                if (orig != val) ref.val(val);

                                let options = {
                                    rangeName: rangeName,
                                    colValue: val
