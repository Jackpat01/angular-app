                        $btn.text(currentText);
                        $btn.append('<span style="position:absolute;right:4px;top:9px;border:4px solid transparent;border-top-color:#666;"></span>');

                        var $list = $('<div style="display:none;position:absolute;top:24px;left:0;right:0;background:#fff;border:1px solid #999;z-index:99999;max-height:160px;overflow-y:auto;box-shadow:0 2px 6px rgba(0,0,0,0.2);color:#000;">');

                        // Placeholder option
