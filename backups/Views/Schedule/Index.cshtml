    function recalcLine2(pairId, newRatioValue, newAdjustmentValue) {
        //alert("hi");
        var pair = getRowsByPair(pairId);
        if (!pair.line1 || !pair.line2) return;
        if (isLine2Locked(pair.line1.data.WorkSheetName)) {
            $grid.jqGrid('setCell', pair.line2.id, 'ReportedOrAdjusted', ' ');
            $grid.jqGrid('setCell', pair.line2.id, 'Adjustment', ' ');
            $grid.jqGrid('setCell', pair.line2.id, 'Adjusted', ' ');
            return;
        }
        //alert(newRatioValue);
        var ratio;
        if (newRatioValue !== undefined && newRatioValue !== null && newRatioValue !== '') {
            ratio = parseFloat(newRatioValue) || 1.0000;
        }
        else {
            ratio = parseFloat(pair.line2.data.RatioAlloc) || 1.0000;
        }

        var l1Adjustment;
        if (newAdjustmentValue !== undefined && newAdjustmentValue !== null && newAdjustmentValue !== '') {
            l1Adjustment = parseInt(newAdjustmentValue, 10) || 0;
        }
        else {
            l1Adjustment = parseInt(pair.line1.data.Adjustment, 10) || 0;
        }

        var l1Reported = parseInt(pair.line1.data.ReportedOrAdjusted, 10) || 0;

        var l2Reported = Math.round(l1Reported * ratio);
        var l2Adjustment = Math.round(l1Adjustment * ratio);
        var l2Adjusted = l2Reported + l2Adjustment;

        $grid.jqGrid('setCell', pair.line2.id, 'ReportedOrAdjusted', l2Reported);
        $grid.jqGrid('setCell', pair.line2.id, 'Adjustment', l2Adjustment);
        $grid.jqGrid('setCell', pair.line2.id, 'Adjusted', l2Adjusted);
    }

