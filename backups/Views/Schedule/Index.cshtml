    function saveSpecialNarratives() {
        return new Promise((res, rej) => {
            // Validate required fields
            //specialNarrRefNum
            var desc = $('#txtSpecialNarrDesc').val().trim();
            if (!desc) {
                $('#txtSpecialNarrDesc').focus();
                StaticAlert({
                    title: 'Special Narrative Save Notification',
                    content: 'Please enter a description.',
                    callback: () => $('#txtSpecialNarrDesc').focus()
                });
                return;
            }

            var refNum = $('#specialNarrRefNum').val();
            $.ajax({
                url: '@Url.Action("SaveSpecialNarrative", "Schedule")',
                type: 'POST',
                data: { referenceNumber: pendingNarrative.refNum, description: desc },
                success: function () {
                    if (narrCheck.isInvalid) {
                        narrCheck.isInvalid = false;
                        narrCheck.iCol = null;
                        narrCheck.iRow = null;
                        narrCheck.rowId = null;
                        narrCheck.narrNumber = null;
                        narrCheck.cellname = null;
                    }
                    $("#specialNarrativeDialog").modal("hide");
                    res();
                },
                error: function (xhr) {
                    StaticAlert({
                        title: 'Special Narrative Save Notification',
                        content: 'Save failed'
                    });
                    res();
                }
            });
        });
   }

    // =====================================================================
    // Cell-saved cascade
    // =====================================================================
    function handleCellSaved(rowid, cellname, value) {
        var rowData = $grid.jqGrid('getRowData', rowid);
        var lineNo = parseInt(rowData.LineNo, 10);
        // Schedule E - AccountType -> Col mapping (Begin Period=1, End Period=2)
        if (lineNo === 1 && cellname === 'AccountTypeDisplay'
            && isScheduleE(rowData.WorkSheetName)) {
            var atype = parseInt(value, 10);
            //var col = (atype === 3) ? 1 : (atype === 4) ? 2 : '';
            var col = (atype === 3) ? 3 : (atype === 4) ? 4 : '';
            $grid.jqGrid('setCell', rowid, 'Col', col);
            if (col) fetchReported(rowid, rowData.AccNum, col, rowData.WorkSheetName);
            else {
                $grid.jqGrid('setCell', rowid, 'ReportedOrAdjusted', null);
                $grid.jqGrid('setCell', rowid, 'Adjusted', null);
            }
        }

        // Adjustment entered -> recalc Adjusted on Line 1, then Line 2
        if (lineNo === 1 && cellname === 'Adjustment') {
            var reported = parseInt(rowData.ReportedOrAdjusted, 10) || 0;
            var adj = parseInt(value, 10) || 0;
            $grid.jqGrid('setCell', rowid, 'Adjusted', (reported + adj));
            recalcLine2(rowData.AdjustmentPairId,"", value);
        }

        // Line 2 RatioAlloc edit -> recalc Line 2 amounts
        if (lineNo === 2 && cellname === 'RatioAlloc') {
            recalcLine2(rowData.AdjustmentPairId, value, "");
        }
    }

    // =====================================================================
    // Pair helpers
    // =====================================================================
    function getPairIdForRow(rowid) {
        return $grid.jqGrid('getCell', rowid, 'AdjustmentPairId');
    }

    function getRowsByPair(pairId) {
        //debugger;
        var ids = $grid.jqGrid('getDataIDs');
        var l1 = null, l2 = null;
        ids.forEach(function (id) {
            var r = $grid.jqGrid('getRowData', id);
            if (String(r.AdjustmentPairId) === String(pairId)) {
                if (parseInt(r.LineNo, 10) === 1) l1 = { id: id, data: r };
                else if (parseInt(r.LineNo, 10) === 2) l2 = { id: id, data: r };
            }
        });
        return { line1: l1, line2: l2 };
    }

    function propagateLine2(pairId, accNum, info) {
        var pair = getRowsByPair(pairId);
        if (!pair.line2) return;
        //alert(JSON.stringify(pair.line2));
        //$grid.jqGrid('setCell', pair.line2.id, 'AccNum', '');
        $grid.jqGrid('setCell', pair.line2.id, 'Narr2', info.line2Narr2);
        $grid.jqGrid('setCell', pair.line2.id, 'WorkSheetName', info.schedule);

        if (info.isScheduleE || info.isAttachment1) {
            // Line 2 stays disabled and largely blank
            $grid.jqGrid('setCell', pair.line2.id, 'Col', ' '); //info.isAttachment1 ? 4 : '');
            $grid.jqGrid('setCell', pair.line2.id, 'RatioAlloc', ' ');
            $grid.jqGrid('setCell', pair.line2.id, 'ReportedOrAdjusted', ' ');
