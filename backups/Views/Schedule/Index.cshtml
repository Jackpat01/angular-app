            beforeEditCell: function (rowid, cellname, value, iRow, iCol) {
                if (!isCellEditable(rowid, cellname)) {
                    setTimeout(function () {
                        const column = $('tr', $grid).eq(iRow).find('td').eq(iCol);
                        $(column).find('input').prop('disabled', true);
                    }, 0);
                } else {
                    //Enables Save/Cancel as soon as editing starts
                    setButtonStates('editing');

                    $grid.find('tr.jqgrow').removeClass('row-editing');
                    $grid.find('#' + $.jgrid.jqID(rowid)).addClass('row-editing');

                    if (cellname === 'AccountTypeDisplay') {
                        var rowData = $grid.jqGrid('getRowData', rowid);
                        var accNum = $.trim(rowData.AccNum || '');
                        var info = accountInfoCache[accNum];

                        var optStr = ':-- Select --';
                        if (info && info.accountTypeOptions && info.accountTypeOptions.length) {
                            for (var i = 0; i < info.accountTypeOptions.length; i++) {
                                var o = info.accountTypeOptions[i];
                                optStr += ';' + o.value + ':' + o.text;
                            }
                        }

                        if (cellname === 'AccountTypeDisplay') {
                            $grid.jqGrid('setColProp', 'AccountTypeDisplay', { editoptions: { value: optStr } });
