                                        break;
                                    case 38: // ARROW UP
                                    case 40: // ARROW DOWN
                                        // Handle date picker, if necessary
                                        if ($("div.datepicker").length > 0) {                       // Is there is a datepicker?
                                            if (!$(".ui-datepicker").is(":hidden")) {               // If there is a datepicker, check if it is visible.
                                                $(".datepicker").remove();                            // Is visible; hide the date picker.
                                            }
                                        }
                                        let rowDelta = keyCode === 38 ? -1 : 1;
                                        if (!selfGrid.grid.hDiv.loading) {
                                            let nextRow = iRow + rowDelta;

                                            while (nextRow >= 0 && nextRow <= rowCount) {
                                                let filteredArray = window.CostReport.Grid.defArray.filter(d => d.Name == 'Col' + (iCol + 1) && d.DisplayLine == nextRow);
                                                if (filteredArray.length > 0 && filteredArray[0].CanEdit) {
                                                    $self.jqGrid("editCell", nextRow, iCol, true);
                                                    break;
                                                }
                                                if (nextRow > 0 || nextRow < rowCount) {
                                                    nextRow = nextRow + rowDelta;
                                                }
                                                else
                                                    break;
                                            }
                                        }

                                        e.preventDefault();
                                        $self.jqGrid.handlingFlag = false;
                                        window.CostReport.InRuleCalculation.StartTimer();
                                        return false;
                                    case 39:    // ARROW RIGHT
                                        // Handle date picker, if necessary
                                        if ($("div.datepicker").length > 0) {                       // Is there is a datepicker?
                                            if (!$(".ui-datepicker").is(":hidden")) {               // If there is a datepicker, check if it is visible.
                                                $(".datepicker").remove();                            // Is visible; hide the date picker.
                                            }
                                        }
                                        if (e.target.selectionStart === e.target.value.length || e.target.type === "select-one") {
                                            if (!selfGrid.grid.hDiv.loading) {
                                                let nextColIndex = iCol + 1;
                                                let rowDelta = 1;

                                                while (nextColIndex >= -1 && nextColIndex <= colCount) {
                                                    let filteredArray = window.CostReport.Grid.defArray.filter(d => d.Name == 'Col' + (nextColIndex + 1) && d.DisplayLine == iRow);

                                                    if (filteredArray.length > 0 && filteredArray[0].CanEdit) {
                                                        $self.jqGrid("editCell", iRow, (nextColIndex), true);
                                                        break;
                                                    }

                                                    if (nextColIndex < 0 || nextColIndex > colCount - 1) {
                                                        iRow += rowDelta;

                                                        if (iRow <= 0 || iRow > rowCount) {
                                                            break;
                                                        }
                                                        nextColIndex = 0;
                                                    } else {
                                                        nextColIndex += 1;
                                                    }
                                                }
                                            }

                                            e.preventDefault();
                                            $self.jqGrid.handlingFlag = false;
                                            window.CostReport.InRuleCalculation.StartTimer();
                                            return false;
                                        }
                                        break;
                                }

                                $self.jqGrid.handlingFlag = false;
                            });

                        // get raw input html element
                        var rawInput = $("#" + this.id + " tbody>tr:eq(" + iRow + ")>td:eq(" + iCol + ") input");

                        //TODO: I hate this, but not able to determine why focus goes back to the keyboard
                        //      navigation DIV instead of the cell being edited. So, we have to force it. :(
                        //      This may have something to do with the "trick" to process keydown on non-input
