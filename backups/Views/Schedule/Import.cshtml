<div class="modal-header">
    <h3>Trial Balance Import</h3>
    <button href="#" class="close" data-dismiss="modal">&times;</button>
</div>
<div style="padding: 1rem;">
    <table style="width: 100%;">
        <colgroup>
            <col style="width: 8rem;" />
            <col />
        </colgroup>
        <tbody>
            <tr>
                <td>Import file:</td>
                <td>
                    <input type="file" name="Command" id="TrialBalance_File" value="Select" class="btn btn-default BoldMe" accept=".csv, .txt" aria-label="Import File" />
                    <span id="TrialBalance_Import" >
                        <button type="submit" name="Command" id="TrialBalance_Submit" value="New" class="btn btn-success BoldMe">Submit</button>
                        <button class="btn btn-success BoldMe" data-dismiss="modal">Close</button>
                    </span>
                    <img id="SubmitWait" src="~/Images/loading.GIF" alt="Loading" style="display: none;" width="32" height="32" />
                </td>
            </tr>
        </tbody>
    </table>
</div>
<div style="padding: 1rem;">
    <p id="res">The imported data was either updated or invalidated. Please reference the output results below.</p>
    <table id="editGrid"></table>
</div>
<script>
    $(document).ready(function () {
        var elem = document.getElementById("res");
        elem.style.display = "none";

        function createGrid(data) {
            return new Promise((resolve, reject) => {
                jQuery("#editGrid").jqGrid({
                    datatype: "local",
                    height: 250,
                    colNames: ['Account', 'Value', 'Reason'],
                    colModel: [
                        { name: 'Account', index: 'Account', width: 200, align: 'left' },
                        { name: 'Value', index: 'Value', width: 200, align: 'left' },
                        { name: 'Reason', index: 'Reason', width: 350, align: 'left' },
                    ]
                });

                // ensure grid is cleared before filling (again?) ;)
                jQuery("#editGrid").jqGrid("clearGridData");
                var mydata = data;
                if (!!mydata && !!mydata.length) {
                    for (var i = 0; i <= mydata.length; i++)
                        jQuery("#editGrid").jqGrid('addRowData', i + 1, mydata[i]);
                }
                resolve();
            });
        };

        $("#TrialBalance_Submit").click(function () {
            var success = false;
            var fileUpload = $("#TrialBalance_File").get(0);
            var files = fileUpload.files;

            // Checking whether FormData is available in browser
            if (files.length == 0 || window.FormData === undefined) {
                return false;
            }

            var fileData = new FormData();

            fileData.append(files[0].name, files[0]);

            return LoadNotificationDialog("Importing ...").then(() => {
                return new Promise((resolve, reject) => {
                    $.ajax({
                        async: true,
                        url: "@Url.AbsoluteAction("ImportTrialBalance", "Schedule")",
                        type: "POST",
                        contentType: false, // Not to set any content header
                        processData: false, // Not to process data
                        data: fileData,
                        cache: false,
                        dataType: "json",
                        success: function (results) {
                            //debugger;
                            if (!results) {
                                return resolve();   // need to actually do here instead of complete()
                            }

                            // For either result, we need to hide the error grid.
                            $("#window_ImportDocument").modal("hide");

                            // When Import is sucess. No Errors, No Error Data
                            if (!!results.Success && (!results.Data || results.Data.length == 0)) {
                                // Process the cross-document copies and calculations.
                                return window.CostReport.Selected.CalculateFullDocument("override").then(() => {
                                    return window.CostReport.Selected.Show();
                                }).then(() => {
                                    $('#GridSummary').trigger('reloadGrid');
                                    if (!!results.Message) {  
                                        return StaticAlert({ content: results.Message });
                                    }
                                }).then(() => {
                                    resolve();
                                });
                            }
                            // When Import Failed. With Errors, With Error Data
                            else if (!!results.Data && results.Data.length > 0) {
                                // Process the cross-document copies and calculations.
                                return window.CostReport.Selected.CalculateFullDocument("override").then(() => {
                                    return window.CostReport.Selected.Show();
                                }).then(() => {
                                    $("#window_ImportDocument").modal("show");
                                    elem.style.display = "block";
                                }).then(() => {
                                    return createGrid(results.Data);      
                                }).then(() => {
                                    $('#GridSummary').trigger('reloadGrid');
                                    if (!!results.Message) {
                                        return StaticAlert({ content: results.Message });
                                    }
                                }).then(() => {
                                    resolve();  // need to actually do here instead of complete()
                                });
                            }
                            else {
                                //debugger;
                                if (!!results.Message) {
                                    StaticAlert({ content: results.Message }).then(() => {
                                        resolve();
                                    });
                                }
                                else {
                                    resolve();  // need to actually do here instead of complete()
                                }
                            }
                        },
                        error: function (a, b, c) {
                            StaticAlert({ content: "An error occured in importing the trial balance." }).then(() => {
                                resolve();  // need to actually do here instead of complete()
                            });
                        }
                    });
                });
            }).then(() => {
                //debugger;
                return ClearNotificationDialog()
            });
        });
    });
</script>