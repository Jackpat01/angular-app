@*
    DO NOT MODIFY OUTSIDE OF MSLC.STATLOG
    This file comes from MSLC.Statlog, any changes to it will be wiped out when the nuget package is updated.
    Please make the appropriate enhancements to MSLC.Statlog instead of here.
*@

@Styles.Render("~/Content/StatLog.css")
@using MSLC.Portal.Configuration
@using MSLC.Portal.MVC.Utility
@using MSLC.StatLog.DTO
@model MSLC.StatLog.MVC.ViewModels.AuditTypeViewModel.View
@Html.Script("~/Scripts/Pages/AuditType/Index.js", "jquery")
@{
    Layout = PortalConfiguration.DetermineLayout("Menu");
    ViewBag.Title = PortalConfiguration.AuditTypeReplacementName + " Management";
}

<h2>@PortalConfiguration.AuditTypeReplacementName Management</h2>

<div id="dialogDiv" class="modal fade" tabindex="-1" aria-labelledby="windowTitleLabel" aria-hidden="true" role="dialog">
    <div id="modal-dialog" class="modal-dialog" role="document">
        <div id="dialogContent" style="font-size: 14px; width:100%"></div>
        <div id="dialogMessage" style="font-size: 14px; width:100%"></div>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <br />
    <br />
    <div class="errorLabel" style="text-align: center;">
        @Html.Raw(TempData["Message"].ToString())
    </div>
}
<div class="button-box">
    <a onclick="return modalButton(this, 'medium')" href="@Url.AbsoluteAction("Edit", "AuditType")" class="btn btn-kyBlue BoldMe">Add @PortalConfiguration.AuditTypeReplacementName</a>
</div>
@(Html.EJ().Grid<AdtTypeDTO>("tblAuditTypes")
    .Locale("en-US")
    .CssClass("mslcTable")
    .Datasource(Model.AuditTypes)
    .AllowPaging()
    .EnableRowHover(true)
    .AllowSelection(false)
    .AllowSorting(true)
    .AllowFiltering(true)
    .AllowTextWrap(true)
    .TextWrapSettings(wrap => { wrap.WrapMode(WrapMode.Both); })
    .FilterSettings(filter => { filter.FilterType(FilterType.Menu); filter.ShowPredicate(false); })

    .ToolbarSettings(toolbar =>
    {
        toolbar.ShowToolbar().ToolbarItems(items =>
        {
            items.AddTool(ToolBarItems.Search);
        });
    })
    .Columns(col =>
    {
        col.Template("#editStatLogEvents").HeaderText("Edit").CssClass("icon").TextAlign(TextAlign.Center).Width(10).Add();
        col.Field(at => at.AuditType).HeaderText("Type").TextAlign(TextAlign.Center).Width(30).Add();
        col.Field(at => at.Name).HeaderText("Name").TextAlign(TextAlign.Center).Width(30).Add();
        col.Field(at => at.InActive).HeaderText("Is Active").TextAlign(TextAlign.Center).DisplayAsCheckbox(false).Width(30).Add();

    })
    .ClientSideEvents(events =>
    {
        events.TemplateRefresh("loadIcons");
    }))
<script id="editStatLogEvents" type="text/x-template">
    <a onclick="return modalButton(this, 'medium')" href="@Url.AbsoluteAction("Edit", "AuditType")?pAuditType={{:AuditType}}">
        <i data-feather="edit" aria-label="Edit"></i>
    </a>
</script>