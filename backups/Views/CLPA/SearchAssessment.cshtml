@model WebPortal_OH_FI.Models.ViewModels.SearchAssessmentViewModel.View
@{
    Layout = "~/Views/Shared/_LayoutWithMenu.cshtml";
    ViewBag.Title = "View Assessments";
}

@using (Html.BeginForm("SearchAssessment", "CLPA", FormMethod.Post, new { id = "frmSubmit", enctype = "multipart/form-data" }))
{
    <div style="margin-left: auto; margin-right: auto; max-width: 1500px;">
        <center>
            <fieldset style="width: 100%;">

                <legend style="text-align: left;"><b>View Assessments</b></legend>
                <table style="width: 33%; max-width: 1000px;">
                    <tr>
                        <td style="width: 20%;">
                            <label for="txtSSN" style="font-weight:bold;">Enter SSN:</label>
                        </td>
                        <td style="width: 80%; padding-right: 20px;">
                            @Html.TextBoxFor(x => x.SSN, new { id = "txtSSN", maxlength = 12, @style = "width: 100%;" })
                        </td>
                    </tr>
                    <tr><td>&nbsp;</td></tr>
                    <tr>
                        <td colspan="6" align="center">
                            <div class="myControls">
                                <input id="btnSearch" value="Search" type="submit" class="btn btn-primary BoldMe" />&nbsp;&nbsp;
                                <a href="@Url.AbsoluteAction("SearchAssessment","CLPA")" target="_self" class="btn btn-danger BoldMe" style="text-decoration:none">Reset</a>
                            </div>
                        </td>
                    </tr>
                </table>
                <hr />
            </fieldset>

            @if (TempData["Message"] != null && !string.IsNullOrEmpty(TempData["Message"].ToString()))
            {
                <br />
                <br />
                <center>
                    <div class="errorLabel">
                        @Html.Raw(TempData["Message"].ToString())
                    </div>
                </center>
            }

            <div style="margin-top: 15px; width: 50%">
                @if (Model.mySearchResults != null)
                {
                    <div><h4>Assessments Found</h4></div>
                    <br />

                    @(Html.EJ().Grid<List<WebPortal_OH_FI.Models.ViewModels.SearchAssessmentViewModel.SearchAssessmentResults>>("tblSearchResults")
                        .CssClass("mslcTable")
                        .Datasource(Model.mySearchResults)
                        .Locale("en-US")
                        .EnableRowHover(true)
                        .AllowSelection(false)
                        .AllowSorting(false)
                        .AllowTextWrap(true)
                        .TextWrapSettings(wrap => { wrap.WrapMode(WrapMode.Both); })
                        .Columns(col =>
                        {
                            col.Field("AssessmentID").HeaderText("Assessment ID").TextAlign(TextAlign.Center).Width(25).Add();
                            col.Field("template.ReferenceDate").HeaderText("Assessment Reference Date").Type("date").Format("{0:MM/dd/yyyy}").TextAlign(TextAlign.Center).Width(25).Add();
                        })
                        .ClientSideEvents(events =>
                        {
                            events.TemplateRefresh("loadIcons");
                            events.Load("DateStrings");
                        }))
                }
            </div>
        </center>
    </div>
    <script type="text/javascript">
        function DateStrings(data) {
            // If the table data loaded/exists
            if (data && data.model) {
                // Edit raw json from dataSource
                const { dataSource } = data.model;
                if (dataSource) {
                    Object.keys(dataSource).forEach(rowID => {
                        const row = dataSource[rowID];
                        // Adding template field to the dataSource to load addresses properly.
                        row["template"] = {
                            "ReferenceDate": row.ReferenceDate ? moment(row.ReferenceDateString).format("MM/DD/YYYY") : "N/A"
                        }
                    });
                }
            }
        }
    </script>
}
