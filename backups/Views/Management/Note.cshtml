@model  WebPortal_OH_FI.Models.ManagementViewModel﻿
@{ 
    bool isChangeButtonDisabled = !Model.CanEditCostReport;
}

<div class="myControls">
    <div style="margin: .5rem 0; padding: 8px 0; background-color: #f1f1f1; border: solid #4e4c4c 1px; border-radius: .25rem; min-height: 2rem; overflow: hidden;">
        <div style="float: left; padding: 0 .5rem;">
            <button type="button" class="btn btn-success" data-toggle="modal" data-target="#window_AddNew" data-backdrop="static" onclick="clearTextBox();" disabled=@isChangeButtonDisabled>Add New Note</button><br /><br />
            <table class="table table-bordered table-hover" style="width: 100%">
                <colgroup>
                    <col span="1" style="width: 50%;">
                    <col span="1" style="width: 10%;">
                    <col span="1" style="width: 15%;">
                    <col span="1" style="width: 10%;">
                </colgroup>
                <thead>
                    <tr>
                        <th>
                            Notes
                        </th>
                        <th>
                            Date Updated
                        </th>
                        <th>
                            Updated By
                        </th>
                        <th>
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody class="tbody">
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="window_AddNew" class="modal fade" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3></h3>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <table style="width: 100%;">
                    <colgroup>
                        <col style="width: 5rem;" />
                        <col />
                    </colgroup>
                    <tbody>
                        <tr style="display: none;">
                            <td style="text-align: right; padding-right: .5rem;">Note Id:</td>
                            <td><input type="text" id="NoteId" style="width: inherit;" aria-label="Note ID" /></td>
                        </tr>
                        <tr>
                            <td style="text-align: right; padding-right: .5rem; font-weight:300">Notes:</td>
                            <td>
                                <textarea rows="8" cols="200" name="description" id="Notes" style="width:500px;" aria-label="Notes">
                            
                             </textarea>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="submit" name="Command" id="btnAdd" data-target="#window_AddNew" class="btn btn-success" onclick="return AddNote();">Add</button>
                <button type="submit" name="Command" id="btnUpdate" class="btn btn-success BoldMe" style="display:none;" onclick="UpdateNote();">Update</button>
                <button type="button" class="btn btn-success" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>
<script>
    //Load Notes when documents is ready
    $(document).ready(function () {
        loadData();
    });

    //Load Data based on ProviderCostReportId function
    function loadData() {
        let isDisabled = '@isChangeButtonDisabled';
        return new Promise((resolve, reject) => {
            $.ajax({
                url: "@Url.AbsoluteAction("GetNotes", "Management")",
                type: "GET",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                success: function (result) {
                    var html = '';
                    $.each(result, function (key, item) {
                        html += '<tr>';
                        html += '<td>' + item.Notes + '</td>';
                        html += '<td>' + DateConversion(item.UpdatedDate) + '</td>';
                        html += '<td>' + item.UpdatedBy + '</td>';
                        if (isDisabled === "True") {
                            html += '<td> Edit | Delete </td>';
                        }
                        else {
                            html += '<td><a href="#" onclick="return GetNote(\'' + item.NoteId + '\')">Edit</a> | <a href="#" onclick="DeleteNote(\'' + item.NoteId + '\')">Delete</a></td>';
                        }
                        html += '</tr>';
                    });
                    $('.tbody').html(html);

                    resolve();
                },
                error: function (errormessage) {
                    StaticAlert({ content: errormessage.responseText }).then(() => {
                        resolve(errormessage);
                    })
                }
            });
        });
    }

    //Add Data Function
    function AddNote() {
        var noteObj = {
            NoteId: $('#NoteId').val(),
            Notes: $('#Notes').val(),
        };
        return new Promise((resolve, reject) => {
            $.ajax({
                url: "@Url.AbsoluteAction("AddNote", "Management")",
                data: JSON.stringify(noteObj),
                type: "POST",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                success: function (result) {
                    loadData().then(() => {
                        $('#window_AddNew').modal('hide');
                        resolve();
                    });
                },
                error: function (errormessage) {
                    StaticAlert({ content: errormessage.responseText }).then(() => {
                        resolve(errormessage);
                    });
                }
            });
        });
    }

    //Edit Notes
    function GetNote(NoteId) {
        return new Promise((resolve, reject) => {
            $.ajax({
                url: "@Url.AbsoluteAction("GetNote", "Management")?noteId=" + NoteId,
                type: "GET",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                success: function (result) {
                    $("h3").text("Edit Note")
                    $('#NoteId').val(NoteId);
                    $('#Notes').val(result.Notes);

                    $('#window_AddNew').modal('show');
                    $('#btnUpdate').show();
                    $('#btnAdd').hide();

                    resolve();
                },
                error: function (errormessage) {
                    StaticAlert({ content: errormessage.responseText }).then(() => {
                        resolve();
                    });
                }
            });
        });
    }

    //function for updating record
    function UpdateNote() {
        var noteObj = {
            NoteId: $('#NoteId').val(),
            Notes: $('#Notes').val(),
        };
        return new Promise((resolve, reject) => {
            $.ajax({
                url: "@Url.AbsoluteAction("AddNote", "Management")",
                data: JSON.stringify(noteObj),
                type: "POST",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                success: function (result) {
                    loadData().then(() => {
                        $('#window_AddNew').modal('hide');
                        resolve();
                    });
                },
                error: function (errormessage) {
                    StaticAlert({ content: errormessage.responseText }).then(() => {
                        resolve();
                    });
                }
            });
        });
    }

    //function for deleting  record
    function DeleteNote(NoteId) {
        return StaticConfirm({
            title: "Delete Confirm",
            content: "Are you sure you want to delete this Note?",
            buttons: ["Ok", "Cancel"]
        }).then((key) => {
            if (key != 0) return;

            return LoadNotificationDialog("Deleting...").then(() => {
                return new Promise((resolve, reject) => {
                    $.ajax({
                        url: "@Url.AbsoluteAction("DeleteNote", "Management")?id=" + NoteId,
                        type: "POST",
                        contentType: "application/json;charset=UTF-8",
                        dataType: "json",
                        success: function (result) {
                            loadData();
                        },
                        error: function (errormessage) {
                            StaticAlert({ content: errormessage.responseText }).then(() => {
                                resolve();
                            });
                        }
                    });
                });
            }).then(() => {
                return ClearNotificationDialog();
            });
        });
    }

    //Function for clearing the textboxes
    function clearTextBox() {
        $("h3").text("Add New Note")
        $('#NoteId').val("");
        $('#Notes').val("");
        $('#btnUpdate').hide();
        $('#btnAdd').show();
    }

    function DateConversion(dateJS) {
        if (dateJS) {
            var jScriptDate = new Date(parseInt(dateJS.substr(6)));
            var date = new Date(Date.parse(jScriptDate.toLocaleDateString('en-US')));
            var fullDate = ((date.getMonth() + 1) + "/" + (date.getDate()) + "/" + date.getFullYear());
            return fullDate;
        }
        else {
            return "";
        }

    }

</script>