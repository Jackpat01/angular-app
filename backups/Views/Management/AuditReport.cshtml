@model  WebPortal_OH_FI.Models.ManagementViewModel﻿

<div data-resize='100' style='border: solid thin black; overflow: auto; padding: 1rem;'>
    <div style='width: 100%; font-weight: bold;'>
    </div>
    <span>Audit Report</span>
    <table>
        <tbody>
            <tr>
                <td>
                    <button style="margin-top: 10px;" id="GenerateAuditReport" class="btn btn-success">Generate Report</button>
                </td>
            </tr>
        </tbody>
    </table>
</div>
<script>
    $(function () {
        $('#GenerateAuditReport').on('click', () => {
            return LoadNotificationDialog("Generating Audit Report, please wait...").then(() => {
                return new Promise((resolve, reject) => {
                    $.ajax({
                        async: true,
                        url: "@Url.AbsoluteAction("GenerateAuditAdjustmentReport", "Management")",
                        data: { providerData: "Test" },
                        cache: false,
                        type: "POST",
                        dataType: "json",
                        success: function (response) {
                            if (response.Success) {
                                //get the file name for download
                                if (response.fileName != "") {
                                    //use window.location.href for redirect to download action for download the file
                                    window.location.href = "@Url.AbsoluteAction("Download", "Rate")/?fileName=" + response.fileName;
                                }

                                resolve();
                            }
                            else {
                                StaticAlert({ content: "Generating File Settlement to PDF: " + response.Message }).then(() => {
                                    resolve();
                                });
                            }
                        },
                        error: function (a, b, c) {
                            StaticAlert({ content: "AJAX callback error, Generating File Settlement to Excel: " + a.responseText }).then(() => {
                                resolve();
                            });
                        }
                    });
                });
            }).then(() => {
                return ClearNotificationDialog();
            });
        });
    });
</script>