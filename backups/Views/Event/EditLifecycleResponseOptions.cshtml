@*
    DO NOT MODIFY OUTSIDE OF MSLC.STATLOG
    This file comes from MSLC.Statlog, any changes to it will be wiped out when the nuget package is updated.
    Please make the appropriate enhancements to MSLC.Statlog instead of here.
*@

@using MSLC.StatLog.MVC.MVC
@using MSLC.StatLog.Configuration
@using MSLC.StatLog.Enumerations
@using MSLC.Portal.MVC.Utility
@using EnumHelper = MSLC.StatLog.Enumerations.EnumHelper
@model MSLC.StatLog.MVC.ViewModels.EventViewModel.Response
@{
    Layout = null;
}

<script src="~/Scripts/jquery.validate.js" type="text/javascript"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.js" type="text/javascript"></script>
<link href="~/Content/south-street/jquery-ui-1.9.2.custom.min.css" rel="stylesheet" />


<script src="~/Scripts/jHtmlArea-0.8.js" type="text/javascript"></script> @*Used for editing bulletin boards*@
<script src="~/Scripts/jHtmlArea.ColorPickerMenu-0.8.js" type="text/javascript"></script> @*Used for editing bulletin boards*@

<link href="~/Content/jHtmlArea/jHtmlArea.ColorPickerMenu.css" rel="stylesheet" type="text/css" />
<link href="~/Content/jHtmlArea/jHtmlArea.css" rel="stylesheet" type="text/css" />
<link href="~/Content/jHtmlArea/jHtmlArea.Editor.css" rel="stylesheet" type="text/css" />
@Html.Script("~/Scripts/Pages/Event/Edit.js", "jquery")
@using (Html.BeginForm("SaveLifecycleResponseOptions", "Event", FormMethod.Post, new { id = "frmSubmit", enctype = "multipart/form-data", @class = "modal-form", defaultbutton = "btnSave" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.sEventID)
    @Html.HiddenFor(m => m.LifeCycle)
    <div class="modal-content">
        <div class="modal-header">
            <h3 id="myModalLabel" style="text-align: left;">
                Edit Response Options
            </h3>
            <button href="#" class="close" data-dismiss="modal">&times;</button>
        </div>
        <div class="modal-body">
            <div>
                <div class="row m-2">
                    <div class="col-2">
                        <div>
                            @Html.CheckBoxFor(m => m.TriggerResponseDate, new { id = "chkfillResponse", @class = "fillResponseCheck", aria_label = "Fill Response" })
                            @Html.LabelFor(m => m.TriggerResponseDate, "Fill Response")
                            @Html.ValidationMessageFor(m => m.TriggerResponseDate)
                        </div>
                    </div>
                    <div class="col-9">
                        Fill the Response Date
                        @{
                            switch (Model.LifeCycle)
                            {
                                case LifeCycleEnum.DUE_DATE_HIT:
                                    <text> when the due date is hit.</text>
                                    break;
                                case LifeCycleEnum.DUE_DATE_REMINDER:
                                    <text> when the due date is approaching.</text>
                                    break;
                                case LifeCycleEnum.EVENT_ADDED:
                                    <text> when this event is added to the stat log.</text>
                                    break;
                                case LifeCycleEnum.FILE_UPLOADED:
                                    <text> when a file is uploaded to this event.</text>
                                    break;
                                case LifeCycleEnum.REVIEW_APPROVED:
                                    <text> when this event has a review approved.</text>
                                    break;
                                case LifeCycleEnum.REVIEW_REJECTED:
                                    <text> when this event has a review rejected.</text>
                                    break;
                                case LifeCycleEnum.REVIEW_RELEASED:
                                    <text> when the review on this event is released.</text>
                                    break;
                                case LifeCycleEnum.USER_ASSIGNED:
                                    <text> when a user is assigned to this event.</text>
                                    break;
                                case LifeCycleEnum.USER_REMOVED:
                                    <text> when a user is removed from this event. (When a new user is assigned, the old user is removed.)</text>
                                    break;
                            }}
                    </div>
                </div>
                <div class="row m-2">
                    <div class="col-2">
                        <div>
                            @Html.CheckBoxFor(m => m.ClearResponseDate, new { id = "chkClearResponse", @class = "clearResponseCheck", aria_label = "Response Check" })
                            @Html.LabelFor(m => m.ClearResponseDate, "Clear Response")
                            @Html.ValidationMessageFor(m => m.ClearResponseDate)
                        </div>
                    </div>
                    <div class="col-9">
                        Clear the Response Date
                        @{
                            switch (Model.LifeCycle)
                            {
                                case LifeCycleEnum.DUE_DATE_HIT:
                                    <text> when the due date is hit.</text>
                                    break;
                                case LifeCycleEnum.DUE_DATE_REMINDER:
                                    <text> when the due date is approaching.</text>
                                    break;
                                case LifeCycleEnum.EVENT_ADDED:
                                    <text> when this event is added to the stat log.</text>
                                    break;
                                case LifeCycleEnum.FILE_UPLOADED:
                                    <text> when a file is uploaded to this event.</text>
                                    break;
                                case LifeCycleEnum.REVIEW_APPROVED:
                                    <text> when this event has a review approved.</text>
                                    break;
                                case LifeCycleEnum.REVIEW_REJECTED:
                                    <text> when this event has a review rejected.</text>
                                    break;
                                case LifeCycleEnum.REVIEW_RELEASED:
                                    <text> when the review on this event is released.</text>
                                    break;
                                case LifeCycleEnum.USER_ASSIGNED:
                                    <text> when a user is assigned to this event.</text>
                                    break;
                                case LifeCycleEnum.USER_REMOVED:
                                    <text> when a user is removed from this event. (When a new user is assigned, the old user is removed.)</text>
                                    break;
                            }}
                    </div>
                </div>
                <div class="row m-2">
                    <div class="col-2">
                        <div>
                            @Html.CheckBoxFor(m => m.CascadeResponseDate, new { id = "chkCascadeResponse", @class = "cascadeResponseCheck", aria_label = "Cascade Response" })
                            @Html.LabelFor(m => m.CascadeResponseDate, "Populate Parent Response Dates")
                            @Html.ValidationMessageFor(m => m.CascadeResponseDate)
                        </div>
                    </div>
                    <div class="col-9">
                        When Response Date is changed, fill all parent events with new Response Date
                        @{
                            switch (Model.LifeCycle)
                            {
                                case LifeCycleEnum.DUE_DATE_HIT:
                                    <text> when the due date is hit.</text>
                                    break;
                                case LifeCycleEnum.DUE_DATE_REMINDER:
                                    <text> when the due date is approaching.</text>
                                    break;
                                case LifeCycleEnum.EVENT_ADDED:
                                    <text> when this event is added to the stat log.</text>
                                    break;
                                case LifeCycleEnum.FILE_UPLOADED:
                                    <text> when a file is uploaded to this event.</text>
                                    break;
                                case LifeCycleEnum.REVIEW_APPROVED:
                                    <text> when this event has a review approved.</text>
                                    break;
                                case LifeCycleEnum.REVIEW_REJECTED:
                                    <text> when this event has a review rejected.</text>
                                    break;
                                case LifeCycleEnum.REVIEW_RELEASED:
                                    <text> when the review on this event is released.</text>
                                    break;
                                case LifeCycleEnum.USER_ASSIGNED:
                                    <text> when a user is assigned to this event.</text>
                                    break;
                                case LifeCycleEnum.USER_REMOVED:
                                    <text> when a user is removed from this event. (When a new user is assigned, the old user is removed.)</text>
                                    break;
                            }}
                    </div>
                </div>
                <div class="row m-2">
                    <div class="col-2">
                        <div>
                            @Html.CheckBoxFor(m => m.CloseEventInstance, new { id = "chkCloseEvent", @class = "closeEventCheck", aria_label = "Close Event" })
                            @Html.LabelFor(m => m.CloseEventInstance, "Close Event")
                            @Html.ValidationMessageFor(m => m.CloseEventInstance)
                        </div>
                    </div>
                    <div class="col-9">
                        Close the event from uploading
                        @{
                            switch (Model.LifeCycle)
                            {
                                case LifeCycleEnum.DUE_DATE_HIT:
                                    <text> when the due date is hit.</text>
                                    break;
                                case LifeCycleEnum.DUE_DATE_REMINDER:
                                    <text> when the due date is approaching.</text>
                                    break;
                                case LifeCycleEnum.EVENT_ADDED:
                                    <text> when this event is added to the stat log.</text>
                                    break;
                                case LifeCycleEnum.FILE_UPLOADED:
                                    <text> when a file is uploaded to this event.</text>
                                    break;
                                case LifeCycleEnum.REVIEW_APPROVED:
                                    <text> when this event has a review approved.</text>
                                    break;
                                case LifeCycleEnum.REVIEW_REJECTED:
                                    <text> when this event has a review rejected.</text>
                                    break;
                                case LifeCycleEnum.REVIEW_RELEASED:
                                    <text> when the review on this event is released.</text>
                                    break;
                                case LifeCycleEnum.USER_ASSIGNED:
                                    <text> when a user is assigned to this event.</text>
                                    break;
                                case LifeCycleEnum.USER_REMOVED:
                                    <text> when a user is removed from this event. (When a new user is assigned, the old user is removed.)</text>
                                    break;
                            }}
                    </div>
                </div>
                <div class="row m-2">
                    <div class="col-2">
                        <div>
                            @Html.CheckBoxFor(m => m.OpenEventInstance, new { id = "chkOpenEvent", @class = "openEventCheck", aria_label = "Open Event" })
                            @Html.LabelFor(m => m.OpenEventInstance, "Open Event")
                            @Html.ValidationMessageFor(m => m.OpenEventInstance)
                        </div>
                    </div>
                    <div class="col-9">
                        Re-allow uploading for event
                        @{
                            switch (Model.LifeCycle)
                            {
                                case LifeCycleEnum.DUE_DATE_HIT:
                                    <text> when the due date is hit.</text>
                                    break;
                                case LifeCycleEnum.DUE_DATE_REMINDER:
                                    <text> when the due date is approaching.</text>
                                    break;
                                case LifeCycleEnum.EVENT_ADDED:
                                    <text> when this event is added to the stat log.</text>
                                    break;
                                case LifeCycleEnum.FILE_UPLOADED:
                                    <text> when a file is uploaded to this event.</text>
                                    break;
                                case LifeCycleEnum.REVIEW_APPROVED:
                                    <text> when this event has a review approved.</text>
                                    break;
                                case LifeCycleEnum.REVIEW_REJECTED:
                                    <text> when this event has a review rejected.</text>
                                    break;
                                case LifeCycleEnum.REVIEW_RELEASED:
                                    <text> when the review on this event is released.</text>
                                    break;
                                case LifeCycleEnum.USER_ASSIGNED:
                                    <text> when a user is assigned to this event.</text>
                                    break;
                                case LifeCycleEnum.USER_REMOVED:
                                    <text> when a user is removed from this event. (When a new user is assigned, the old user is removed.)</text>
                                    break;
                            }}
                    </div>
                </div>
            </div>
        </div>

        <div class="modal-footer mslcModalFooter" id="dvFooter" style="text-align: left !important;">
            <div class="myImage" style="display: none; text-align: center;">
                <img src="~/Images/loading.gif" alt="Loading" width="32" height="32" />
            </div>
            <div class="myControls">
                <button id="btnClose" class="btn btn-basic BoldMe" data-dismiss="modal" aria-hidden="true">Close</button>&nbsp;&nbsp;
                <button id="btnSave" type="submit" class="btn btn-success BoldMe" name="Command" value="Save">Save</button>
            </div>
        </div>
    </div>

    <script>
        $('.fillResponseCheck').each(function () {
            var checkID = "#" + this.id;
            fillResponseChange(checkID);
        });
        $('.clearResponseCheck').each(function () {
            var checkID = "#" + this.id;
            clearResponseChange(checkID);
        });
        $('.closeEventCheck').each(function () {
            var checkID = "#" + this.id;
            closeEventChange(checkID);
        });
        $('.openEventCheck').each(function () {
            var checkID = "#" + this.id;
            openEventChange(checkID);
        });
    </script>
}
