@*
	DO NOT MODIFY OUTSIDE OF MSLC.STATLOG
	This file comes from MSLC.Statlog, any changes to it will be wiped out when the nuget package is updated.
	Please make the appropriate enhancements to MSLC.Statlog instead of here.
*@

@using MSLC.Portal.Configuration
@using MSLC.Portal.MVC.Utility
@using MSLC.StatLog.Configuration
@Html.Script("~/Scripts/Pages/Event/EditFileOptions.js", "jquery")

@model MSLC.StatLog.MVC.ViewModels.EventViewModel.Files
@{
	Layout = null;
}

<script src="~/Scripts/jquery.validate.js" type="text/javascript"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.js" type="text/javascript"></script>
<link href="~/Content/south-street/jquery-ui-1.9.2.custom.min.css" rel="stylesheet" />

<div id="divGetFileExtensionsUrl" data-url="@Url.AbsoluteAction("GetFileTypeExtensions", "Event")"></div>
@using (Html.BeginForm("SaveFileOptions", "Event", FormMethod.Post, new { id = "frmSubmit", enctype = "multipart/form-data", @class = "modal-form", defaultbutton = "btnSave" }))
{
    @Html.AntiForgeryToken()
	@Html.HiddenFor(m => m.sEventID)
	<div class="modal-content">
		<div class="modal-header">
			<h3 id="myModalLabel" style="text-align: left;">
				Edit Event File Options
			</h3>
			<button href="#" class="close" data-dismiss="modal">&times;</button>
		</div>
		<div class="modal-body">
			<div class="d-flex flex-column">
                <div class="row m-2">
                    <div class="col-3">
                        @Html.CheckBoxFor(m => m.CanImport, new { id = "chkEnableAttachment" })
                        @Html.LabelFor(m => m.CanImport, "Enable Attachments")
                        @Html.ValidationMessageFor(m => m.CanImport)
                    </div>
                    <div class="col-8">
                        <label for="chkEnableAttachment">Enables the attachment of a file to the event. When checked, management staff can attach a file through the normal interface. It does not enable non-management staff to attach files unless also enabled under the web controls.</label>
                    </div>
                </div>
                @if (StatLogConfiguration.IsNAEnabled)
                {	
                    <div class="row m-2">
                        <div class="col-3">
                            @Html.CheckBoxFor(m => m.CanUseNA, new { id = "chkEnableNA" })
                            @Html.LabelFor(m => m.CanUseNA, "Enable N/A")
                            @Html.ValidationMessageFor(m => m.CanUseNA)
                        </div>
                        <div class="col-8">
                            <label for="chkEnableNA">Enables the use of N/A as an event to denote that a file upload is not required so that reports can make use of this also so that there is no misidentification.</label>
                        </div>
                    </div>
                }
				<div class="row m-2">
					<div class="col-3">
						@Html.LabelFor(m => m.ARUMFileType, "Attachment Type", new { @class = "pb-0" })
						@Html.ValidationMessageFor(m => m.ARUMFileType)
					</div>
                    <div class="col-8">
                        <label for="ddlARUMFileType">The file type to use on file attachments.</label>
                    </div>
                    <div class="col-3">
                        &nbsp;
                    </div>
					<div class="col-8">
						@Html.DropDownListFor(m => m.ARUMFileType, Model.SelectARUMFileTypes, new { id = "ddlARUMFileType", onchange = "RetrieveExtensions()" })
					</div>
				</div>
				<div class="row m-2">
					<div class="col-3">
						@Html.LabelFor(m => m.AllowedExtensions, "Extensions to accept", new { @class = "pb-0" })
						@Html.ValidationMessageFor(m => m.AllowedExtensions)
					</div>
                    <div class="col-8">
                        <label for="txtExtensions">The list of file extensions to only accept on file attachments. Use a comma to separate extensions.</label>
                    </div>
                    <div class="col-3">
                        &nbsp;
                    </div>
					<div class="col-8">
						@Html.TextBoxFor(m => m.AllowedExtensions, new { id = "txtExtensions", maxlength = 250, height = 100, @class = "w-100", disabled = true})
					</div>
				</div>
				<div class="m-2 row border-top pt-2">
					<div class="col-2 pl-4">
						@* @Html.LabelFor(m => m.AllowedExtensions, "Extensions to accept", new { @class = "pb-0" }) *@
						@* @Html.ValidationMessageFor(m => m.AllowedExtensions) *@
					</div>
					<div class="col-9">
						<div class="mb-1">
							This control limits the name of the file uploaded to this event. 
						</div>
						<div class="mb-1">
							If there are templates selected and the uploaded file name doesn't match one of given templates, it will reject the file.
						</div>
						<div class="mb-1">
							See the configured templates here:
							<a target='_self' href="@Url.AbsoluteAction("ManageFileNames", "Event")">Manage File Name Templates</a>
						</div>
					</div>
					<div class="col-11 py-2">
						@* @Html.TextBoxFor(m => m.AllowedExtensions, new { id = "txtExtensions", maxlength = 250, @class = "w-100", disabled = true }) *@
						<label for="SelectedFileNameTemplates_dropdown">File Name Templates</label>
						@(Html.EJ().Autocomplete("SelectedFileNameTemplates")
							.Datasource(Model.FileNameTemplates)
							.Value(Model.SelectedFileNameTemplates)
							.WatermarkText("Template Display Name")
							.Width("400px")
							.ShowPopupButton(true)
							.MultiSelectMode(MultiSelectModeTypes.VisualMode))
					</div>
				</div>
				@if (StatLogConfiguration.IsPHIControlsEnabled)
				{
					<hr class="m-0" />
					<div class="row m-2">
						<div class="col-3">
							@Html.CheckBoxFor(m => m.IsPHI)
							@Html.LabelFor(m => m.IsPHI, "May Contain PHI")
							@Html.ValidationMessageFor(m => m.IsPHI)
						</div>
                        <div class="col-8">
                            <ul>
                                <li>
                                    Select if the event has the potential for attaching files that contain PHI, either by management or non-management staff.
                                </li>
                                <li>
                                    Only users that have been granted PHI rights will be able to download the file contents. By default, management users have PHI rights.
                                </li>
                                <li>
                                    Non-management users that have rights to see the event and do not have PHI rights will see the event but will not be able to download the file.
                                </li>
                            </ul>
                        </div>
					</div>
				}
				else
				{
					@Html.HiddenFor(m => m.IsPHI)
				}
			</div>
		</div>

		<div class="modal-footer mslcModalFooter" id="dvFooter" style="text-align: left !important;">
			<div class="myImage" style="display: none; text-align: center;">
				<img src="~/Images/loading.gif" alt="Loading" width="32" height="32" />
			</div>
			<div class="myControls">
				<button id="btnClose" class="btn btn-basic BoldMe" data-dismiss="modal" aria-hidden="true">Close</button>&nbsp;&nbsp;
				<button id="btnSave" type="submit" class="btn btn-success BoldMe" name="Command" value="Save">Save</button>
			</div>
		</div>
	</div>
	
	<div id="SyncFusionScript">
		<script src="@Url.AbsoluteContent("~/Scripts/ej/common/ej.unobtrusive.min.js")"></script>
	</div>
    <script>
        RetrieveExtensions();
    </script>
}
