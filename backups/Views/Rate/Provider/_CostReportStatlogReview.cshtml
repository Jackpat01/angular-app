@*@model WebPortal_OH_FI.Models.ProviderCostReportStatlogViewModel*@
<div id="window_costReportReviewsSatlog" class="modal fade" data-backdrop="static" role="dialog">
    <div class="modal-dialog modal-lg" role="document" style="max-width:1200px">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Review Notes</h3>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
@*<div style="padding: 1rem;">*@
    <table style="width: 100%;">
        <colgroup>
            <col />
        </colgroup>
        <tbody>
            <tr>
                <td width="20%" nowrap align="right">
                    Review User ID:
                </td>
                <td width="80%" align="left">
                    <label id="lblUserId"></label>
                </td>
            </tr>
            <tr>
                <td width="20%" nowrap align="right">
                    Review Date:
                </td>
                <td width="80%" align="left">
                    <label id="lblEventDate"></label>
                </td>
            </tr>
            <tr>
                <td width="20%" valign="top" align="right">
                    Notes:
                </td>
                <td width="80%" align="left">
                    <textarea rows="10" cols="1" id="txtReviewNotes" style="width: 95% !important; text-align: left;"></textarea>
                </td>
            </tr>
            <tr>
                <td colspan="2" align="center">
                    <button class="btn btn-primary BoldMe" onclick="SaveReviewCostReportStatlog()" >Submit</button>
                    <button class="btn btn-primary BoldMe" onclick="ClearReviewCostReportStatlog()" >Clear</button>
                    <button class="btn btn-primary BoldMe" data-dismiss="modal" aria-hidden="true">Close</button>
                </td>
            </tr>
        </tbody>
    </table>
</div>
        </div>
    </div>
</div>
<script>
    var providerCostReportReviewId;
    $(document).ready(function () {
        let providerCostReportStatlogId = $("#hdnStatlogId").val();
        let providerCostReportId = $("#hdnCostReportId").val();
        LoadNotificationDialog("Loading").then(() => {
            return new Promise((resolve, reject) => {
                $.ajax({
                    async: true,
                    url: "@Url.AbsoluteAction("GetReviewCostReportStatlog", "Rate")",
                    data: JSON.stringify({
                        'providerCostReportStatlogId': providerCostReportStatlogId,
                        'costReportId': providerCostReportId
                    }),
                    type: "POST",
                    cache: false,
                    contentType: "application/json;charset=utf-8",
                    success: function (result) {
                        if (result.Success) {
                            providerCostReportReviewId = result.ProviderCostReportReviewViewModel.ProviderCostReportReviewId;
                            $("#lblEventDate").text(result.ProviderCostReportReviewViewModel.RevDate);
                            $("#lblUserId").text(result.ProviderCostReportReviewViewModel.RevUserId);
                            $("#txtReviewNotes").text(result.ProviderCostReportReviewViewModel.RevNotes);
                            resolve();
                        }
                    },
                    error: function (errormessage) {
                        alert(errormessage.responseText);
                        resolve();
                    }
                });
            });
        }).then(() => {
            return ClearNotificationDialog();
        });

    });

    function SaveReviewCostReportStatlog() {
        var providerCostReportReviewObj = {
            //ProviderCostReportReviewId: providerCostReportReviewId,
            ProviderCostReportStatlogId: $('#hdnStatlogId').val(),
            RevDate: $('#lblEventDate').val(),
            RevUserId: $('#lblUserId').val(),
            RevNotes: $('#txtReviewNotes').val()
        };
        //console.log(providerCostReportReviewId);
        LoadNotificationDialog("Saving...").then(() => {
            return new Promise((resolve, reject) => {
                $.ajax({
                    async: true,
                    url: "@Url.AbsoluteAction("SaveProviderCostReportReview", "Rate")",
                    data: JSON.stringify({
                        providerCostReportReviewId: providerCostReportReviewId, providerCostReportStatlogId: $('#hdnStatlogId').val(),
                        costReportId: $('#hdnCostReportId').val(),
                        RevNotes: $('#txtReviewNotes').val()}),
                    type: "POST",
                    cache: false,
                    contentType: "application/json;charset=utf-8",
                    success: function (result) {
						$("#window_costReportReviewsSatlog").modal('hide');
                        resolve();
                    },
                    error: function (errormessage) {
                        alert(errormessage.responseText);
                        resolve();
                    }
                });
            });
        }).then(() => {
            return ClearNotificationDialog();
        });
    }

    function ClearReviewCostReportStatlog() {
        $("#txtReviewNotes").text("");
    }
</script>