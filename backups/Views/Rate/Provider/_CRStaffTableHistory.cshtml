<style type="text/css">
    .e-grid .e-pager .e-pagercontainer {
        float: left;
    }

    .e-grid .e-pager .e-pager-itemsinterval {
        float: left;
    }
</style>

<div id="window_crstafftablehistory" class="modal fade" data-backdrop="static" role="dialog">
    ﻿
    <div class="modal-dialog modal-lg" role="document" style="max-width:1200px">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Cost Report Staff Table History</h3>
                <button type="button" class="close" data-dismiss="modal" onclick="closeStaffHistory()">&times;</button>
            </div>
            <div class="modal-body">
                <table style="width: 100%;">
                    <colgroup>
                        <col />
                    </colgroup>
                    <tbody>
                        <tr>
                            <td>
                                <div id="tblCRStaffTableHistory"></div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<script>
    $(document).ready(function () {
        LoadNotificationDialog("Loading").then(() => {
            return new Promise((resolve, reject) => {
                //debugger;
                let userId = $("#hdnUserId").val();
                $.ajax({
                    async: true,
                    url: "@Url.AbsoluteAction("GetCrStaffTableHistory", "Rate")",
                    data: JSON.stringify({ 'userId':userId }),
                    type: "POST",
                    cache: false,
                    contentType: "application/json;charset=utf-8",
                    success: function (result) {
                        if (result.Success) {
                            var cols = [];
                            //cols.push({ field: 'userid', headerText: 'PrimaryKeyID', isPrimaryKey: true, isIdentity: true, visible: false });
                            cols.push({ field: 'Action', headerText: 'Action' });
                            cols.push({ field: 'Mnemonic', headerText: 'UserType' });
                            cols.push({ field: 'FirstName', headerText: 'FirstName' }); //width: "130px"
                            cols.push({ field: 'LastName', headerText: 'LastName' });
                            cols.push({ field: 'LegacyStaffId', headerText: 'CR Staff Id' });
                            cols.push({ field: 'PhoneNumber', headerText: 'Phone Number' });
                            cols.push({ field: 'Email', headerText: 'Email' });
                            cols.push({ field: 'ActiveFlag', headerText: 'Active Flag' });
                            cols.push({ field: 'LastUpdateBy', headerText: 'LastUpdateBy' });
                            cols.push({ field: 'LastUpdatedOn', headerText: 'LastUpdatedOn' });

                            $("#tblCRStaffTableHistory").ejGrid({
                                dataSource: result.UsersHistoryViewModel,
                                columns: cols,
                                toolbarSettings: {
                                    showToolbar: false
                                },
                                pageSettings: { pageSize: 5, pageSizeList: [5, 10, 15, 20] },
                                allowPaging: true,
                                enableRowHover: false,
                                allowSelection: false,
                                allowSorting: true,
                                allowTextWrap: true,
                                editSettings: { allowEditing: false, allowAdding: false, allowDeleting: false, showDeleteConfirmDialog: false },

                            });

                            resolve();
                        }
                    },
                    error: function (errormessage) {
                        StaticAlert({ content: "CR Staff Table Error: " + errormessage.responseText }).then(() => {
                            resolve();
                        });
                    }
                });
            });

        }).then(() => {
            return ClearNotificationDialog();
        });
    });

    function closeStaffHistory() {
        LoadNotificationDialog("Closing Staff History...").then(() => {
            $("#window_crstafftablehistory").hide();
        }).then(() => {
            return ClearNotificationDialog();
        });
    }
</script>