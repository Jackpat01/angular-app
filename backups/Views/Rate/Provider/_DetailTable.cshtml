<h1>Detail Table</h1>
<center>
    <div id="detailTable"></div>
</center>
<input type="hidden" id="hdnDetailRecordId" />
<div id="divDetailTableHistory"></div>

<script id="detailTableHistory" type="text/x-template">
    <center>
        <a aria-label="History" data-toggle="modal" href="" data-target="#window_detailTableHistory" onclick="LoadDetailTableHistory('{{:RecordId}}')">
            <i data-feather='rotate-ccw' class='history-info'></i>
        </a>
    </center>
</script>

<div id="SyncFusionScript">
    <script src="@Url.AbsoluteContentUri("~/Scripts/ej/common/ej.unobtrusive.min.js")"></script>
</div>

<script>
    const detailGrid = '#detailTable';
    $(function () {
        //========== Logic that Fires when Page Loads ==========
        LoadNotificationDialog('Loading').then(() => {
            GetTableData().then((data) => {
                if (data.Data !== undefined)
                    RenderTable(data.Data);
            });
        }).then(() => ClearNotificationDialog());

        //========== Ajax Requests ==========
        function GetTableData() {
            return new Promise((resolve, reject) => {
                $.ajax({
                    async: true,
                    url: '@Url.AbsoluteAction("GetDetailNarratives", "Rate")',
                    contentType: "application/json;charset=utf-8",
                    type: 'POST',
                    cache: false,
                    success: function (result) {
                        if (result.Success) {
                            resolve(result);
                        }
                    },
                    error: function (errorMessage) {
                        StaticAlert({ content: `Detail Table Error: ${errorMessage.responseText}` }).then(() => {
                            resolve();
                        });
                    }
                })
            });
        }

        //========== Table Functionality ==========
        function RenderTable(data) {
            var cols = [];

            const createTextArea = function (args) {
                const textarea = document.createElement('textarea');
                textarea.class = 'e-field e-ejinputtext valid';
                textarea.style.width = '100%';
                textarea.style.height = '200px';
                return textarea;
            };
            const readTextArea = function (args) { return args.val(); };
            const writeTextArea = function (args) {
                $(args.element).val(args.rowdata["Description"]);
                $(args.element).addClass("ejinputtext");
            };

            for (const col of data.Columns) {
                let column = {
                    field: col.Field,
                    headerText: col.HeaderText,
                    isPrimaryKey: col.IsPrimaryKey,
                    isIdentity: col.IsIdentity,
                    visible: col.Visible,
                    textAlign: col.TextAlign,
                    allowEditing: col.AllowEditing,
                    allowFiltering: col.AllowFiltering,
                    allowSorting: col.AllowSorting,
                    width: col.Width,
                    template: col.Template
                }

                if (col.Field === 'NarrativeNumber') {
                    column.type = 'string';
                    column.validationRules = {
                        required: true,
                        maxlength: '7',
                        minlength: '1'
                    }
                } else if (col.Field === 'ReasonForChange') {
                    column.type = 'string';
                    column.validationRules = {
                        required: true
                    }
                } else if (col.Field === 'Description') {
                    column.editTemplate = {
                        create: createTextArea,
                        read: readTextArea,
                        write: writeTextArea
                    };
                    column.validationRules = {
                        required: true
                    }
                } else if (col.Field === 'RYBeginYear') {
                    column.validationRules = {
                        required: true,
                        maxlength: '4',
                        minlength: '4'
                    }
                } else if (col.Field === 'RYEndYear') {
                    column.validationRules = {
                        required: true,
                        maxlength: '4',
                        minlength: '4'
                    }
                }

                cols.push(column);
            }

            const editSettings = { allowEditing: data.CanEdit, allowAdding: data.CanEdit };
            const toolbarSettings = { showToolbar: true, toolbarItems: [ej.Grid.ToolBarItems.Search] };
            const pageSettings = { pageSize: 5, pageSizeList: [5, 10, 15, 20] };
            const textWrapSettings = { wrapMode: ej.Grid.WrapMode.Both };
            const filterSettings = { filterType: 'menu', showPredicate: false };

            if (data.CanEdit) {
                toolbarSettings.toolbarItems.push(ej.Grid.ToolBarItems.Add);
                toolbarSettings.toolbarItems.push(ej.Grid.ToolBarItems.Edit);
                toolbarSettings.toolbarItems.push(ej.Grid.ToolBarItems.Update);
                toolbarSettings.toolbarItems.push(ej.Grid.ToolBarItems.Cancel);
            }

            $(detailGrid).ejGrid({
                dataSource: data.Records,
                columns: cols,
                editSettings: editSettings,
                toolbarSettings: toolbarSettings,
                pageSettings: pageSettings,
                allowPaging: true,
                enableRowHover: false,
                allowSelection: true,
                allowSorting: true,
                allowTextWrap: true,
                allowFiltering: true,
                allowSearching: true,
                textWrapSettings: textWrapSettings,
                cssClass: 'mslcTable',
                locale: 'en-US',
                filterSettings: filterSettings,
                actionBegin: detailActionBegin,
                actionComplete: detailActionComplete,
                templateRefresh: loadIcons
            });
        }
    });

    //========== On Click Functions =========
    function LoadDetailTableHistory(recordId) {
        const historyDiv = '#divDetailTableHistory';

        $(historyDiv).empty();
        $('#hdnDetailRecordId').val(recordId);
        LoadNotificationDialog('Loading Detail Table History...').then(() => {
            return new Promise((resolve, reject) => {
                $.ajax({
                    url: '@Url.AbsoluteAction("LoadDetailTableHistory", "Rate")',
                    cahce: false,
                    type: 'GET',
                    success: function (result) {
                        $(historyDiv).html(result);
                        $('#window_detailTableHistory').modal('show');
                        resolve();
                    },
                    error: function (errormessage) {
                        StaticAlert({ content: `Detail Table History Error: ${errormessage.responseText}` })
                        .then(() => resolve());
                    }
                });
            });
        }).then(() => ClearNotificationDialog());
    }
</script>

@if(MSLC.Portal.MVC.Utility.RetrieveSession.CanAccessFeature("RateSetting:AuditDetail:Edit"))
{
    <script>
        //========== Ajax Requests ==========
        function SaveDetailRecord(data) {
            return new Promise((resolve, reject) => {
                $.ajax({
                    async: true,
                    url: '@Url.AbsoluteAction("SaveDetailNarrative", "Rate")',
                    data: JSON.stringify({ model: data }),
                    type: "POST",
                    contentType: "application/json;charset=utf-8",
                    success: function (result) {
                        if (result.Success) {
                            $(detailGrid).ejGrid('dataSource', result.Data);
                            resolve();
                        } else {
                            var message = result.Message;

                            if (message.includes("Invalid Narrative Number")) {
                                message = "Invalid Comment Number";
                            }
                            StaticAlert({ content: `Detail Table Error: ${message}` }).then(() => {
                                $(detailGrid).ejGrid('dataSource', result.Data);
                                resolve();
                            });
                        }
                    },
                    error: function (result) {
                        var message = result.Message;

                        if (message.includes("Invalid Narrative Number")) {
                            message = "Invalid Comment Number";
                        }
                        StaticAlert({ content: `Detail Table Error: ${message}` }).then(() => {
                            $(detailGrid).ejGrid('dataSource', result.Data);
                            resolve();
                        });
                    }
                });
            });
        }
        //========== Table Functionality ==========
        function detailActionBegin(args) {
            if (args.requestType === 'save')
                SaveDetailRecord(args.data);
            else if (args.requestType == 'add') {
                args.data.NarrativeType = 'D';
            }
        }

        function detailActionComplete(args) {
            if (args.requestType == 'beginedit' || args.requestType == 'add') {
                SetInputMaxes();
                PrepNumberEventListener();
            }
        }

        //===== Input Functionality =====
        function SetInputMaxes() {
            $('#detailTableNarrativeNumber').attr('maxLength', 3);
            $('#detailTableRYBeginYear').attr('maxLength', 4);
            $('#detailTableRYEndYear').attr('maxLength', 4);
        }

        function PrepNumberEventListener() {
            $('#detailTableNarrativeNumber').on('change', function () {
                const val = $(this)[0].value.trim();
                const matches = findRecordsForDetailNumber(val);
                if (matches.length > 0) {
                    $('#detailTableNarrativeType').val(matches[0].NarrativeType);
                    $('#detailTableNarrativeCode').val(matches[0].NarrativeCode);
                    $(this)[0].value = val; //Just in case user had whitespace
                } else {
                    StaticAlert({ content: 'Invalid Detail Number' })
                        .then(() => $(this)[0].value = '');
                }
            });
        }

        function findRecordsForDetailNumber(narrativeNumber) {
            const records = $(detailGrid).ejGrid('instance').model.dataSource;
            return records.filter(x => {
                return x.NarrativeNumber == narrativeNumber
                    && x.RecordId != null;
            }).sort(y => y.CYBeginDate);
        }
    </script>
}
else
{
    <script>
        //========== Table Functionality ==========
        function detailActionBegin() { }
        function detailActionComplete() { }
    </script>
}