@model WebPortal_OH_FI.Models.ProviderInfoViewModel
@*@{
    ViewBag.Title = "ProviderDetails";
    Layout = "~/Views/Shared/_LayoutWithMenu.cshtml";
}*@
<style type="text/css">
    .nav-tabs .nav-item.show .nav-link, .nav-tabs .nav-link.active {
        background: moccasin;
        border-bottom: 2px solid green;
    }

    .bold-every-other-column td:nth-of-type(2n+1) {
        font-weight: bold;
    }
</style>
<script>
    $(document).ready(function () {
        $("#providerSearchButton").on("click", function () {
            var gridObj = $("#tblProvider").ejGrid("instance");
            gridObj.clearSearching();
            GetProviders();
            $("#provider-grid").show();
            $("#provider-details").hide();
        });
    });
</script>
<div style='width: 100%; font-weight: bold;'>
    <div>
        <button class="btn btn-success" id="providerSearchButton">Back to Provider List</button>
    </div>
    <div>
        <h1>Provider - @Html.DisplayFor(model => model.ProviderName) - @Html.DisplayFor(model => model.NPINumber)</h1>
        <h4>Provider Details</h4>
    </div>
</div>
<div class="tab-panel m-2 p-2">
    <div class="nav nav-tabs m-0 d-flex fs-5" id="nav-tab" role="tablist">
        <div id="nav-general-tab" href="#nav-general" aria-controls="nav-general" class="nav-item nav-link active btn"
             data-toggle="tab" role="tab" aria-selected="true">General Information</div>
        <div id="nav-address-tab" href="#nav-address" aria-controls="address" class="nav-item nav-link btn"
             data-toggle="tab" role="tab" aria-selected="false">Addresses</div>
        <div id="nav-costReport-tab" href="#nav-costReport" aria-controls="due-costReport" class="nav-item nav-link btn"
             data-toggle="tab" role="tab" aria-selected="false">Cost Reports</div>
        @if (Model.CanViewRates)
        {
            <div id="nav-rates-tab" href="#nav-rates" aria-controls="other-rates" class="nav-item nav-link btn"
                 data-toggle="tab" role="tab" aria-selected="false">Rates</div>
        }
    </div>
    <div class="tab-content px-4 pb-4 pt-2" id="nav-tabContent">

        <div id="nav-general" aria-labelledby="nav-general-tab" role="tabpanel" class="tab-pane fade show active">
            @Html.Action("ProviderGeneralInformation", "Rate")
        </div>

        <div id="nav-address" aria-labelledby="nav-address-tab" role="tabpanel" class="tab-pane fade">
            @Html.Action("Address", "Rate")
        </div>

        <div id="nav-costReport" aria-labelledby="nav-costReport-tab" role="tabpanel" class="tab-pane fade">
            @Html.Action("ProviderCostReport", "Rate")
        </div>

        @if (Model.CanViewRates)
        {
            <div id="nav-rates" aria-labelledby="nav-rates-tab" role="tabpanel" class="tab-pane fade">
                @Html.Action("Rates", "Rate")

            </div>
        }
    </div>
</div>