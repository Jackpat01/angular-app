@model WebPortal_OH_FI.Models.ViewModels.ProviderRateComponentDataViewModel

<script>
    $(document).ready(function () {
        $("#reportButton").on("click", function () {
            $("#ratesetting-reports").show();
            $("#report-details").hide();
        });
    });
</script>
<div>
    <button class="btn btn-success" id="reportButton">Back to Reports</button>
</div>

    <table>
          <tr >
            <td colspan="2">Provider Rate Component Data Report</td>
        </tr>
        <tr>
            <td>SFY:</td>
            <td>
                @Html.DropDownListFor(model => model.SfyDate, (IEnumerable<SelectListItem>)Model.PeriodList, "Select SFY", new { ID = "reportSFYList", aria_label="SFY" })
            </td>
        </tr>
        <tr>
            <td>Month:</td>
        <td>@Html.DropDownListFor(model => model.RedDateSelect, (IEnumerable<SelectListItem>)Model.MonthList, "Select Month", new { ID = "drpMonthList", @style = "width: 130px", aria_label="Month" })</td>
        <tr>
            <td><input id="btnGenerateReport" value="Generate Report" type="submit" class="btn btn-success" onclick="GenerateRateComponentDataReport()"/></td>
        </tr>
    </table>

<script type="text/javascript">
    $(document).ready(function () {
        ClearNotificationDialog();

        $("#drpReportRedDateList").prop("disabled", true);
        $("#drpReportRateTypeList").prop("disabled", true);
        $("#btnGenerateReport").prop("disabled", true);


        $("#drpMonthList").change(function () {
            var val = $('#drpMonthList option:selected').text();
            if (val != "Select Month") {
               
                    $("#btnGenerateReport").prop("disabled", false);
                
            } else {
                    $("#btnGenerateReport").prop("disabled", true);
                }
        });

        $("#drpReportRateTypeList").change(function () {
            var val = $('#drpReportRateTypeList option:selected').text();
            if (val != "Rate Type List") {
                $("#btnGenerateReport").prop("disabled", false);
            } else {
                $("#btnGenerateReport").prop("disabled", true);
            }
        });

    });
    
    function GenerateRateComponentDataReport() {
        var yearVal = $('#reportSFYList option:selected').text();
        var monthName = $('#drpMonthList option:selected').text();
        
        return LoadNotificationDialog("Generating Report, please wait...").then(() => {
            return new Promise((resolve, reject) => {
                $.ajax({
                    async: true,
                    url: "@Url.AbsoluteAction("GenerateProviderRateComponentDataReport", "Rate")",
                    data: JSON.stringify({ sfYear: yearVal, monthName: monthName }),
                    cache: false,
                    type: "POST",
                    dataType: "json",
                    contentType: "application/json;charset=utf-8",
                    success: function (response) {
                        if (response.Success) {
                            //get the file name for download
                            if (response.FileName != "") {
                                //use window.location.href for redirect to download action for download the file
                                window.location.href = "@Url.AbsoluteAction("Download", "Rate")/?fileName=" + response.FileName;
                            }
                            //GetSelectedRed();
                        }
                        else {
                            StaticAlert({ content: "Generating Provider Rate Component Data Report: " + response.Message }).then(() => {
                                resolve();
                            });
                        }
                        resolve();
                    },
                    error: function (a, b, c) {
                        StaticAlert({ content: "AJAX callback error, Generating Provider Rate Component Data Report: " + a.responseText }).then(() => {
                            resolve();
                        });
                    }
                });
            });
        }).then(() => {
            return ClearNotificationDialog();
        });
    }
</script>
