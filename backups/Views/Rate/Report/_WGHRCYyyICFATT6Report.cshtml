@model WebPortal_OH_FI.Models.ViewModels.WGHRCYyyICFATT6ViewModel

<script>
    $(document).ready(function () {
        $("#reportButton").on("click", function () {
            $("#ratesetting-reports").show();
            $("#report-details").hide();
        });
    });
</script>
<div>
    <button class="btn btn-success" id="reportButton">Back to Reports</button>
</div>

<table>
    <tr>
        <td colspan="2">WGHRCYyyICF_ATT6 Report</td>
    </tr>
    <tr>
        <td>CY:</td>
        <td>
            @Html.DropDownListFor(model => model.Period.PeriodList, Model.Period.PeriodList, "Select CY", new { ID = "drpCYList", aria_label = "CY" })
        </td>
    </tr>
    <tr>
        <td>
            <input id="btnGenerateReport" value="Generate Report" type="submit" class="btn btn-success" onclick="GenerateReport()"/>
        </td>
    </tr>
</table>

<script type="text/javascript">
    $(document).ready(function () {
        ClearNotificationDialog();

//        $("#drpReportRedDateList").prop("disabled", true);
//        $("#drpReportRateTypeList").prop("disabled", true);
        $("#btnGenerateReport").prop("disabled", true);


        $("#drpCYList").change(function () {
            var val = $('#drpCYList option:selected').text();
            if (val != "Select CY") {

                    $("#btnGenerateReport").prop("disabled", false);

            } else {
                    $("#btnGenerateReport").prop("disabled", true);
                }
        });
    });

    function GenerateReport() {
        var cy = $('#drpCYList option:selected').text();

        return LoadNotificationDialog("Generating Report, please wait...").then(() => {
            return new Promise((resolve, reject) => {
                $.ajax({
                    async: true,
                    url: "@Url.AbsoluteAction("GenerateWGHRCYyyICFATT6Report", "Rate")",
                    data: JSON.stringify({ cy: cy }),
                    cache: false,
                    type: "POST",
                    dataType: "json",
                    contentType: "application/json;charset=utf-8",
                    success: function (response) {
                        if (response.Success) {
                            //get the file name for download
                            if (response.FileName != "") {
                                //use window.location.href for redirect to download action for download the file
                                window.location.href = "@Url.AbsoluteAction("Download", "Rate")/?fileName=" + response.FileName;
                            }
                            //GetSelectedRed();
                        }
                        else {
                            StaticAlert({ content: "Generating WGHRCYyyICF_ATT6 Report: " + response.Message }).then(() => {
                                resolve();
                            });
                        }
                        resolve();
                    },
                    error: function (a, b, c) {
                        StaticAlert({ content: "AJAX callback error, Generating WGHRCYyyICF_ATT6 Report: " + a.responseText }).then(() => {
                            resolve();
                        });
                    }
                });
            });
        }).then(() => {
            return ClearNotificationDialog();
        });
    }
</script>