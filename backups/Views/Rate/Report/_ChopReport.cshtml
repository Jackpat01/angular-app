@using Microsoft.Data.SqlClient
@using MSLC.Portal.MVC.Utility
@model WebPortal_OH_FI.Models.ViewModels.ChopReportViewModel


<style type="text/css">
    .nav-tabs .nav-item.show .nav-link, .nav-tabs .nav-link.active {
        background: moccasin;
        border-bottom: 2px solid green;
    }

    th, td {
        padding: 10px;
    }

    #startDate #endDatePicker {
        justify-items: left;
        width: 50%;
    }
</style>
<script>
    $(document).ready(function () {
        $("#reportButton").on("click", function () {
            $("#ratesetting-reports").show();
            $("#report-details").hide();
        });
    });
</script>
<div id="chopReport">
    <table>
        <tr>
            <td>
                <button class="btn btn-success" id="reportButton">Back to Reports</button>
            </td>
        </tr>
        <tr>
            <td>Chop Report</td>
        </tr>
        <tr id="DatesRow">
            <td style="margin: 4px 6px;">Date Range:</td>
            <td>
                <div>
                    @Html.TextBoxFor(x => x.StartDate, new { autocomplete = "off", @placeholder = "Start Date", id = "startDate", maxlength = 10, @class = "datefield", @style = "width: 150px;", aria_label="Start Date" })
                    <span style="margin: 4px 6px;">Through</span>
                    <span>@Html.TextBoxFor(x => x.EndDate, new { autocomplete = "off", @placeholder = "End Date", id = "endDate", maxlength = 10, @class = "datefield", @style = "width: 150px;", aria_label="End Date" })</span>
                </div>
            </td>
        </tr>
        <tr>Transaction Type:</tr>
        <tr>
            <td style="border: 0; justify-items: left;">
                @Html.DropDownListFor(model => model.SelectedTransactionType, (IEnumerable<SelectListItem>)Model.TransactionTypes, "Select Status",
                    new { ID = "transactionTypeList", @style = "width: 100%; margin: 0; padding: 5px;", aria_label="Transaction Type" })
            </td>
        </tr>
        <tr>
            <td><input id="btnGenerateReport" value="Generate Report" type="submit" class="btn btn-success" onclick="ProcessClosedFacilityReport()" /></td>
        </tr>
    </table>
</div>
<div id="SyncFusionScript">
    <script src="@Url.AbsoluteContent("~/Scripts/ej/common/ej.unobtrusive.min.js")"></script>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        ClearNotificationDialog();

        $("#btnGenerateReport").prop("disabled", true);

        $("#startDate").change(function () {
            setEnabled();
        });
        $("#endDate").change(function() {
            setEnabled();
        });
        $("#transactionTypeList").change(function() {
            setEnabled();
        });

        $('.datefield').datepicker(
            {
                format: 'mm/dd/yyyy',
                todayHighlight: true,
                autoclose: true
            });


        $('.datefield').datepicker(new Date(), {
        onClose: function () {
            $(this).valid();
        }

        });
        $("#startDate").val(undefined);
        $("#endDate").val(undefined);
    });

    function setEnabled() {
        if ($('#startDate').val() === 'Start Date' ||
            $('#startDate').val() === '' ||
            $('#endDate').val() === 'End Date' ||
            $('#endDate').val() === '' ||
            $('#transactionTypeList option:selected').text() === 'Select Status' ||
            $('#transactionTypeList option:selected').text() === '' ) {
            $('#btnGenerateReport').prop("disabled", true);
        }
        else {
            $('#btnGenerateReport').prop("disabled", false);
        }
    }

    function ProcessClosedFacilityReport() {
        var startDate = $("#startDate").val();
        var endDate = $("#endDate").val();
        var groupType = $('#transactionTypeList option:selected').val();
        return LoadNotificationDialog("Generating Chop Report...").then(() => {
            return new Promise((resolve, reject) => {
                    $.ajax({
                        async: true,
                        url: "@Url.AbsoluteAction("PrintChopReport", "Rate")",
                        data: JSON.stringify({ "startDate": startDate, "endDate": endDate, "groupType": groupType }),
                        type: "POST",
                        contentType: "application/json;charset=utf-8",
                        dataType: "json",
                        success: function(result) {
                            if (result.Success) {
                                //get the file name for download
                                if (result.FileName !== undefined) {
                                    //use window.location.href for redirect to download action for download the file
                                    window.location.href = "@Url.AbsoluteAction("Download", "Rate")/?fileName=" + result.FileName;
                                }
                            } else {
                                StaticAlert({ content: "The report failed to create. " + result.Message }).then(() => {
                                    resolve();
                                });
                            }

                            resolve();
                        },
                        error: function(result) {
                            if (result.Message === ' No data met the criteria for the report.') {
                                StaticAlert({ content: result.Message, title: "No Data Selected" }).then(() => {
                                    resolve();
                                });
                            }
                            StaticAlert({ content: result.Message }).then(() => {
                                resolve();
                            });
                        }
                },
                function error(result) {
                    StaticAlert({ content: result.Message }).then(() => {
                        resolve();
                    });
                });
            });
        }).then(() => {
            return ClearNotificationDialog();

        });


    }

</script>