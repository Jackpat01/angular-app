@using WebPortal_OH_FI.Web
@model WebPortal_OH_FI.Models.ViewModels.CostReportSummaryReportViewModel
<style type="text/css">
    .nav-tabs .nav-item.show .nav-link, .nav-tabs .nav-link.active {
        background: moccasin;
        border-bottom: 2px solid green;
    }

    th, td {
        padding: 10px;
    }

    .e-grid .e-pager .e-pagercontainer {
        float: left;
    }

    .e-grid .e-pager .e-pager-itemsinterval {
        float: left;
    }

    .e-pager-itemsinterval {
        direction: rtl;
        float: left;
    }
</style>
<script>
    $(document).ready(function () {
        $("#reportButton").on("click", function () {
            $("#ratesetting-reports").show();
            $("#report-details").hide();
        });
    });
</script>
<div>
    <button class="btn btn-success" id="reportButton">Back to Reports</button>
</div>
<div id="reportPanel">
    <table>
        <tr>
            <td>@Model.ReportName</td>
        </tr>
        <tr>
            <td>SFY:</td>
            <td>
                @Html.DropDownListFor(model => model.SfyDate, (IEnumerable<SelectListItem>)Model.PeriodList, "Select SFY", new { ID = "reportSFYList", aria_label="SFY" })
            </td>
        </tr>
        <tr>
            <td>Cost Report Type:</td>
            <td>@Html.DropDownListFor(model => model.CostReportType, (IEnumerable<SelectListItem>)Model.CostReportTypeList, "Select Cost Report Type", new { ID = "drpCostReportTypeList", @style = "width: 170px", aria_label="Cost Report Type" })</td>
        </tr>
        <tr>
            <td><input id="btnGenerateReport" value="Generate Report" type="submit" class="btn btn-success" onclick="GenerateDataReport()" /></td>
        </tr>
    </table>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        ClearNotificationDialog();

        // Disable report button - must have valid options to run.
        $("#btnGenerateReport").prop("disabled", true);
        // Hide the "Select SFY" text in the drop down list.
        $("#reportSFYList option[value='']").attr("hidden", true);
        // Hide the "Select Cost Report Type" text in the drop down list.
        $("#drpCostReportTypeList option[value='']").attr("hidden", true);

        $("#drpCostReportTypeList").change(function () {
            var valType = $('#drpCostReportTypeList option:selected').text();
            var valSfy = $('#reportSFYList option:selected').text();

            // If both drop downs are valid selection, enable the report button.
            if (valType != "Select Cost Report Type" && valSfy != "Select SFY") {
                $("#btnGenerateReport").prop("disabled", false);
            } else {
                $("#btnGenerateReport").prop("disabled", true);
            }
        });

        $("#reportSFYList").change(function () {
            $("#btnGenerateReport").prop("disabled", true);

            var valType = $('#drpCostReportTypeList option:selected').text();
            var valSfy = $('#reportSFYList option:selected').text();

            // If both drop downs are valid selection, enable the report button.
            if (valType != "Select Cost Report Type" && valSfy != "Select SFY") {
                $("#btnGenerateReport").prop("disabled", false);
            } else {
                $("#btnGenerateReport").prop("disabled", true);
            }
        });
    });

    function GenerateDataReport() {
        var valType = $('#drpCostReportTypeList option:selected').text();
        var valSfy = $('#reportSFYList option:selected').text();

        return LoadNotificationDialog("Generating @Model.ReportName Report, please wait...").then(() => {
            return new Promise((resolve, reject) => {
                $.ajax({
                    async: true,
                    url: "@Url.AbsoluteAction("GenerateCostReportSummaryReport", "Rate")",
                    data: JSON.stringify({ sfy: valSfy, crType: valType }),
                    cache: false,
                    type: "POST",
                    dataType: "json",
                    contentType: "application/json;charset=utf-8",
                    success: function (response) {
                        if (response.Success) {
                            //get the file name for download
                            if (response.fileName != "") {
                                //use window.location.href for redirect to download action for download the file
                                window.location.href = "@Url.AbsoluteAction("Download", "Rate")/?fileName=" + response.fileName;
                            }
                            //GetSelectedRed();
                        }
                        else {
                            StaticAlert({ content: "Generating @Model.ReportName Report: " + response.Message }).then(() => {
                                resolve();
                            });
                        }
                        resolve();
                    },
                    error: function (a, b, c) {
                        StaticAlert({ content: "AJAX callback error, Generating @Model.ReportName Report: " + a.responseText }).then(() => {
                            resolve();
                        });
                    }
                });
            });
        }).then(() => {
            return ClearNotificationDialog();
        });
    }
</script>