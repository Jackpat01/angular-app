<div id="report-details" style="display:none"></div>
<script>
    function ShowReportPage(reportName) {
        var url2 = "@Html.Raw(Url.AbsoluteAction("actionName", "Rate"))";
        url2 = url2.replace("actionName", reportName);
        LoadNotificationDialog("Loading...").then(() => {
            return new Promise((resolve, reject) => {
                $.ajax({
                    async: true,
                    url: url2,
                    cache: false,
                    contentType: "application/json;charset=utf-8",
                    success: function(result) {
                        $("#ratesetting-reports").hide();
                        $("#report-details").show();
                        $("#report-details").html(result);
                        resolve();
                    },
                    error: function(errormessage) {
                        StaticAlert({ content: "Report Error: " + errormessage.responseText }).then(() => {
                            resolve();
                        });
                    }
                });
            });
        }).then(() => {
            return ClearNotificationDialog();
        });
    }

    function GenerateActiveProviderDetailsReport() {
        return LoadNotificationDialog("Generate Active Provider Details Report, please wait...").then(() => {
            return new Promise((resolve, reject) => {
                $.ajax({
                    async: true,
                    url: "@Url.AbsoluteAction("GenerateActiveProviderDetailsReport", "Rate")",
                    cache: false,
                    type: "POST",
                    dataType: "json",
                    success: function (response) {
                        if (response.Success) {
                            //get the file name for download
                            if (response.fileName != "") {
                                //use window.location.href for redirect to download action for download the file
                                window.location.href = "@Url.AbsoluteAction("Download", "Rate")/?fileName=" + response.fileName;
                            }
                        }
                        else {
                            StaticAlert({ content: "Generate Active Provider Details Report: " + response.Message }).then(() => {
                                resolve();
                            });
                        }
                        resolve();
                    },
                    error: function (a, b, c) {
                        StaticAlert({ content: "AJAX callback error, Generate Active Provider Details Report: " + a.responseText }).then(() => {
                            resolve();
                        });
                    }
                });
            });
        }).then(() => {
            return ClearNotificationDialog();
        });
    }

