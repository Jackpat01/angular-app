@model WebPortal_OH_FI.Models.DatabaseLookupViewModel
@{
    string annualRateSettingEnum = Model.AnnualRateSettingEnum;
    string dateText=Model.DateText;
}

<style type="text/css">
    .e-grid .e-pager .e-pagercontainer {
        float: left;
    }

    .e-grid .e-pager .e-pager-itemsinterval {
        float: left;
    }
    .e-pager-itemsinterval {
        direction: rtl;
        float: left;
    }
</style>

<div id="window_ImportDocument" class="modal fade" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            @{
                Html.RenderPartial("AnnualRateSetting/_Import", null, new ViewDataDictionary { { "VariableName", annualRateSettingEnum } });
            }
        </div>
    </div>
</div>

<div style='width: 100%; font-weight: bold;'>
    <div><h1>@Model.HeaderText</h1></div>
</div>
<div>
    <table>
        <tr>
            <td>@dateText</td>
            <td>@Html.DropDownListFor(x => x.FiscalYear, (IEnumerable<SelectListItem>)Model.RedDateList, "Select " + dateText, new { ID = "drpRedDateList", @style = "width: 80%;", aria_label="RED Date" })</td>
            <td><input id="btnRemoveFYE" value="Remove @Model.DateText" onclick="RemoveFYE()" type="submit" class="btn btn-success" /></td>
            <td>@Html.TextBoxFor(x => x.RedDateYear, new { @placeholder = "Add New " + dateText, id = "txtREDDate", maxlength = 4, @oninput = "this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\\..*)\\./g, '$1');", @style = "width: 100px;", aria_label="Add New RED Date" })</td>
            <td><input id="btnAddFYE" value="ADD @Model.DateText" onclick="AddFYE()" type="submit" class="btn btn-success" /></td>
            <td><input id="btnImport" value="Import" data-toggle="modal" data-target="#window_ImportDocument" data-backdrop="static" type="submit" class="btn btn-success" /></td>
            <td><input id="btnExportExcel" value="Export" onclick="ExportExcel()" type="submit" class="btn btn-success" /></td>
        </tr>
    </table>
    <center>
        <div id="tblGrid">
            @(Html.EJ().Grid<object>("tblFRVCountyModifiers")
                        .CssClass("mslcTable")
                        .Datasource(ds => ds.Json(Model.DatabaseLookupGridViewModelList))
                        .AllowPaging()
                        .Locale("en-US")
                        .EnableRowHover(true)
                        .AllowSelection(true)
                        .AllowSorting(true)
                        .AllowFiltering(true)
                        .AllowTextWrap(true)
                        .TextWrapSettings(wrap => { wrap.WrapMode(WrapMode.Both); })
                        .FilterSettings(filter => { filter.FilterType(FilterType.Menu); filter.ShowPredicate(false); })
                        .PageSettings(p =>
                        {
                            p.PageSize(5);
                            p.PageSizeList(new List<int>
    () { 5, 10, 15, 20 });
                        })
    .TextWrapSettings(wrap => { wrap.WrapMode(WrapMode.Both); })
    .FilterSettings(filter =>
    {
        filter.FilterType(FilterType.Menu);
        filter.ShowPredicate(false);
    })
    .EditSettings(edit =>
    {
        edit.AllowEditing().EditMode(EditMode.Normal);
    })
    .ToolbarSettings(toolbar =>
    {
        toolbar.ShowToolbar().ToolbarItems(items =>
        {
            items.AddTool(ToolBarItems.Edit);
            items.AddTool(ToolBarItems.Update);
            items.AddTool(ToolBarItems.Cancel);
        });
    })
    .Columns(col =>
    {
        col.Field("DatabaseLookupVariableId").HeaderText("DatabaseLookupVariableId").IsPrimaryKey(true).Visible(false).TextAlign(TextAlign.Left).Width(25).Add();
        col.Field("Key").HeaderText("County").AllowEditing(false).TextAlign(TextAlign.Left).Width(25).Add();
        col.Field("Value").HeaderText("Modifier Mean").EditType(EditingType.NumericEdit).NumericEditOptions(new Syncfusion.JavaScript.Models.EditorProperties { DecimalPlaces = 2 } ).ValidationRules(v => v.AddRule("maxlength", 5)).TextAlign(TextAlign.Left).Width(25).Add();
    }).ClientSideEvents(events =>
    {
        events.ActionBegin("actionBegin");
    }))
        </div>
    </center>
</div>

<div id="SyncFusionScript">
    <script src="@Url.AbsoluteContentUri("~/Scripts/ej/common/ej.unobtrusive.min.js")"></script>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        var annualRateSettingEnum = @Html.Raw(Json.Encode(annualRateSettingEnum));
        $("#btnAddFYE").prop("disabled", true);
        $("#txtREDDate").val("");
        $('#tblFRVCountyModifiers').hide(); // Hide the grid
        var fiscalYearSelected = $('#drpRedDateList option:selected').text();
        $("#btnRemoveFYE").prop("disabled", fiscalYearSelected == "Select @Model.DateText");

        $("#txtREDDate").keyup(function () {
            var val = $('#txtREDDate').val();
            if (val != "") {
                $("#btnAddFYE").prop("disabled", false);
            } else {
                $("#btnAddFYE").prop("disabled", true);
            }
        });

        $("#drpRedDateList").change(function () {
            var fiscalYearSelected = $('#drpRedDateList option:selected').text();
            if (fiscalYearSelected != "Select @Model.DateText") {
                $("#btnRemoveFYE").prop("disabled", false);
                LoadNotificationDialog("Loading").then(() => {
                    return new Promise((resolve, reject) => {
                        $.ajax({
                            async: true,
                            url: "@Url.AbsoluteAction("GetDatabaseLookUpVariableInfo", "Rate")",
                            data: JSON.stringify({ annualRateSettingEnum: annualRateSettingEnum, "fiscalYear": fiscalYearSelected }),
                            type: "POST",
                            cache: false,
                            contentType: "application/json;charset=utf-8",
                            success: function (result) {
                                if (result.Success) {
                                    $("#tblFRVCountyModifiers").ejGrid("dataSource", result.DatabaseLookupViewModel.DatabaseLookupGridViewModelList);
                                    $("#tblFRVCountyModifiers").ejGrid({
                                        pageSettings: { currentPage: 1 },
                                    });
                                    $("#tblFRVCountyModifiers").show();
                                }
                                resolve();
                            },
                            error: function (errormessage) {
                                StaticAlert({ content: errormessage.responseText || errormessage }).then(() => {
                                    resolve();
                                });
                            }
                        });
                    });
                }).then(() => {
                    return ClearNotificationDialog();
                });
            }
            else {
                $('#tblFRVCountyModifiers').hide();
                $("#btnRemoveFYE").prop("disabled", true);
            }
        })
    })

    function actionBegin(args) {
        if (args.requestType == "save") {
            //Add or Update
            //********************** Local Store ************
            // Use Localstorage to save the grid's "CurrentPageIndex" to reset it after Postback.
            // Syncfusion Forum link for future reference:
            // --https://www.syncfusion.com/forums/144600/retain-last-selected-row-and-page-in-grid-after-postback--
            window.localStorage.removeItem("currentPageIndex");
            window.localStorage.setItem("currentPageIndex", args.model.pageSettings.currentPage);
            //********************** Local Store ************

            var fiscalYearSelected = $('#drpRedDateList option:selected').text();
            return new Promise((resolve, reject) => {
                $.ajax({
                    async: true,
                    url: "@Url.AbsoluteAction("SaveLookUpVariables", "Rate")",
                    data: JSON.stringify({ annualRateSettingEnum: @Html.Raw(Json.Encode(annualRateSettingEnum)), value: args.data, "fiscalYear": fiscalYearSelected }),
                    type: "POST",
                    contentType: "application/json;charset=utf-8",
                    dataType: "json",
                    success: function (response) {
                        if (!response.Success) {
                            window.localStorage.removeItem("currentPageIndex");
                            StaticAlert({ content: "Error Saving Data" }).then(() => {
                                resolve();
                            });
                        }
                        else {
                            //Re-bind Grid Data
                            var currentPageIndex = parseInt(window.localStorage.getItem("currentPageIndex"), 10);
                            $("#tblFRVCountyModifiers").ejGrid({
                                dataSource: response.DatabaseLookupViewModel.DatabaseLookupGridViewModelList
                            });
                            $("#tblFRVCountyModifiers").ejGrid({
                                pageSettings: { currentPage: currentPageIndex },
                            });

                            resolve();
                        }
                    },
                    error: function (errormessage) {
                        StaticAlert({ content: errormessage.responseText || errormessage }).then(() => {
                            resolve();
                        });
                    }
                });
            })
        }

        // need to return a promise here.
        return Promise.resolve();
    }

    function AddFYE() {
        var yearSelected = $('#txtREDDate').val();
        var annualRateSettingEnum = @Html.Raw(Json.Encode(annualRateSettingEnum));
        return LoadNotificationDialog("Saving...").then(() => {
            return new Promise((resolve, reject) => {
                $.ajax({
                    async: true,
                    url: "@Url.AbsoluteAction("AddFYE", "Rate")",
                    data: JSON.stringify({ annualRateSettingEnum: annualRateSettingEnum, "fiscalYear": yearSelected }),
                    type: "POST",
                    contentType: "application/json;charset=utf-8",
                    dataType: "json",
                    success: function (result) {
                        if (!result.Success) {
                            StaticAlert({ content: result.Message }).then(() => {
                                $("#txtREDDate").val("");
                                $("#btnAddFYE").prop("disabled", true);
                                $("#drpRedDateList option").filter(function () {
                                    return this.text == yearSelected;
                                }).attr('selected', true).trigger('change');

                                resolve();
                            });
                        }
                        else {
                            $("#txtREDDate").val("");
                            $("#btnAddFYE").prop("disabled", true);
                            var ddl = $('#drpRedDateList');
                            ddl.empty();
                            $(document.createElement('option'))
                                .attr('value', 'Select @Model.DateText')
                                .text('Select @Model.DateText')
                                .appendTo(ddl);

                            $(result.DatabaseLookupViewModel.RedDateList).each(function () {
                                $(document.createElement('option'))
                                    .attr('value', this.Value)
                                    .text(this.Text)
                                    .appendTo(ddl);
                            });

                            // Load Grid
                            $("#drpRedDateList option").filter(function () {
                                return this.text == yearSelected;
                            }).attr('selected', true).trigger('change');

                            resolve();
                        }
                    },
                    error: function (errormessage) {
                        StaticAlert({ content: errormessage.responseText || errormessage }).then(() => {
                            resolve();
                        });
                    }
                });
            });
        }).then(() => {
            return ClearNotificationDialog();
        });
    }

    function RemoveFYE() {
        return StaticConfirm({
            title: "Delete Confirm",
            content: "Are you sure you want to Delete?",
            buttons: ["Ok", "Cancel"]
        }).then((key) => {
            if (key != 0) return;

            var annualRateSettingEnum = @Html.Raw(Json.Encode(annualRateSettingEnum));
            var year = $('#drpRedDateList option:selected').text();
            return LoadNotificationDialog("Deleting...").then(() => {
                return new Promise((resolve, reject) => {
                    $.ajax({
                        async: true,
                        url: "@Url.AbsoluteAction("RemoveFYE", "Rate")",
                        data: JSON.stringify({ annualRateSettingEnum: annualRateSettingEnum, "year": year }),
                        type: "POST",
                        contentType: "application/json;charset=utf-8",
                        dataType: "json",
                        success: function (result) {
                            if (!result.Success) {
                                StaticAlert({ content: result.Message }).then(() => {
                                    resolve();
                                });
                            }
                            else {
                                $("#btnRemoveFYE").prop("disabled", true);
                                var ddl = $('#drpRedDateList');
                                ddl.empty();
                                $(document.createElement('option'))
                                    .attr('value', 'Select @Model.DateText')
                                    .text('Select @Model.DateText')
                                    .appendTo(ddl);
                                $(result.DatabaseLookupViewModel.RedDateList).each(function () {
                                    $(document.createElement('option'))
                                        .attr('value', this.Value)
                                        .text(this.Text)
                                        .appendTo(ddl);
                                });

                                $('#tblFRVCountyModifiers').hide(); // Hide the grid and set DD to default
                                $('select#drpRedDateList option:contains("Select @Model.DateText")').prop('selected', true);

                                resolve();
                            }
                        },
                        error: function (errormessage) {
                            StaticAlert({ content: errormessage.responseText }).then(() => {
                                resolve();
                            });
                        }
                    });
                });
            }).then(() => {
                return ClearNotificationDialog();
            });
        })

    }

    function ExportExcel() {
        var fiscalYear = $('#drpRedDateList option:selected').text();
        if (fiscalYear == 'Select @dateText' || fiscalYear == '' || fiscalYear == null) {
            StaticAlert({ content: "Please select a @dateText to generate the report." });
        }
        else {
            var annualRateSettingEnum = @Html.Raw(Json.Encode(annualRateSettingEnum));
            return LoadNotificationDialog("Generating Regional County Modifiers Report...").then(() => {
                return new Promise((resolve, reject) => {
                    $.ajax({
                        url: "@Url.AbsoluteAction("ExportFRVCountyModifiers", "Rate")",
                        data: JSON.stringify({ fiscalYear: fiscalYear, annualRateSettingEnum: annualRateSettingEnum }),
                        type: "POST",
                        contentType: "application/json;charset=utf-8",
                        dataType: "json",
                        success: function (result) {
                            if (result.Success) {
                                //get the file name for download
                                if (result.fileName != "") {
                                    //use window.location.href for redirect to download action for download the file
                                    window.location.href = "@Url.AbsoluteAction("Download", "Rate")/?fileName=" + result.fileName;
                                }
                                resolve();
                            }
                            else {
                                StaticAlert({ content: result.Message || "Unknown error" }).then(() => {
                                    resolve();
                                });
                            }
                        },
                        error: function (errormessage) {
                            StaticAlert({ content: errormessage.responseText || errormessage }).then(() => {
                                resolve();
                            });
                        }
                    });
                });
            }).then(() => {
                return ClearNotificationDialog();
            });
        }
    }
</script>