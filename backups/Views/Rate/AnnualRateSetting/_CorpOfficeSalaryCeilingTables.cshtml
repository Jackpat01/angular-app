﻿﻿@Styles.Render("~/Content/StatLog.css")
@using MSLC.StatLog.Configuration
@using MSLC.StatLog.MVC.MVC
@using MSLC.Portal.MVC.Utility
@using WebPortal_OH_FI.Controllers
@model WebPortal_OH_FI.Models.DatabaseLookupGroupViewModel

@{

    string annualRateSettingEnum = Model.AnnualRateSettingEnum;
    string dateText = Model.DateText;
}

<style type="text/css">
    .nav-tabs .nav-item.show .nav-link, .nav-tabs .nav-link.active {
        background: moccasin;
        border-bottom: 2px solid green;
    }

    th, td {
        padding: 10px;
    }

    .e-grid .e-pager .e-pagercontainer {
        float: left;
    }

    .e-grid .e-pager .e-pager-itemsinterval {
        float: left;
    }
    .e-pager-itemsinterval {
        direction: rtl;
        float: left;
    }
</style>
@{

    AjaxOptions options = new AjaxOptions();
    options.HttpMethod = "POST";

}

<div id="window_ImportDocument" class="modal fade" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            @{
                Html.RenderPartial("AnnualRateSetting/_ImportGroup", null, new ViewDataDictionary { { "VariableName", annualRateSettingEnum } });
            }
        </div>
    </div>
</div>

<div style='width: 100%; font-weight: bold;'> <div><h1>@Model.HeaderText</h1></div> </div>
<div>
    <table>
        <tr>
            <td>@dateText:</td>
            <td>@Html.DropDownListFor(x => x.LookupGroupFiscalYear, (IEnumerable<SelectListItem>)Model.LookupGroupFiscalYears, "Select " + Model.DateText, new { ID = "drpLookupGroupFiscalYears", @style = "width: 80%;", aria_label="Fiscal Year" })</td>
            <td><input id="btnRemoveLookupGroup" value="Remove @Model.DateText" onclick="DeleteLookupGroupFYEData()" type="submit" class="btn btn-success" /></td>
            <td>@Html.TextBoxFor(x => x.LookupGroupYear, new { @placeholder = "Add New " + Model.DateText, id = "txtLookupGroupDate", maxlength = 4, @oninput = "this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\\..*)\\./g, '$1');", @style = "width: 100px;", aria_label="Add New" })</td>
            <td><input id="btnAddLookupGroupDate" value="ADD @Model.DateText" onclick="SaveLookupGroupDate()" type="submit" class="btn btn-success" /></td>
            <td><input id="btnImport" value="Import" data-toggle="modal" data-target="#window_ImportDocument" data-backdrop="static" type="submit" class="btn btn-success" /></td>
            <td><input id="btnExportExcel" value="Export" onclick="ExportExcel()" type="submit" class="btn btn-success" /></td>
        </tr>
    </table>
    <center>
        <div id="tblLookupGroup"></div>
    </center>
</div>

<div id="SyncFusionScript">
    <script src="@Url.AbsoluteContent("~/Scripts/ej/common/ej.unobtrusive.min.js")"></script>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $("#btnAddLookupGroupDate").prop("disabled", true);
        $("#txtLookupGroupDate").val("");
        var fiscalYearSelected = $('#drpLookupGroupFiscalYears option:selected').text();
        $("#btnRemoveLookupGroup").prop("disabled", fiscalYearSelected == "Select @Model.DateText");
    })

    $("#txtLookupGroupDate").keyup(function () {
        var val = $('#txtLookupGroupDate').val();
        if (val != "") {
            $("#btnAddLookupGroupDate").prop("disabled", false);
        } else {
            $("#btnAddLookupGroupDate").prop("disabled", true);
        }
    });

    $("#drpLookupGroupFiscalYears").change(function () {
        var fiscalYearSelected = $('#drpLookupGroupFiscalYears option:selected').text();
        //console.log(fiscalYearSelected);
        var annualRateSettingEnum = @Html.Raw(Json.Encode(annualRateSettingEnum));
        if (fiscalYearSelected != "Select @Model.DateText") {
            $("#btnRemoveLookupGroup").prop("disabled", false);
            LoadNotificationDialog("Loading Group").then(() => {
                return new Promise((resolve, reject) => {
                    $.ajax({
                        async: true,
                        url: "@Url.AbsoluteAction("GetDatabaseLookupGroup", "Rate")",
                        data: JSON.stringify({ "lookUpGroupDate": fiscalYearSelected, annualRateSettingEnum: annualRateSettingEnum }),
                        type: "POST",
                        cache: false,
                        contentType: "application/json;charset=utf-8",
                        success: function (result) {
                            if (!result.Success) return resolve();

                            var cols = [];
                            var col_width = 150;
                            cols.push({ field: 'PrimaryKeyID', headerText: 'PrimaryKeyID', isPrimaryKey: true, isIdentity: true, visible: false });
                            cols.push({ field: 'DatabaseLookupGroupYearId', headerText: 'DatabaseLookupGroupYearId', visible: false });
                            cols.push({ field: 'ValueType', headerText: 'ValueType', visible: false });
                            for (var col = 0; col < result.LookupGroupViewModel.GridColumns.length; col++) {
                                var propName = result.LookupGroupViewModel.GridColumns[col].Field;

                                // Build "Columns" and "Header Text"
                                var column = {
                                    field: result.LookupGroupViewModel.GridColumns[col].Field,
                                    headerText: result.LookupGroupViewModel.GridColumns[col].HeaderText,
                                    visible: result.LookupGroupViewModel.GridColumns[col].Visible,
                                    type: result.LookupGroupViewModel.GridColumns[col].Type,
                                    validationRules: {
                                        required: true
                                    }
                                };

                                if (propName == 'ClassificationTitle') {
                                    column.width = 200;
                                }
                                else if (propName == 'BedSizeMin') {
                                    column.width = 150;
                                    column.editType = 'numericedit';
                                    column.edit = {
                                        validateDecimalOnType: true,
                                        decimals: 0,
                                        format: "N"
                                    }
                                }
                                else if (propName == 'PositionNum') {
                                    column.width = 160;
                                    column.validationRules = {
                                        maxlength: '4',
                                        minlength: '4'
                                    };
                                }
                                else if (propName == 'Step1' || propName == 'Step2' || propName == 'Step3' || propName == 'Step4' ||
                                    propName == 'Step5' || propName == 'Step6' || propName == 'Step7' || propName == 'Step8' || propName == 'Step9') {
                                    // The "Step" columns
                                    column.width = 130;
                                    column.editType = 'numericedit';
                                    column.edit = {
                                        validateDecimalOnType: true,
                                        decimals: 0,
                                        format: "N"
                                    };
                                    column.validationRules = {
                                        maxlength: '10'
                                    };
                                }
                                else {
                                    column.width = 130;
                                }

                                // Add the column
                                cols.push(column);
                            }

                            $("#tblLookupGroup").ejGrid({
                                dataSource: JSON.parse(result.LookupGroupViewModel.DataModel),
                                columns: cols,
                                toolbarSettings: {
                                    showToolbar: true,
                                    toolbarItems: [ej.Grid.ToolBarItems.Add, ej.Grid.ToolBarItems.Edit, ej.Grid.ToolBarItems.Delete, ej.Grid.ToolBarItems.Update, ej.Grid.ToolBarItems.Cancel]
                                },
                                pageSettings: { pageSize: 5, pageSizeList: [5, 10, 15, 20] },
                                allowPaging: true,
                                enableRowHover: true,
                                allowSelection: true,
                                allowSorting: true,
                                allowFiltering: true,
                                allowScrolling: true,
                                scrollSettings: { width: 1160},
                                filterSettings: { filterType: 'Menu' },
                                editSettings: { allowEditing: true, allowAdding: true, allowDeleting: true, showDeleteConfirmDialog: true },
                                actionBegin: function (args) {
                                    if (args.requestType == "beginedit") { // Edit
                                        var databaseLookupGroupYearId = $('#drpLookupGroupFiscalYears option:selected').val();
                                        var value = JSON.stringify(args.rowData)
                                        $.ajax({
                                            async: true,
                                            url: "@Url.AbsoluteAction("GetDatabaseLookupGroupId", "Rate")",
                                            data: JSON.stringify({ value: value, "databaseLookupGroupYearId": databaseLookupGroupYearId }),
                                            type: "POST",
                                            contentType: "application/json;charset=utf-8",
                                            dataType: "json",
                                            success: function (response) {
                                                //var lookupGroupDataIdArray = response.lookupGroupDataIdArray;
                                            },
                                            error: function (errormessage) {
                                                StaticAlert({ content: errormessage.responseText });
                                            }
                                        });
                                    }
                                    //Add or Update
                                    else if (args.requestType == "save") {
                                        //Add or Update

                                        //********************* Validation ********************
                                        var gridObj = $("#tblLookupGroup").ejGrid("instance");
                                        var gridData = gridObj.model.dataSource;
                                        var invalid = false;
                                        for (var i = 0; i < gridData.length; i++) {
                                            //check if the entered data is already present in the grid
                                            if (args.data['PositionNum'] == gridData[i]['PositionNum'] &&
                                                ((args.data['PrimaryKeyID'] == 'undefined') || (args.data['PrimaryKeyID'] == null) ||
                                                    (args.data['PrimaryKeyID'] !== gridData[i]['PrimaryKeyID']))) {
                                                args.cancel = true;
                                                invalid = true;
                                                StaticAlert({ content: "Duplicate Position Numbers have been entered, please correct" });
                                                break;
                                            }
                                        }
                                        if (invalid) return;
                                        //********************* Validation ********************

                                        var value = JSON.stringify(args.data);
                                        var lookupGroupYearId = $('#drpLookupGroupFiscalYears option:selected').val();
                                        var fiscalYearSelected = $('#drpLookupGroupFiscalYears option:selected').text();
                                        $.ajax({
                                            async: true,
                                            url: "@Url.AbsoluteAction("SaveDatabaseLookupGroup", "Rate")",
                                            data: JSON.stringify({ value: value, "lookupGroupYearId": lookupGroupYearId, "lookupGroupDate": fiscalYearSelected, annualRateSettingEnum: annualRateSettingEnum }),
                                            type: "POST",
                                            contentType: "application/json;charset=utf-8",
                                            dataType: "json",
                                            success: function (response) {
                                                if (!response.Success) {
                                                    StaticAlert({ content: "Error Saving Group Data" });
                                                }
                                                else {
                                                    //Re-bind Grid Data// result.LookupGroupViewModel.DataModel
                                                    var currentPageIndex = parseInt(window.localStorage.getItem("currentPageIndex"), 10);
                                                    $("#tblLookupGroup").ejGrid("dataSource", JSON.parse(response.LookupGroupViewModel.DataModel));

                                                    $("#tblLookupGroup").ejGrid({
                                                        pageSettings: { currentPage: currentPageIndex },
                                                    });
                                                    $("#tblLookupGroup").show();
                                                }
                                            },
                                            error: function (errormessage) {
                                                StaticAlert({ content: errormessage.responseText });
                                            }
                                        });
                                    }
                                    else if (args.requestType == "delete") {
                                        var lookupGroupYearId = $('#drpLookupGroupFiscalYears option:selected').val();
                                        var fiscalYearSelected = $('#drpLookupGroupFiscalYears option:selected').text();
                                        var value = JSON.stringify(args.data);
                                        $.ajax({
                                            async: true,
                                            url: "@Url.AbsoluteAction("DeleteDatabaseLookupGroup", "Rate")",
                                            data: JSON.stringify({ value: value, "lookupGroupYearId": lookupGroupYearId, "lookupGroupDate": fiscalYearSelected, annualRateSettingEnum: annualRateSettingEnum }),
                                            type: "POST",
                                            contentType: "application/json;charset=utf-8",
                                            dataType: "json",
                                            success: function (response) {
                                                if (!response.Success) {
                                                    StaticAlert({ content: "Error Deleting Group Data" });
                                                }
                                                else {
                                                    //Re-bind Grid Data
                                                    $("#tblLookupGroup").ejGrid("dataSource", JSON.parse(response.LookupGroupViewModel.DataModel));
                                                    $("#tblLookupGroup").show();
                                                }
                                            },
                                            error: function (errormessage) {
                                                StaticAlert({ content: errormessage.responseText });
                                                args.cancel = true;
                                            }
                                        });
                                    }
                                }
                            });

                            $('#tblLookupGroup').show();
                            resolve();
                        },
                        error: function (errormessage) {
                            StaticAlert({ content: errormessage.responseText || errormessage }).then(() => {
                                resolve();
                            });
                        },
                        complete: function () {
                            return ClearNotificationDialog()
                        }
                    });
                });
            }).then(() => {
                return ClearNotificationDialog();
            });
        }
        else {
            $('#tblLookupGroup').hide();
            $("#btnRemoveLookupGroup").prop("disabled", true);
        }
    })

    function SaveLookupGroupDate() {
        var lookupGroupYearSelected = $('#txtLookupGroupDate').val();
        var annualRateSettingEnum = @Html.Raw(Json.Encode(annualRateSettingEnum));
        return LoadNotificationDialog("Saving...").then(() => {
            return new Promise((resolve, reject) => {
                $.ajax({
                    async: true,
                    url: "@Url.AbsoluteAction("SaveLookupGroupDate", "Rate")",
                    data: JSON.stringify({ "fiscalYear": lookupGroupYearSelected, annualRateSettingEnum: annualRateSettingEnum }),
                    type: "POST",
                    contentType: "application/json;charset=utf-8",
                    dataType: "json",
                    success: function (result) {
                        if (!result.Success) {
                            StaticAlert({ content: result.Message }).then(() => {
                                $("#txtLookupGroupDate").val("");
                                $("#btnAddLookupGroupDate").prop("disabled", true);
                                $("#drpLookupGroupFiscalYears option").filter(function () {
                                    return this.text == lookupGroupYearSelected;
                                }).attr('selected', true).trigger('change');

                                resolve();
                            });
                        }
                        else {
                            $("#txtLookupGroupDate").val("");
                            $("#btnAddLookupGroupDate").prop("disabled", true);
                            var ddl = $('#drpLookupGroupFiscalYears');
                            ddl.empty();
                            $(document.createElement('option'))
                                .attr('value', 'Select @Model.DateText')
                                .text('Select @Model.DateText')
                                .appendTo(ddl);

                            $(result.DatabaseLookupGroupViewModel.LookupGroupFiscalYears).each(function () {
                                $(document.createElement('option'))
                                    .attr('value', this.Value)
                                    .text(this.Text)
                                    .appendTo(ddl);
                            });

                            // Load Grid
                            $("#drpLookupGroupFiscalYears option").filter(function () {
                                return this.text == lookupGroupYearSelected;
                            }).attr('selected', true).trigger('change');

                            resolve();
                        }
                    },
                    error: function (errormessage) {
                        StaticAlert({ content: errormessage.responseText || errormessage }).then(() => {
                            resolve();
                        });
                    }
                });
            });
        }).then(() => {
            return ClearNotificationDialog();
        });
    }

    function DeleteLookupGroupFYEData() {
        return StaticConfirm({
            title: "Delete Confirm",
            content: "Are you sure you want to Delete?",
            buttons: ["Ok", "Cancel"]
        }).then((key) => {
            if (key != 0) return;

            var lookupGroupYearId = $('#drpLookupGroupFiscalYears option:selected').val();
            var annualRateSettingEnum = @Html.Raw(Json.Encode(annualRateSettingEnum));
            return LoadNotificationDialog("Deleting...").then(() => {
                return new Promise((resolve, reject) => {
                    $.ajax({
                        async: true,
                        url: "@Url.AbsoluteAction("DeleteLookupGroupFYEData", "Rate")",
                        data: JSON.stringify({ "lookupGroupYearId": lookupGroupYearId, annualRateSettingEnum: annualRateSettingEnum }),
                        type: "POST",
                        contentType: "application/json;charset=utf-8",
                        dataType: "json",
                        success: function (result) {
                            if (!result.Success) {
                                StaticAlert({ content: result.Message }).then(() => {
                                    resolve();
                                });
                            }
                            else {
                                var ddl = $('#drpLookupGroupFiscalYears');
                                ddl.empty();
                                $(document.createElement('option'))
                                    .attr('value', 'Select @Model.DateText')
                                    .text('Select @Model.DateText')
                                    .appendTo(ddl);
                                $(result.DatabaseLookupGroupViewModel.LookupGroupFiscalYears).each(function () {
                                    $(document.createElement('option'))
                                        .attr('value', this.Value)
                                        .text(this.Text)
                                        .appendTo(ddl);
                                });
                                $("#btnRemoveLookupGroup").prop("disabled", true);
                                $('#tblLookupGroup').hide(); // Hide the grid and set DD to default
                                $('select#drpLookupGroupFiscalYears option:contains("Select @Model.DateText")').prop('selected', true);

                                resolve();
                            }
                        },
                        error: function (errormessage) {
                            StaticAlert({ content: errormessage.responseText || errormessage }).then(() => {
                                resolve();
                            });
                        }
                    });
                });
            }).then(() => {
                return ClearNotificationDialog();
            });
        });
    }

    function ExportExcel() {
        var fiscalYear = $('#drpLookupGroupFiscalYears option:selected').text();
        if (fiscalYear == 'Select @dateText' || fiscalYear == '' || fiscalYear == null) {
            StaticAlert({ content: "Please select a @dateText to generate the report." });
        }
        else {
            var annualRateSettingEnum = @Html.Raw(Json.Encode(annualRateSettingEnum));
            return LoadNotificationDialog("Generating Corp Office Salary Ceiling Report...").then(() => {
                return new Promise((resolve, reject) => {
                    $.ajax({
                        url: "@Url.AbsoluteAction("ExportCorpOfficeSalaryCeilingTables", "Rate")",
                        data: JSON.stringify({ fiscalYear: fiscalYear, annualRateSettingEnum: annualRateSettingEnum, type: "xlsx" }, "CYE"),
                        type: "POST",
                        contentType: "application/json;charset=utf-8",
                        dataType: "json",
                        success: function (result) {
                            if (result.Success) {
                                //get the file name for download
                                if (result.fileName != "") {
                                    //use window.location.href for redirect to download action for download the file
                                    window.location.href = "@Url.AbsoluteAction("Download", "Rate")/?fileName=" + result.fileName;
                                }
                                resolve();
                            }
                            else {
                                StaticAlert({ content: result.Message || "Unknown error" }).then(() => {
                                    resolve();
                                });
                            }
                        },
                        error: function (errormessage) {
                            StaticAlert({ content: errormessage.responseText || errormessage }).then(() => {
                                resolve();
                            });
                        }
                    });
                });
            }).then(() => {
                return ClearNotificationDialog();
            });
        }
    }
</script>