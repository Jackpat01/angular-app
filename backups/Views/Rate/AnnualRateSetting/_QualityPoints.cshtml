﻿﻿﻿@using WebPortal_OH_FI.Controllers
@using MSLC.Portal.MVC.Utility
@model WebPortal_OH_FI.Models.DatabaseLookupGroupViewModel

@{

    string annualRateSettingEnum = Model.AnnualRateSettingEnum;
}

<style type="text/css">
    .nav-tabs .nav-item.show .nav-link, .nav-tabs .nav-link.active {
        background: moccasin;
        border-bottom: 2px solid green;
    }

    th, td {
        padding: 10px;
    }
    .e-pager-itemsinterval {
        direction: rtl;
        float: left;
    }
</style>

<div id="window_ImportDocument" class="modal fade" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            @{
                Html.RenderPartial("AnnualRateSetting/_ImportGroup", null, new ViewDataDictionary { { "VariableName", annualRateSettingEnum } });
            }
        </div>
    </div>
</div>

<div>
    <div style='width: 100%; font-weight: bold;'>
        <div><h1>Quality Points</h1></div>
    </div>
    <table>
        <tr>
            <td>RED:</td>
            <td> @Html.DropDownListFor(x => x.LookupGroupFiscalYear, (IEnumerable<SelectListItem>)Model.LookupGroupFiscalYears, "Select", new { ID = "drpRedDateListQualityPoint", @style = "width:100px", aria_label="RED" })</td>
            <td><input id="btnDeleteRedDateQualityPoints" value="Delete RED" onclick="DeleteRedDate()" type="submit" class="btn btn-success" /></td>
            <td><input id="txtLookupGroupDateQualityPoints" value="Add RED" type="date" class="datefield" style="width: 165px;" aria-label="Add RED" /></td>
            <td><input id="btnAddLookupGroupDateQualityPoints" value="ADD RED" onclick="SaveLookupGroupDate()" type="submit" class="btn btn-success" /></td>
            <td><input id="btnProcessQualityPoint" value="Process" type="submit" class="btn btn-success" onclick="ProcessQualityPoints()" /></td>
            <td>
                <input id="btnExportExcelQualityPoint" value="Quality Point Report Export to Excel" onclick="ExportExcelQualityPoint()" type="submit" class="btn btn-success" />
                @*<span >Quality Point<br />
            <span >Export to Excel</span>*@
            </td>
        </tr>
    </table>
    <center>
        <div id="tblLookupGroupQualityPoints"></div>
    </center>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $("#btnAddLookupGroupDateQualityPoints").prop("disabled", true);
        $("#btnExportExcelQualityPoint").prop("disabled", true);
        $("#btnProcessQualityPoint").prop("disabled", true);

        $("#txtLookupGroupDateQualityPoints").val("");
        var fiscalYearSelected = $('#drpRedDateListQualityPoint option:selected').text();
        $("#btnDeleteRedDateQualityPoints").prop("disabled", fiscalYearSelected == "Select");
    })

    $("#txtLookupGroupDateQualityPoints").change(function () {
        var val = $('#txtLookupGroupDateQualityPoints').val();
        if (val != "") {
            let v = Date.parse(val);
            if (v > Date.parse('1900-01-01')) $("#btnAddLookupGroupDateQualityPoints").prop("disabled", false);
            else $("#btnAddLookupGroupDateQualityPoints").prop("disabled", true);
        } else {
            $("#btnAddLookupGroupDateQualityPoints").prop("disabled", true);
        }
    });

    $("#drpRedDateListQualityPoint").change(function () {
        var val = $('#drpRedDateListQualityPoint option:selected').text();
        if (val != "Select") {
            $("#btnProcessQualityPoint").prop("disabled", false);
            $("#btnDeleteRedDateQualityPoints").prop("disabled", false);
            $("#btnProcessQualityPoint").prop("disabled", false);
            GetDatabaseLookupGroup();
        } else {
            $("#btnProcessQualityPoint").prop("disabled", true);
            $("#btnDeleteRedDateQualityPoints").prop("disabled", true);
        }
        $("#tblLookupGroupQualityPoints").hide();
    })

   function GetDatabaseLookupGroup () {
       var fiscalYearSelected = $('#drpRedDateListQualityPoint option:selected').text();
       //console.log("fiscalYearSelected -- ", fiscalYearSelected);
       $("#btnDeleteRedDateQualityPoints").prop("disabled", false);
        var annualRateSettingEnum = @Html.Raw(Json.Encode(annualRateSettingEnum));
        if (fiscalYearSelected != "Select") {
            LoadNotificationDialog("Loading Quality Point").then(() => {
                return new Promise((resolve, reject) => {
                    $.ajax({
                        async: true,
                        url: "@Url.AbsoluteAction("GetDatabaseLookupGroup", "Rate")",
                        data: JSON.stringify({ "lookUpGroupDate": fiscalYearSelected, annualRateSettingEnum: annualRateSettingEnum }),
                        type: "POST",
                        cache: false,
                        contentType: "application/json;charset=utf-8",
                        success: function (result) {
                            if (!result.Success) return resolve();

                            var cols = [];
                            cols.push({ field: 'PrimaryKeyID', headerText: 'PrimaryKeyID', isPrimaryKey: true, isIdentity: true, visible: false });
                            cols.push({ field: 'DatabaseLookupGroupYearId', headerText: 'DatabaseLookupGroupYearId', visible: false });
                            cols.push({ field: 'ValueType', headerText: 'ValueType', visible: false });
                            for (var col = 0; col < result.LookupGroupViewModel.GridColumns.length; col++) {
                                var valUpdated = false;
                                var rules = {};
                                var propName = result.LookupGroupViewModel.GridColumns[col].HeaderText;
                                propName = propName.split(' ').join('');

                                if (result.LookupGroupViewModel[propName + 'MaxLength'] != null) {
                                    valUpdated = true;
                                    rules.maxlength = result.LookupGroupViewModel[propName + 'MaxLength'];
                                }

                                if (result.LookupGroupViewModel[propName + 'MinLength'] != null) {
                                    valUpdated = true;
                                    rules.minLength = result.LookupGroupViewModel[propName + 'MinLength'];
                                }

                                if (result.LookupGroupViewModel[propName + 'Required'] != null) {
                                    valUpdated = true;
                                    rules.required = result.LookupGroupViewModel[propName + 'Required'];
                                }

                                if (valUpdated) {
                                    // Build base Header Text and data type and validation rules
                                    cols.push({
                                        field: result.LookupGroupViewModel.GridColumns[col].Field,
                                        headerText: result.LookupGroupViewModel.GridColumns[col].HeaderText,
                                        visible: result.LookupGroupViewModel.GridColumns[col].Visible,
                                        type: result.LookupGroupViewModel.GridColumns[col].Type,
                                        validationRules: rules
                                    });
                                }
                                else {
                                    // Build base Header Text and data type
                                    cols.push({
                                        field: result.LookupGroupViewModel.GridColumns[col].Field,
                                        headerText: result.LookupGroupViewModel.GridColumns[col].HeaderText,
                                        visible: result.LookupGroupViewModel.GridColumns[col].Visible,
                                        type: result.LookupGroupViewModel.GridColumns[col].Type
                                    });
                                }
                            }
                            if (result.LookupGroupViewModel.DataModel.length > 0) {
                                $("#btnExportExcelQualityPoint").prop("disabled", false);
                            }

                            $("#tblLookupGroupQualityPoints").ejGrid({
                                dataSource: JSON.parse(result.LookupGroupViewModel.DataModel),
                                columns: cols,
                                pageSettings: { pageSize: 5, pageSizeList: [5, 10, 15, 20] },
                                allowPaging: true,
                                enableRowHover: true,
                                allowSelection: true,
                                allowSorting: true,
                                allowTextWrap: true,
                                allowFiltering: true,
                                filterSettings: { filterType: 'Menu' },
                                editSettings: { allowEditing: false},

                            });

                            $('#tblLookupGroupQualityPoints').show();
                            resolve();
                        },
                        error: function (errormessage) {
                            StaticAlert({ content: errormessage.responseText }).then(() => {
                                resolve();
                            });
                        }
                    });
                });
            }).then(() => {
                return ClearNotificationDialog();
            });
        }
        else {
            $('#tblLookupGroupQualityPoints').hide();
            $("#btnExportExcelQualityPoint").prop("disabled", true);
        }
    }

    function SaveLookupGroupDate() {
        var lookupGroupYearSelected = $('#txtLookupGroupDateQualityPoints').val();
        var annualRateSettingEnum = @Html.Raw(Json.Encode(annualRateSettingEnum));
        return LoadNotificationDialog("Saving...").then(() => {
            return new Promise((resolve, reject) => {
                $.ajax({
                    async: true,
                    url: "@Url.AbsoluteAction("AddQualityPointDate", "Rate")",
                    data: JSON.stringify({ "qualityPointDate": lookupGroupYearSelected, annualRateSettingEnum: annualRateSettingEnum }),
                    type: "POST",
                    contentType: "application/json;charset=utf-8",
                    dataType: "json",
                    success: function (result) {
                        if (!result.Success) {
                            StaticAlert({ content: result.Message }).then(() => {
                                $("#txtLookupGroupDateQualityPoints").val("");
                                $("#btnAddLookupGroupDateQualityPoints").prop("disabled", true);
                                $("#drpRedDateListQualityPoint option").filter(function () {
                                    return this.text == lookupGroupYearSelected;
                                }).attr('selected', true);
                            });
                        }
                        else {
                            $("#txtLookupGroupDateQualityPoints").val("");
                            $("#btnAddLookupGroupDateQualityPoints").prop("disabled", true);
                            var ddl = $('#drpRedDateListQualityPoint');
                            ddl.empty();
                            $(document.createElement('option'))
                                .attr('value', 'Select')
                                .text('Select')
                                .appendTo(ddl);
                            $(result.LookupGroupFiscalYears).each(function () {
                                $(document.createElement('option'))
                                    .attr('value', this.Value)
                                    .text(this.Text)
                                    .appendTo(ddl);
                            });

                            $("#drpRedDateListQualityPoint option").filter(function () {
                                return this.text == lookupGroupYearSelected;
                            }).attr('selected', true);
                            GetDatabaseLookupGroup();
                        }
                        resolve();
                    },
                    error: function (errormessage) {
                        StaticAlert({ content: errormessage.responseText }).then(() => {
                            resolve();
                        });
                    }
                });
            });
        }).then(() => {
            return ClearNotificationDialog();
        });
    }

    function DeleteRedDate() {
    return StaticConfirm({
        title: "Delete Confirm",
        content: "Are you sure you want to Delete?",
        buttons: ["Ok", "Cancel"]
    }).then((key) => {
        if (key != 0) return;

        var annualRateSettingEnum = @Html.Raw(Json.Encode(annualRateSettingEnum));
        var lookupGroupYearId = $('#drpRedDateListQualityPoint option:selected').val();

        return LoadNotificationDialog("Deleting...").then(() => {
            return new Promise((resolve, reject) => {
                $.ajax({
                    async: true,
                    url: "@Url.AbsoluteAction("DeleteLookupGroupFYEData", "Rate")",
                    data: JSON.stringify({ "lookupGroupYearId": lookupGroupYearId, annualRateSettingEnum: annualRateSettingEnum }),
                    type: "POST",
                    contentType: "application/json;charset=utf-8",
                    dataType: "json",
                    success: function (result) {
                        if (!result.Success) {
                            StaticAlert({ content: result.Message }).then(() => {
                                resolve();
                            });
                        }
                        else {
                            $("#btnDeleteRedDateQualityPoints").prop("disabled", true);
                            var ddl = $('#drpRedDateListQualityPoint');
                            ddl.empty();
                            $(document.createElement('option'))
                                .attr('value', 'Select')
                                .text('Select')
                                .appendTo(ddl);
                            $(result.DatabaseLookupGroupViewModel.LookupGroupFiscalYears).each(function () {
                                $(document.createElement('option'))
                                    .attr('value', this.Value)
                                    .text(this.Text)
                                    .appendTo(ddl);
                            });

                            $('#tblLookupGroupQualityPoints').hide(); // Hide the grid and set DD to default
                            $('select#drpRedDateListQualityPoint option:contains("Select")').prop('selected', true);

                            resolve();
                        }
                    },
                    error: function (errormessage) {
                        StaticAlert({ content: errormessage.responseText }).then(() => {
                            resolve();
                        });
                    }
                });
            });
        }).then(() => {
            return ClearNotificationDialog();
        });
    });
}

    function ExportExcelQualityPoint() {
        var selectedRED = $('#drpRedDateListQualityPoint option:selected').text();
        if (selectedRED == 'Select' || selectedRED == '' || selectedRED == null) {
            StaticAlert({ content: "Please select a Effective Date to generate the report." });
        }
        else {
            var annualRateSettingEnum = @Html.Raw(Json.Encode(annualRateSettingEnum));
            return LoadNotificationDialog("Generating Quality Points Report...").then(() => {
                return new Promise((resolve, reject) => {
                    $.ajax({
                        url: "@Url.AbsoluteAction("GenerateQualityPointsReport", "Rate")",
                        data: JSON.stringify({ selectedRED: selectedRED, annualRateSettingEnum: annualRateSettingEnum }),
                        type: "POST",
                        contentType: "application/json;charset=utf-8",
                        dataType: "json",
                        success: function (result) {
                            if (result.Success) {
                                //get the file name for download
                                if (result.fileName != "") {
                                    //use window.location.href for redirect to download action for download the file
                                    window.location.href = "@Url.AbsoluteAction("Download", "Rate")/?fileName=" + result.fileName;
                                }
                                resolve();
                            }
                            else {
                                StaticAlert({ content: result.Message || "Unknown error" }).then(() => {
                                    resolve();
                                });
                            }
                        },
                        error: function (errormessage) {
                            StaticAlert({ content: errormessage.responseText || errormessage }).then(() => {
                                resolve();
                            });
                        }
                    });
                });
            }).then(() => {
                return ClearNotificationDialog();
            });
        }
    }

    function ProcessQualityPoints() {
        return StaticConfirm({
            title: "Qualtiy Points Operation",
            content: "Processing ALL provider cost reports for this effective date will take some time; continue?",
            buttons: ["Ok", "Cancel"]
        }).then((response) => {
            if (response != 0) return;
            var qualityPointsText = $('#drpRedDateListQualityPoint option:selected').text();
            var qualityPointsVal = $('#drpRedDateListQualityPoint option:selected').val();
            return LoadNotificationDialog("Calculating for Effective Date " + qualityPointsText).then(() => {
                return new Promise((resolve, reject) => {
                    $.ajax({
                        url: "@Url.AbsoluteAction("ProcessQualityPointsCalculation", "Rate")",
                        data: JSON.stringify({ "qualityPointsId": qualityPointsVal }),
                        type: "POST",
                        contentType: "application/json;charset=utf-8",
                        dataType: "json",
                        success: function (result) {
                            if (!result.Success && result.Message != "") {
                                StaticAlert({ content: result.Message }).then(() => {
                                    resolve();
                                });
                            }
                            else {
                                $("#drpRedDateListQualityPoint option").filter(function () {
                                    return this.text == qualityPointsText;
                                }).attr('selected', true).trigger('change');    // This will reload the grid.
                                GetDatabaseLookupGroup();
                                //resolve();
                            }
                            resolve();
                        },
                        error: function (errormessage) {
                            StaticAlert({ content: errormessage.Message }).then(() => {
                                resolve();
                            });
                        }
                    });
                });
            }).then(() => {
                return ClearNotificationDialog();
            });
        });
    }
</script>