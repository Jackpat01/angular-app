﻿﻿@Styles.Render("~/Content/StatLog.css")
@using MSLC.Portal.MVC.Utility
﻿@model WebPortal_OH_FI.Models.DatabaseLookupGroupViewModel

@{ 
    string dateInput = "txtLookupGroupDate";
    string addDateBtn = "btnAddLookupGroupDate";
    string dropDownDefaultText = "RED Date List";
    string tablePlaceholderDiv = "tblLookupGroup";
    string dateDropDown = "drpLookupGroupFiscalYears";
    string annualRateSettingEnum = Model.AnnualRateSettingEnum;

    var dateInId = Html.Raw("'#" + dateInput + "'");
    var addDateId = Html.Raw("'#" + addDateBtn + "'");
    var dropDownId = Html.Raw("'#" + dateDropDown + "'");
    var tableDivId = Html.Raw("'#" + tablePlaceholderDiv + "'");
}

<style type="text/css">
    .nav-tabs .nav-item.show .nav-link, .nav-tabs .nav-link.active {
        background: moccasin;
        border-bottom: 2px solid green;
    }

    th, td {
        padding: 10px;
    }

    .e-pager-itemsinterval {
        direction: rtl;
        float: left;
    }
</style>
<div style='width: 100%; font-weight: bold;'>
    <div><h1>Rate Parameters By Peer Group Table</h1></div>
</div>

<div>
    <table>
        <tr>
            <td>RED:</td>
            <td>@Html.DropDownListFor(model => model.LookupGroupFiscalYear, Model.LookupGroupFiscalYears, dropDownDefaultText, new { ID = dateDropDown, @style = "width: 130px", aria_label="RED" })</td>
            <td><input id="@dateInput" type="date" class="datefield" style="width: 165px;" aria-label="Add RED Date" /></td>
            <td><input id="@addDateBtn" value="ADD RED" type="submit" class="btn btn-success" /></td>
        </tr>
    </table>
    <center>
        <div id="@tablePlaceholderDiv"></div>
    </center>
</div>

<div id="SyncFusionScript">
    <script src="@Url.AbsoluteContent("~/Scripts/ej/common/ej.unobtrusive.min.js")"></script>
</div>

<script type="text/javascript">
    $(function () {
        const dropDownOption = @dropDownId + ' option';
        const dropDownSelection = `${dropDownOption}:selected`;

        //----- Page set up -----
        $(@addDateId).prop('disabled', true);

        //----- Date input change event -----
        $(@dateInId).keyup(function () {
            $(@addDateId).prop('disabled', $(this).val() == '')
        });

        //----- Drop down change event -----
        $(@dropDownId).change(function () {
            let fiscalYearSelected = $(dropDownSelection).text();
            let annualRateSettingEnum = @Html.Raw(Json.Encode(annualRateSettingEnum));
            let isAdmin = @Model.IsUserAdmin.ToString().ToLower();
            let toolBarSettings = [ ej.Grid.ToolBarItems.Edit, ej.Grid.ToolBarItems.Update, ej.Grid.ToolBarItems.Cancel];
            let editSettings = { allowEditing: true, allowAdding: isAdmin, allowDeleting: isAdmin, showDeleteConfirmDialog: true };

            if (isAdmin) {
                toolBarSettings.push(ej.Grid.ToolBarItems.Add);
                toolBarSettings.push(ej.Grid.ToolBarItems.Delete);
            }

            if (fiscalYearSelected != '@dropDownDefaultText') {
                LoadNotificationDialog("Loading Group").then(() => {
                    return new Promise((resolve, reject) => {
                        $.ajax({
                            async: true,
                            url: "@Url.AbsoluteAction("GetDatabaseLookupGroup", "Rate")",
				            data: JSON.stringify({ "lookUpGroupDate": fiscalYearSelected, annualRateSettingEnum: annualRateSettingEnum }),
                            type: "POST",
                            cache: false,
                            contentType: "application/json;charset=utf-8",
                            success: function (result) {
                                if (!result.Success) return resolve();

                                var cols = [];
                                cols.push({ field: 'PrimaryKeyID', headerText: 'PrimaryKeyID', isPrimaryKey: true, isIdentity: true, visible: false });
                                cols.push({ field: 'DatabaseLookupGroupYearId', headerText: 'DatabaseLookupGroupYearId', visible: false });
                                cols.push({ field: 'ValueType', headerText: 'ValueType', visible: false });
                                for (var col = 0; col < result.LookupGroupViewModel.GridColumns.length; col++) {
                                    // Build "Columns" and "Header Text"
                                    colObj = {
                                        field: result.LookupGroupViewModel.GridColumns[col].Field,
                                        headerText: result.LookupGroupViewModel.GridColumns[col].HeaderText,
                                        visible: result.LookupGroupViewModel.GridColumns[col].Visible,
                                        type: result.LookupGroupViewModel.GridColumns[col].Type,
                                        allowEditing: result.LookupGroupViewModel.GridColumns[col].AllowEditing
                                    };
                                    cols.push(colObj);
                                    if (colObj.type == "date") {
                                        colObj.editType = ej.Grid.EditingType.DatePicker;
                                        colObj.format = "{0:MM/dd/yyyy}";
                                    }
                                }
                                $(@tableDivId).ejGrid({
                                    dataSource: JSON.parse(result.LookupGroupViewModel.DataModel),
                                    columns: cols,
                                    toolbarSettings: {
                                        showToolbar: true,
                                        toolbarItems: toolBarSettings
                                    },
                                    pageSettings: { pageSize: 5, pageSizeList: [5, 10, 15, 20] },
                                    allowPaging: true,
                                    enableRowHover: true,
                                    allowSelection: true,
                                    allowSorting: true,
                                    allowTextWrap: true,
                                    editSettings: editSettings,
                                    actionBegin: function (args) {
                                        let table = this;
                                        let previousValue = { ...args.previousData };

                                        if (args.requestType == "beginedit") { // Edit
                                            // This will register a copy of the data on the server so that it can tell what was modified.
                                            var databaseLookupGroupYearId = $(dropDownSelection).val();
                                            var value = JSON.stringify(args.rowData)
                                            return new Promise((res, rej) => {
                                                $.ajax({
                                                    async: true,
                                                    url: "@Url.AbsoluteAction("GetDatabaseLookupGroupId", "Rate")",
                                                    data: JSON.stringify({ value: value, "databaseLookupGroupYearId": databaseLookupGroupYearId }),
                                                    type: "POST",
                                                    contentType: "application/json;charset=utf-8",
                                                    dataType: "json",
                                                    success: function (response) {
                                                        res();
                                                    },
                                                    error: function (errormessage) {
                                                        StaticAlert({ content: errormessage.responseText }).then(() => {
                                                            res();
                                                        });
                                                        args.cancel = true;
                                                    }
                                                });
                                            });
                                        }
                                        else if (args.requestType == "save") {
                                            return StaticConfirm({
                                                title: "Update Rate Parameter Values",
                                                content: "Modifying these values can alter the Rate Calculation, is this correct?",
                                                buttons: ["Ok", "Cancel"]
                                            }).then((key) => {

                                                //Add or Update
                                                //********************** Local Store ************
                                                // Use Localstorage to save the grid's "CurrentPageIndex" to reset it after Postback.
                                                // Syncfusion Forum link for future reference:
                                                // --https://www.syncfusion.com/forums/144600/retain-last-selected-row-and-page-in-grid-after-postback--
                                                window.localStorage.removeItem("currentPageIndex");
                                                window.localStorage.setItem("currentPageIndex", args.model.pageSettings.currentPage);

                                                if (key != 0) {
                                                    table.model.dataSource[args.selectedRow] = previousValue;
                                                    table.refreshContent();
                                                    return;
                                                }

                                                //********************** Local Store ************
                                                var value = JSON.stringify(args.data);
                                                var lookupGroupYearId = $(dropDownSelection).val();
                                                var fiscalYearSelected = $(dropDownSelection).text();
                                                return new Promise((res, rej) => {
                                                    $.ajax({
                                                        async: true,
                                                        url: "@Url.AbsoluteAction("SaveDatabaseLookupGroup", "Rate")",
                                                        data: JSON.stringify({ value: value, lookupGroupYearId: lookupGroupYearId, lookupGroupDate: fiscalYearSelected, annualRateSettingEnum: annualRateSettingEnum }),
                                                        type: "POST",
                                                        contentType: "application/json;charset=utf-8",
                                                        dataType: "json",
                                                        success: function (response) {
                                                            if (!response.Success) {
                                                                window.localStorage.removeItem("currentPageIndex");
                                                                window.localStorage.setItem("currentPageIndex", 1);
                                                                StaticAlert({ content: "Error Saving Group Data" }).then(() => {
                                                                    res();
                                                                });
                                                            }
                                                            else {
                                                                //Re-bind Grid Data
                                                                var currentPageIndex = parseInt(window.localStorage.getItem("currentPageIndex"), 10);
                                                                $(@tableDivId).ejGrid("dataSource", JSON.parse(response.LookupGroupViewModel.DataModel));
                                                                $(@tableDivId).ejGrid({
                                                                    pageSettings: { currentPage: currentPageIndex },
                                                                });
                                                                $(@tableDivId).show();
                                                                res();
                                                            }
                                                        },
                                                        error: function (errormessage) {
                                                            window.localStorage.removeItem("currentPageIndex");
                                                            StaticAlert({ content: errormessage.responseText }).then(() => {
                                                                res();
                                                            });
                                                        }
                                                    });
                                                });
                                            });
                                        }
                                        else if (args.requestType == "delete") {
                                            var lookupGroupYearId = $(dropDownSelection).val();
                                            var fiscalYearSelected = $(dropDownSelection).text();
                                            var value = JSON.stringify(args.data);
                                            return new Promise((res, rej) => {
                                                $.ajax({
                                                    async: true,
                                                    url: "@Url.AbsoluteAction("DeleteDatabaseLookupGroup", "Rate")",
                                                    data: JSON.stringify({ value: value, "lookupGroupYearId": lookupGroupYearId, "fiscalYear": fiscalYearSelected, annualRateSettingEnum: annualRateSettingEnum }),
                                                    type: "POST",
                                                    contentType: "application/json;charset=utf-8",
                                                    dataType: "json",
                                                    success: function (response) {
                                                        if (!response.Success) {
                                                            StaticAlert({ content: "Error Deleting Group Data" }).then(() => {
                                                                res();
                                                            });
                                                        }
                                                        else {
                                                            $(@tableDivId).ejGrid("dataSource", JSON.parse(response.LookupGroupViewModel.DataModel));
                                                            $(@tableDivId).show();
                                                            res();
                                                        }
                                                    },
                                                    error: function (errormessage) {
                                                        args.cancel = true;
                                                        window.localStorage.removeItem("currentPageIndex");
                                                        StaticAlert({ content: errormessage.responseText }).then(() => {
                                                            res();
                                                        });
                                                    }
                                                });
                                            });
                                        }
                                    }
                                });

                                $(@tableDivId).show();
                                resolve();
                            },
                            error: function (errormessage) {
                                StaticAlert({ content: errormessage.responseText }).then(() => {
                                    resolve();
                                });
                            }
                        });
                    });
                }).then(() => {
                    return ClearNotificationDialog();
                });
            }
            else {
                $(@tableDivId).hide();
            }
        });

        //----- Event for add date on click -----
        $(@addDateId).on('click', function () {
            let lookupGroupYearSelected = $(@dateInId).val();
            let annualRateSettingEnum = @Html.Raw(Json.Encode(annualRateSettingEnum));
            return LoadNotificationDialog("Saving...").then(() => {
                return new Promise((resolve, reject) => {
                    $.ajax({
                        async: true,
                        url: '@Url.AbsoluteAction("SaveLookupGroupDate", "Rate")',
                        data: JSON.stringify({ fiscalYear: lookupGroupYearSelected, annualRateSettingEnum: annualRateSettingEnum }),
                        type: 'POST',
                        contentType: 'application/json;charset=utf-8',
                        dataType: 'json',
                        success: function (result) {
                            if (!result.Success) {
                                StaticAlert({ content: result.Message }).then(() => {
                                    $(dropDownOption).fil * ter(function () {
                                        return this.text == formatDateString(lookupGroupYearSelected);
                                    }).attr('selected', true);
                                    $(@dropDownId).trigger('change');
                                    $(@dateInId).val('');
                                })
                            } else {
                                $(@dateInId).val('');
                                $(@addDateId).prop('disabled', true);
                                $(@dropDownId).empty();

                                $(document.createElement('option'))
                                    .attr('value', 'Select RED')
                                    .text('Select RED')
                                    .appendTo(@dropDownId);
                                $(result.DatabaseLookupGroupViewModel.LookupGroupFiscalYears).each(function () {
                                    $(document.createElement('option'))
                                        .attr('value', this.Value)
                                        .text(this.Text)
                                        .appendTo(@dropDownId);
                                });

                                $(dropDownOption).filter(function () {
                                    return this.text == formatDateString(lookupGroupYearSelected);
                                }).attr('selected', true).trigger('change');
                            }
                            resolve();
                        },
                        error: function (data) {
                            StaticAlert({ content: data.responseText }).then(() => {
                                resolve();
                            });
                        }
                    });
                });
            }).then(() => {
                return ClearNotificationDialog();
            });
        });

        /** Converts JQuery's yyyy-MM-dd format to our MM-dd-yyyy format
         * @@param {string} date result from JQuery .val() from date input
         * @@returns {string} date string formatted as MM-dd-yyyy
         */
        function formatDateString(date) {
            let dateParts = date.split('-');                              //starts as yyyy-MM-dd
            let orderedDate = [dateParts[1], dateParts[2], dateParts[0]] //swaps to MM-dd-yyyy
            return orderedDate.join('/');
        }
    });
</script>