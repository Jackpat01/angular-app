﻿﻿@Styles.Render("~/Content/StatLog.css")
@model WebPortal_OH_FI.Models.DatabaseLookupViewModel

@{

    string annualRateSettingEnum = Model.AnnualRateSettingEnum;
}

<style type="text/css">
    .e-grid .e-pager .e-pagercontainer {
        float: left;
    }

    .e-grid .e-pager .e-pager-itemsinterval {
        float: left;
    }

    .e-pager-itemsinterval {
        direction: rtl;
        float: left;
    }
</style>

<div id="window_ImportDocument" class="modal fade" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            @{
                Html.RenderPartial("AnnualRateSetting/_Import", null, new ViewDataDictionary { { "VariableName", annualRateSettingEnum } });
            }
        </div>
    </div>
</div>

<div style='width: 100%; font-weight: bold;'>
    <div><h1>Special Focus Facilities</h1></div>
</div>
<div>
    <table>
        <tr>
            <td>CYE:</td>
            <td>@Html.DropDownListFor(x => x.FiscalYear, (IEnumerable<SelectListItem>)Model.RedDateList, "Select CYE", new { ID = "drpRedDateList", @style = "width: 80%;", aria_label="CYE" })</td>
            <td><input id="btnRemoveFYE" value="Remove CYE" onclick="RemoveFYE()" type="submit" class="btn btn-success" /></td>
            <td>@Html.TextBoxFor(x => x.RedDateYear, new { @placeholder = "Add New CYE", id = "txtREDDate", maxlength = 4, @oninput = "this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\\..*)\\./g, '$1');", @style = "width: 100px;", aria_label="Add New CYE" })</td>
            <td><input id="btnAddFYE" value="Add New CYE" onclick="AddFYE()" type="submit" class="btn btn-success" /></td>
            <td><input id="btnImport" value="Import" data-toggle="modal" data-target="#window_ImportDocument" data-backdrop="static" type="submit" class="btn btn-success" /></td>
            <td><input id="btnExportExcel" value="Export" onclick="ExportExcel()" type="submit" class="btn btn-success" /></td>
        </tr>

    </table>
    <center>
        <div id="tblGrid"></div>
    </center>
</div>

<div id="SyncFusionScript">
    <script src="@Url.AbsoluteContentUri("~/Scripts/ej/common/ej.unobtrusive.min.js")"></script>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        var annualRateSettingEnum = @Html.Raw(Json.Encode(annualRateSettingEnum));
        $("#btnAddFYE").prop("disabled", true);
        $("#txtREDDate").val("");
        var fiscalYearSelected = $('#drpRedDateList option:selected').text();
        $("#btnRemoveFYE").prop("disabled", fiscalYearSelected == "Select CYE");

        $("#txtREDDate").keyup(function () {
            var val = $('#txtREDDate').val();
            if (val != "") {
                $("#btnAddFYE").prop("disabled", false);
            } else {
                $("#btnAddFYE").prop("disabled", true);
            }
        });

        $("#drpRedDateList").change(function () {
            var fiscalYearSelected = $('#drpRedDateList option:selected').text();
            if (fiscalYearSelected != "Select CYE") {
                $("#btnRemoveFYE").prop("disabled", false);
                LoadNotificationDialog("Loading").then(() => {
                    return new Promise((resolve, reject) => {
                        $.ajax({
                            async: true,
                            url: "@Url.AbsoluteAction("GetDatabaseLookUpVariableInfo", "Rate")",
                            data: JSON.stringify({ annualRateSettingEnum: annualRateSettingEnum, "fiscalYear": fiscalYearSelected }),
                            type: "POST",
                            cache: false,
                            contentType: "application/json;charset=utf-8",
                            success: function (result) {
                                if (!result.Success) return;

                                var cols = [];
                                cols.push({ field: 'DatabaseLookupVariableId', headerText: 'PrimaryKeyID', isPrimaryKey: true, isIdentity: true, visible: false });
                                cols.push({
                                    field: 'Value', headerText: 'Provider Number', width: '50', visible: true,
                                    validationRules: { required: true, maxlength: result.DatabaseLookupViewModel.McaidLength, minlength: result.DatabaseLookupViewModel.McaidLength }
                                });

                                $("#tblGrid").ejGrid({
                                    dataSource: result.DatabaseLookupViewModel.DatabaseLookupGridViewModelList,
                                    columns: cols,
                                    toolbarSettings: {
                                        showToolbar: true,
                                        toolbarItems: [ej.Grid.ToolBarItems.Add, ej.Grid.ToolBarItems.Update, ej.Grid.ToolBarItems.Delete, ej.Grid.ToolBarItems.Cancel]
                                    },
                                    pageSettings: { pageSize: 5, pageSizeList: [5, 10, 15, 20] },
                                    allowPaging: true,
                                    enableRowHover: true,
                                    allowSelection: true,
                                    allowSorting: true,
                                    allowTextWrap: true,
                                    allowFiltering: true,
                                    filterSettings: { filterType: 'Menu' },
                                    editSettings: { allowAdding: true, allowDeleting: true, showDeleteConfirmDialog: true },
                                    actionBegin: function (args) {
                                        if (args.requestType == "save") {
                                            //Add or Update
                                            //********************** Local Store ************
                                            // Use Localstorage to save the grid's "CurrentPageIndex" to reset it after Postback.
                                            // Syncfusion Forum link for future reference:
                                            // --https://www.syncfusion.com/forums/144600/retain-last-selected-row-and-page-in-grid-after-postback--
                                            window.localStorage.removeItem("currentPageIndex");
                                            window.localStorage.setItem("currentPageIndex", args.model.pageSettings.currentPage);
                                            //*********************** Local Store ************

                                            var fiscalYearSelected = $('#drpRedDateList option:selected').text();
                                            var gridObj = $("#tblGrid").ejGrid("instance");
                                            var gridData = gridObj.model.dataSource;
                                            var hasDuplicates = false;
                                            for (var i = 0; i < gridData.length; i++) {
                                                //check if the entered data is already present in the grid
                                                if ((args.data['Value'] == gridData[i]['Value']) && ((args.data['DatabaseLookupVariableId'] == 'undefined') || (args.data['DatabaseLookupVariableId'] != gridData[i]['DatabaseLookupVariableId']))) {
                                                    args.cancel = true;
                                                    hasDuplicates = true;
                                                    StaticAlert({ content: "Duplicate Provider Numbers have been entered, please correct" });
                                                    break;
                                                }
                                            }
                                            if (!hasDuplicates) {
                                                return new Promise((res, rej) => {
                                                    $.ajax({
                                                        async: true,
                                                        url: "@Url.AbsoluteAction("SaveLookUpVariables", "Rate")",
                                                        data: JSON.stringify({ annualRateSettingEnum: annualRateSettingEnum, value: args.data, "fiscalYear": fiscalYearSelected }),
                                                        type: "POST",
                                                        contentType: "application/json;charset=utf-8",
                                                        dataType: "json",
                                                        success: function (response) {
                                                            if (!response.Success) {
                                                                window.localStorage.removeItem("currentPageIndex");
                                                                StaticAlert({ content: "Error Saving Data" }).then(() => {
                                                                    res();
                                                                });
                                                            }
                                                            else {
                                                                //Re-bind Grid Data
                                                                var currentPageIndex = parseInt(window.localStorage.getItem("currentPageIndex"), 10);
                                                                $("#tblGrid").ejGrid({
                                                                    dataSource: response.DatabaseLookupViewModel.DatabaseLookupGridViewModelList
                                                                });
                                                                $("#tblGrid").ejGrid({
                                                                    pageSettings: { currentPage: currentPageIndex },
                                                                });
                                                                $("#tblGrid").show();
                                                                res();
                                                            }
                                                        },
                                                        error: function (errormessage) {
                                                            StaticAlert({ content: errormessage.responseText }).then(() => {
                                                                res();
                                                            });
                                                        }
                                                    });
                                                });
                                            }
                                        }
                                        else if (args.requestType == "delete") {
                                            var fiscalYearSelected = $('#drpRedDateList option:selected').text();
                                            return new Promise((res, rej) => {
                                                $.ajax({
                                                    async: true,
                                                    url: "@Url.AbsoluteAction("DeleteLookUpVariables", "Rate")",
                                                    data: JSON.stringify({ annualRateSettingEnum: annualRateSettingEnum, value: args.data, "fiscalYear": fiscalYearSelected }),
                                                    type: "POST",
                                                    contentType: "application/json;charset=utf-8",
                                                    dataType: "json",
                                                    success: function (response) {
                                                        if (!response.Success) {
                                                            StaticAlert({ content: "Error Deleting Data" }).then(() => {
                                                                res();
                                                            });
                                                        }
                                                        else {
                                                            //Re-bind Grid Data
                                                            $("#tblGrid").ejGrid("dataSource", response.DatabaseLookupViewModel.DatabaseLookupGridViewModelList);
                                                            $("#tblGrid").show();

                                                            res();
                                                        }
                                                    },
                                                    error: function (errormessage) {
                                                        args.cancel = true;
                                                        StaticAlert({ content: errormessage.responseText }).then(() => {
                                                            res();
                                                        });
                                                    }
                                                });
                                            });
                                        }
                                    }
                                });

                                $("#tblGrid").show();
                                resolve();
                            },
                            error: function (errormessage) {
                                StaticAlert({ content: errormessage.responseText }).then(() => {
                                    resolve();
                                });
                            }
                        });
                    });
                }).then(() => {
                    return ClearNotificationDialog();
                });
            }
            else {
                $('#tblGrid').hide();
                $("#btnRemoveFYE").prop("disabled", true);
            }
        })
    })

    function AddFYE() {
        var yearSelected = $('#txtREDDate').val();
        var annualRateSettingEnum = @Html.Raw(Json.Encode(annualRateSettingEnum));
        return LoadNotificationDialog("Saving...").then(() => {
            return new Promise((resolve, reject) => {
                $.ajax({
                    async: true,
                    url: "@Url.AbsoluteAction("AddFYE", "Rate")",
                    data: JSON.stringify({ annualRateSettingEnum: annualRateSettingEnum, "fiscalYear": yearSelected }),
                    type: "POST",
                    contentType: "application/json;charset=utf-8",
                    dataType: "json",
                    success: function (result) {
                        if (!result.Success) {
                            StaticAlert({ content: result.Message }).then(() => {
                                $("#txtREDDate").val("");
                                $("#btnAddFYE").prop("disabled", true);
                                $("#drpRedDateList option").filter(function () {
                                    return this.text == yearSelected;
                                }).attr('selected', true).trigger('change');

                                resolve();
                            });
                        }
                        else {
                            $("#txtREDDate").val("");
                            $("#btnAddFYE").prop("disabled", true);
                            var ddl = $('#drpRedDateList');
                            ddl.empty();
                            $(document.createElement('option'))
                                .attr('value', '')
                                .text('Select CYE')
                                .appendTo(ddl);
                            //Check if CYE drop down list is empty
                            if (result.DatabaseLookupViewModel.RedDateList.length === 0) {
                                $(document.createElement('option'))
                                    .attr('value', yearSelected)
                                    .text(yearSelected)
                                    .appendTo(ddl);
                            }
                            else {
                                $(result.DatabaseLookupViewModel.RedDateList).each(function () {
                                    $(document.createElement('option'))
                                        .attr('value', this.Value)
                                        .text(this.Text)
                                        .appendTo(ddl);
                                });
                            }
                            // Load Grid
                            $("#drpRedDateList option").filter(function () {
                                return this.text == yearSelected;
                            }).attr('selected', true).trigger('change');

                            resolve();
                        }
                    },
                    error: function (errormessage) {
                        StaticAlert({ content: errormessage.responseText }).then(() => {
                            resolve();
                        });
                    }
                });
            });
        }).then(() => {
            return ClearNotificationDialog();
        });
    }

    function RemoveFYE() {
        return StaticConfirm({
            title: "Delete Confirm",
            content: "Are you sure you want to Delete?",
            buttons: ["Ok", "Cancel"]
        }).then((key) => {
            if (key != 0) return;

            var annualRateSettingEnum = @Html.Raw(Json.Encode(annualRateSettingEnum));
            var year = $('#drpRedDateList option:selected').text();
            return LoadNotificationDialog("Deleting...").then(() => {
                return new Promise((resolve, reject) => {
                    $.ajax({
                        async: true,
                        url: "@Url.AbsoluteAction("RemoveFYE", "Rate")",
                        data: JSON.stringify({ annualRateSettingEnum: annualRateSettingEnum, "year": year }),
                        type: "POST",
                        contentType: "application/json;charset=utf-8",
                        dataType: "json",
                        success: function (result) {
                            if (!result.Success) {
                                StaticAlert({ content: result.Message }).then(() => {
                                    resolve();
                                });
                            }
                            else {
                                $("#btnRemoveFYE").prop("disabled", true);
                                var ddl = $('#drpRedDateList');
                                ddl.empty();
                                $(document.createElement('option'))
                                    .attr('value', 'Select CYE')
                                    .text('Select CYE')
                                    .appendTo(ddl);
                                $(result.DatabaseLookupViewModel.RedDateList).each(function () {
                                    $(document.createElement('option'))
                                        .attr('value', this.Value)
                                        .text(this.Text)
                                        .appendTo(ddl);
                                });

                                $('#tblGrid').hide(); // Hide the grid and set DD to default
                                $('select#drpRedDateList option:contains("Select CYE")').prop('selected', true);

                                resolve();
                            }
                        },
                        error: function (errormessage) {
                            StaticAlert({ content: errormessage.responseText }).then(() => {
                                resolve();
                            });
                        }
                    });
                });
            }).then(() => {
                return ClearNotificationDialog();
            });
        });
    }

    function ExportExcel() {
        var fiscalYear = $('#drpRedDateList option:selected').text();
        if (fiscalYear == 'Select Fiscal Year' || fiscalYear == '' || fiscalYear == null) {
            StaticAlert({ content: "Please select a fiscal year to generate the report." });
        }
        else {
            var annualRateSettingEnum = @Html.Raw(Json.Encode(annualRateSettingEnum));
            return LoadNotificationDialog("Generating Special Focus Report...").then(() => {
                return new Promise((resolve, reject) => {
                    $.ajax({
                        url: "@Url.AbsoluteAction("ExportSpecialFocusFacilities", "Rate")",
                        data: JSON.stringify({ fiscalYear: fiscalYear, annualRateSettingEnum: annualRateSettingEnum }),
                        type: "POST",
                        contentType: "application/json;charset=utf-8",
                        dataType: "json",
                        success: function (result) {
                            if (result.Success) {
                                //get the file name for download
                                if (result.fileName != "") {
                                    //use window.location.href for redirect to download action for download the file
                                    window.location.href = "@Url.AbsoluteAction("Download", "Rate")/?fileName=" + result.fileName;
                                }
                                resolve();
                            }
                            else {
                                StaticAlert({ content: result.Message || "Unknown error" }).then(() => {
                                    resolve();
                                });
                            }
                        },
                        error: function (errormessage) {
                            StaticAlert({ content: errormessage.responseText || errormessage }).then(() => {
                                resolve();
                            });
                        }
                    });
                });
            }).then(() => {
                return ClearNotificationDialog();
            });
        }
    }
</script>