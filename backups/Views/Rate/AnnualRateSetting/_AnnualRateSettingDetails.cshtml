            td1.attr("style", "width: 20%");
            td1.attr("align", "left");
            td1.attr("padding", "10px");

            var textBox = $("<input />").attr("type", "text").attr("name", fValue["Key"]).attr("id", fValue["DatabaseLookupVariableId"]).attr("style", "width: 150px;");
            textBox.val(fValue["Value"]);
            td1.append(textBox);

            tr.append(td);
            tr.append(td1);
        }
        else {
            var td = $("<td />");
            var td1 = $("<td />");
            tr.append(td);
            tr.append(td1);
