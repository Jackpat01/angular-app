    let selectedRowArray = [];
    function onRowSelected(args) {
        var providerSelected = args.selectedData;
        var index = selectedRowArray.findIndex(item => item.RatePackageId == args.selectedData.RatePackageId
            && item.ProviderId == args.selectedData.ProviderId);
        if (args.data.length > 1) {
           for (var i = 0; i < args.data.length; i++) {
                selectedRowArray.push(args.data[i]); //pushing all the selected Records
            }
        }
        else if (index == -1) {
            selectedRowArray.push(args.selectedData);
        }
        GetProviderRateInfoDetails();
        var gridObj = $("#tblProviderList").data("ejGrid");
        var array = gridObj.model.dataSource;
        if (array.every(x => x.IsFinalized == true)) {
            $("#btnReCalculate").prop("disabled", true);
            $("#btnCalcAllProviders").prop("disabled", true);
            $("#btnFinalizeAll").prop("disabled", true);
            $("#btnDeleteRate").prop("disabled", true);
        }
        else if (providerSelected.IsFinalized == true) {
            // If the user selects a rate that is finalized – No buttons should be enabled
            $("#btnRefreshList").prop("disabled", true);
            $("#btnReCalculate").prop("disabled", true);
            $("#btnCalcAllProviders").prop("disabled", true);
            $("#btnFinalizeAll").prop("disabled", true);
            $("#btnUnFinalizeAll").prop("disabled", true);
            $("#btnDeleteRate").prop("disabled", true);
        }
        else if (providerSelected.IsFinalized == false) {
            if (array.some(x => x.IsFinalized == true) && array.some(checkNoRateAmount)) {
                $("#btnRefreshList").prop("disabled", false);
                $("#btnCalcAllProviders").prop("disabled", true);
                $("#btnReCalculate").prop("disabled", false);
                $("#btnFinalizeAll").prop("disabled", false);
                $("#btnUnFinalizeAll").prop("disabled", false);
                $("#btnDeleteRate").prop("disabled", false);
            }
        }
        else {
            $("#btnReCalculate").prop("disabled", false);
            $("#btnCalcAllProviders").prop("disabled", false);
            $("#btnFinalizeAll").prop("disabled", false);
            $("#btnDeleteRate").prop("disabled", false);
        }
    }

    function rowDeselected(args) {
        var deselectedItem = args.selectedData;
        var index = selectedRowArray.findIndex(item => item.RatePackageId == deselectedItem.RatePackageId
            && item.ProviderId == deselectedItem.ProviderId);
        if (args.data.length > 1) {
            for (var i = 0; i < args.data.length; i++) {
                selectedRowArray.splice(args.data[i], 1); //remove all the selected Records
            }
        }
        else {
            selectedRowArray.splice(index, 1);
        }
        GetProviderRateInfoDetails();
        var gridObj = $("#tblProviderList").data("ejGrid");
        var array = gridObj.model.dataSource;
        if (array.some(checkNoRateAmount)) {
            $("#btnReCalculate").prop("disabled", false);
        }
    }

    function checkNoRateAmount(element) {
        if (element.FinalRateAmount == null || element.FinalRateAmount == '' || element.FinalRateAmount == 'null'
            || element.FinalRateAmount == undefined) {
            return true;
        }
    }

