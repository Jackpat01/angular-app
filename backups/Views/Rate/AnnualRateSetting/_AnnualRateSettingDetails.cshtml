@model WebPortal_OH_FI.Models.AnnualRateSettingViewModel
<style type="text/css">
    .nav-tabs .nav-item.show .nav-link, .nav-tabs .nav-link.active {
        background: moccasin;
        border-bottom: 2px solid green;
    }

    th, td {
        padding: 10px;
    }

    #tableProviderDetails td:nth-of-type(2n+1) {
        font-weight: bold;
        text-align: right;
    }

    #tableProviderDetails input[type="text"] {
        width: 100px;
    }

    .e-grid .e-pager .e-pagercontainer {
        float: left;
    }

    .e-grid .e-pager .e-pager-itemsinterval {
        float: left;
    }
    .e-pager-itemsinterval {
        direction: rtl;
        float: left;
    }
</style>
<div id="rateSetting">
    <div style='width: 100%; font-weight: bold;'>
        <div><h1>RED Specific Information</h1></div>
    </div>
    <table>
        <tr>
            <td>RED Date:</td>
            <td>@Html.DropDownListFor(x => x.RedDateSelect, (IEnumerable<SelectListItem>)Model.RedDateList, "RED Date List", new { ID = "drpRedDateList", @style = "width: 125px;", aria_label="RED Date" })</td>
            <td><input id="btnSearchRed" value="Get Selected RED" type="submit" class="btn btn-success" onclick="GetREDRateInfo()" /></td>
            <td><input id="addRedDate" value="Add RED Date" type="date" class="datefield" style="width: 165px;" aria-label="Add RED Date" /></td>
            <td><input id="btnAddRed" value="ADD RED DATE" onclick="AddRed()" type="submit" class="btn btn-success" /></td>
        </tr>
    </table>
    <div id="rateInfo">
        <div id="dynamicTextBox">
            <table style="width:100%">
                <tr>
                    <td id="TextBoxContainer" style="width:85%">
                        <!--Textboxes will be added here -->
                    </td>
                    <td valign="top" style="width:15%">
                        <input type="checkbox" id="chkFinalized" aria-label="Finalized" /><b>&nbsp;Finalized</b><br />
                        <input type="checkbox" id="chkIsBaseYear" aria-label="Is BaseYear" disabled /><b>&nbsp;Is BaseYear</b><br />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div id="divProviderInfo">
        <table>
            <tr>
                <td>
                    <b>Provider Information</b>
                </td>
            </tr>
            <tr>
                <td>
                    Provider List
                </td>
            </tr>
            <tr>
                <td align="center">
                    <script id="template" type="text/x-template">
                        {{if (IsFinalized && Issuance != null && Messages.indexOf("Rate was sent to FI on") > -1)}}
                        <input type="checkbox" checked disabled/>
                        {{else (IsFinalized)}}
                        <input type="checkbox" onchange="chkFinalize('{{:RatePackageId}}', this)" checked />
                        {{else (Rate == null)}}
                        <input type="checkbox" disabled />
                        {{else }}
                        <input type="checkbox" onchange="chkFinalize('{{:RatePackageId}}', this)" />
                        {{/if}}
                    </script>
                    <div id="tblProviderList"></div>
                </td>
            </tr>
            <tr>
                <td>
                    <input id="btnRefreshList" value="Refresh List" type="submit" class="btn btn-success" onclick="GetProvidersByRefreshList()" />
                    <input id="btnCopyAll" value="Appeal Rates (Copy All)" type="submit" class="btn btn-success" onclick="CopyFinalizedRates()" />
                    <input id="btnReCalculate" value="Re/Calculate Selected" type="submit" class="btn btn-success" onclick="RecalculateRate()" />
                    <input id="btnCalcAllProviders" value="Calc All Providers" type="submit" class="btn btn-success" onclick="CalculateAll()" />
                    <input id="btnFinalizeAll" value="Finalize All" type="submit" class="btn btn-success" onclick="FinalizeAll()" />
                    <input id="btnUnFinalizeAll" value="UnFinalize All" type="submit" class="btn btn-success" onclick="UnFinalizeAll()" />
                    <input id="btnDeleteRate" value="Delete Highlighted Rate" type="submit" class="btn btn-success" onclick="DeleteRate()" />
                    <input id="btnPrint" value="Provider List Export to Excel" type="submit" class="btn btn-success" onclick="PrintRates()" />
                </td>
            </tr>
        </table>
    </div>
    <div>
        <div id="divProviderDetailsHeader" style='width: 100%; font-weight: bold;'>
            <b>Details - Only one provider may be selected from the above Provider List to view this section</b>
        </div>
        <div id="divProviderDetails">
            <table id="tableProviderDetails" style="width:90%">
                <tr>
                    <td id="AnnualRSDetailsLabelContainer" style="width:85%">
                        <!--Labels will be added here -->
                    </td>
                <tr>
            </table>
        </div>
    </div>
</div>
<script type="text/javascript">
    // For RED Date list
    $(document).ready(function () {
        var redDateSelected = $('#drpRedDateList option:selected').text();
        $("#btnSearchRed").prop("disabled", redDateSelected == "RED Date List");
        $("#rateInfo").hide();
        $("#divProviderInfo").hide();
        $("#chkFinalized").prop("disabled", true);
        $("#divProviderDetails :input").attr("disabled", true);
        $("#divProviderDetails").hide();
        $("#divProviderDetailsHeader").hide();

        $("#drpRedDateList").change(function () {
            var val = $('#drpRedDateList option:selected').text();
            if (val != "RED Date List") {
                $("#btnSearchRed").prop("disabled", false);
            } else {
                $("#btnSearchRed").prop("disabled", true); // Disables
            }
            $("#rateInfo").hide();
            $("#divProviderInfo").hide();
            $("#divProviderDetailsHeader").hide();
            $("#divProviderDetails").hide();
        });

        // For
        $("#btnAddRed").prop("disabled", true); // Disables
        $("#addRedDate").change(function () {
            var val = $('#addRedDate').val();
            if (val != "") {
                let v = Date.parse(val);
                if (v > Date.parse('1900-01-01')) $("#btnAddRed").prop("disabled", false);
                else $("#btnAddRed").prop("disabled", true); // Disables
            } else {
                $("#btnAddRed").prop("disabled", true); // Disables
            }
        });
    });

    function AddRed() {
        var rateEffectiveDateListing = {
            RateEffectiveDate: $('#addRedDate').val()
        }
        return LoadNotificationDialog("Adding RED...").then(() => {
            return new Promise((resolve, reject) => {
                $.ajax({
                    async: true,
                    url: "@Url.AbsoluteAction("AddRed", "Rate")",
                    data: JSON.stringify(rateEffectiveDateListing),
                    type: "POST",
                    contentType: "application/json;charset=utf-8",
                    success: function (response) {
                        if (response.Success) {

                            var redDateList = response.rpt.RedDateList;
                            var opt = '<option value="0" >RED Date List</option>';
                            for (var i = 0; i < redDateList.length; i++) {
                                opt += '<option value="' + redDateList[i].Value + '" >' + redDateList[i].Text + '</option>'
                            }
                            $("#drpRedDateList").html(opt);

                            $("#drpRedDateList option").filter(function () {
                                return this.text == rateEffectiveDateListing.RateEffectiveDate;
                            }).attr('selected', true).trigger('change');
                            $('#addRedDate').val('').trigger('change');

                            resolve();
                        }
                        else {
                            StaticAlert({ content: response.Message }).then(() => {
                                $("#drpRedDateList option").filter(function () {
                                    return this.text == rateEffectiveDateListing.RateEffectiveDate;
                                }).attr('selected', true).trigger('change');
                                $('#addRedDate').val('').trigger('change')

                                resolve();
                            });
                        }
                    },
                    error: function (errormessage) {
                        StaticAlert({ content: errormessage.responseText || errormessage }).then(() => {
                            resolve();
                        });
                    }
                });
            });
        }).then(() => {
            return ClearNotificationDialog();
        });
    }

    function GetREDRateInfo() {
        var redDateSelected = $("#drpRedDateList option:selected").text();
        $("#TextBoxContainer").empty();

        $("#btnReCalculate").prop("disabled", false);
        $("#btnCalcAllProviders").prop("disabled", false);
        $("#btnFinalizeAll").prop("disabled", false);
        $("#btnUnFinalizeAll").prop("disabled", false);
        $("#btnDeleteRate").prop("disabled", true);
        return LoadNotificationDialog("Get Info...").then(() => {
            return new Promise((resolve, reject) => {
                $.ajax({
                    async: true,
                    url: "@Url.AbsoluteAction("GetREDRateInfo", "Rate")",
                    data: JSON.stringify({ "redDate": redDateSelected }),
                    type: "POST",
                    contentType: "application/json;charset=utf-8",
                    success: function (result) {
                        if (result.Success) {
                            $("#rateInfo").show();
                            // Load Dynamic Textboxes
                            var rateParameters = result.AnnualRateSettingViewModel.DatabaseLookupValues;
                            let cnt = 1;
                            let fValue;
                            let sValue;
                            for (let i = 0; i <= rateParameters.length; i++) {
                                if (cnt === 1) {
                                    fValue = rateParameters[i];
                                }
                                else {
                                    sValue = rateParameters[i];
                                }
                                if ((cnt === 2) || (i === rateParameters.length)) {
                                    if (cnt != 2) {
                                        sValue = '';
                                    }
                                    $("#TextBoxContainer").append(GetDynamicTextBox(fValue, sValue));
                                    cnt = 0;
                                }
                                cnt++;
                            }
                            $('#TextBoxContainer input[type="text"').prop("disabled", true).attr("aria-label", "RED Info Disabled");
                            var gridColumns = result.AnnualRateSettingViewModel.GridColumns;
                            var providerInformationlList = result.AnnualRateSettingViewModel.RatePackageViewModelList;

                            // Build Grid - Data binding
                            LoadProviderList(gridColumns, providerInformationlList);

                            $("#divProviderInfo").show();

                            StateChangeUIElements(result);
                            resolve();
                        }
                        else {
                            StaticAlert({ content: result.Message || "Unknown error" }).then(() => {
                                resolve();
                            });
                        }
                    },
                    error: function (errormessage) {
                        StaticAlert({ content: errormessage.responseText || errormessage }).then(() => {
                            resolve();
                        });
                    }

                });
            });

        }).then(() => {
            return ClearNotificationDialog();
        });
    }

    $('#chkIsBaseYear').click(function () {
        var redDateSelected = $("#drpRedDateList option:selected").text();
        var checkedValue = $("#chkIsBaseYear").is(":checked");
        return LoadNotificationDialog("IsBaseYear...").then(() => {
            return new Promise((resolve, reject) => {
                var gridObj = $("#tblProviderList").ejGrid("instance");
                $.ajax({
                    url: "@Url.AbsoluteAction("UpdateIsBaseYear", "Rate")",
                    data: JSON.stringify({ "redDate": redDateSelected, isBaseYear: checkedValue }),
                    type: "POST",
                    contentType: "application/json;charset=utf-8",
                    dataType: "json",
                    success: function (result) {
                        if (result.Success) {
                            //GetREDRateInfoRefreshGrid();
                            //$("#divProviderDetailsHeader").hide();
                            //$("#divProviderDetails").hide();
                            resolve();
                        }
                        else {
                            StaticAlert({ content: result.Message || "Unknown error" }).then(() => {
                                resolve();
                            });
                        }
                    },
                    error: function (errormessage) {
                        StaticAlert({ content: errormessage.responseText || errormessage }).then(() => {
                            resolve();
                        });
                    }
                });
            });
        }).then(() => {
            return ClearNotificationDialog();
        });
    });

    function GetProvidersByRefreshList() {
        StaticConfirm({
            title: "Refresh/Get Providers for RED",
            content: "Getting providers may take some time; continue?",
            buttons: ["Ok", "Cancel"]
        }).then((key) => {
            if (key != 0) {
                return;
            }
            var redDateSelected = $("#drpRedDateList option:selected").text();
            $("#btnReCalculate").prop("disabled", false);
            $("#btnCalcAllProviders").prop("disabled", false);
            $("#btnFinalizeAll").prop("disabled", false);
            $("#btnUnFinalizeAll").prop("disabled", false);
            $("#btnDeleteRate").prop("disabled", true);
            return LoadNotificationDialog("Get Info...").then(() => {
                return new Promise((resolve, reject) => {
                    $.ajax({
                        async: true,
                        url: "@Url.AbsoluteAction("GetProvidersByRefreshList", "Rate")",
                        data: JSON.stringify({ "redDate": redDateSelected }),
                        type: "POST",
                        contentType: "application/json;charset=utf-8",
                        success: function (result) {
                            if (result.Success) {
                                $("#rateInfo").show();

                                var gridColumns = result.AnnualRateSettingViewModel.GridColumns;
                                var providerInformationlList = result.AnnualRateSettingViewModel.RatePackageViewModelList;
                                // Build Grid - Data binding
                                LoadProviderList(gridColumns, providerInformationlList);

                                $("#divProviderInfo").show();

                                StateChangeUIElements(result);
                                resolve();
                            }
                            else {
                                StaticAlert({ content: result.Message || "Unknown error" }).then(() => {
                                    resolve();
                                });
                            }
                        },
                        error: function (errormessage) {
                            StaticAlert({ content: errormessage.responseText || errormessage }).then(() => {
                                resolve();
                            });
                        }
                    });
                });
            }).then(() => {
                return ClearNotificationDialog();
            });
        });
    }

    // Grid refresh - Do not Re-bind DatabaseLookupValue
    function GetREDRateInfoRefreshGrid() {
        var redDateSelected = $("#drpRedDateList option:selected").text();
        $("#btnReCalculate").prop("disabled", false);
        $("#btnCalcAllProviders").prop("disabled", false);
        $("#btnFinalizeAll").prop("disabled", false);
        $("#btnUnFinalizeAll").prop("disabled", false);
        $("#btnDeleteRate").prop("disabled", true);
        return LoadNotificationDialog("Get Info...").then(() => {
            return new Promise((resolve, reject) => {
                $.ajax({
                    async: true,
                    url: "@Url.AbsoluteAction("GetProvidersByRED", "Rate")",
                    data: JSON.stringify({ "redDate": redDateSelected }),
                    type: "POST",
                    contentType: "application/json;charset=utf-8",
                    success: function (result) {
                        if (result.Success) {
                            $("#rateInfo").show();
                            var gridColumns = result.AnnualRateSettingViewModel.GridColumns;
                            var providerInformationlList = result.AnnualRateSettingViewModel.RatePackageViewModelList;

                            // Build Grid - Data binding
                            LoadProviderList(gridColumns, providerInformationlList);

                            $("#divProviderInfo").show();

                            StateChangeUIElements(result);
                            resolve();
                        }
                        else {
                            StaticAlert({ content: result.Message || "Unknown error" }).then(() => {
                                resolve();
                            });
                        }
                    },
                    error: function (errormessage) {
                        StaticAlert({ content: errormessage.responseText || errormessage }).then(() => {
                            resolve();
                        });
                    }

                });
            });

        }).then(() => {
            return ClearNotificationDialog();
        });
    }

    function LoadProviderList(gridColumns, providerInformationlList) {
        if (providerInformationlList.length > 0) {
            //for (var i = 0; i < providerInformationlList.length; i++) {
            //    if (providerInformationlList[i].FinalRateAmount !== null && providerInformationlList[i].FinalRateAmount !== '' && providerInformationlList[i].FinalRateAmount !== 'null') {
            //        providerInformationlList[i].FinalRateAmount = parseFloat(providerInformationlList[i].FinalRateAmount).toFixed(2);
            //    }
            //}
            $("#btnPrint").prop("disabled", false);
        }
        else {
            $("#btnPrint").prop("disabled", true);
        }

        var isFinalized = $.grep(providerInformationlList, function (item) {
            return item.IsFinalized === true;
        }).length > 0;

        if (isFinalized) {
            $("#chkFinalized").prop("checked", true);
        }
        else {
            $("#chkFinalized").prop("checked", false);
        }

        var cols = [];
        var GridColumns = gridColumns;
        // Create Custom Template for Finalized Column
        cols.push({ type: 'checkbox', width: '12' });
        cols.push({ field: 'IsFinalized', headerText: 'IsFinalized', width: '1', visible: false });
        cols.push({ headerText: 'Finalized', template: '#template', width: '25', textAlign: 'center' });
        for (var col = 0; col < GridColumns.length; col++) {
            // Build "Columns" and "Header Text"
            if (GridColumns[col].HeaderText == "Issuance") {
                cols.push({ field: GridColumns[col].Field, headerText: GridColumns[col].HeaderText, width: GridColumns[col].Width, cssClass: 'Wrap', textAlign: 'left', width: '23', visible: true });
            }
            else {
                cols.push({ field: GridColumns[col].Field, headerText: GridColumns[col].HeaderText, width: GridColumns[col].Width, cssClass: 'Wrap', textAlign: 'left', visible: true });
            }

        }
        $("#tblProviderList").ejGrid({
            dataSource: providerInformationlList,
            selectionSettings: { persistSelection: true },
            columns: cols,
            toolbarSettings: {
                showToolbar: true,
                toolbarItems: [ej.Grid.ToolBarItems.Search]
            },
            //rowDataBound: rowDataBound,
            //dataBound: function (args) {
            //    this.selectCheckboxes(1);
            //},
            pageSettings: { pageSize: 5, pageSizeList: [5, 10, 15, 20] },
            allowPaging: true,
            enableRowHover: true,
            allowSelection: true,
            allowSorting: true,
            allowTextWrap: true,
            editSettings: {},
            rowSelected: onRowSelected,
            rowDeselected: rowDeselected,
            //recordClick: recordClick
        });
    }

    /** On click event for the Appeal Rates (Copy All) button */
    function CopyFinalizedRates() {
        return StaticConfirm({
            title: "Appeal Rates",
            content: "This will copy all finalized (issued) rates. Do you want to continue?",
            buttons: ["Ok", "Cancel"]
        }).then((response) => {
            if (response != 0) return;

            //If there are unfinalized rates, confirm you want to copy all before starting the request
            let gridObj = $("#tblProviderList").ejGrid("instance");
            let unfinalized = gridObj.model.dataSource.filter((value) => !value.IsFinalized);
            if (unfinalized.length > 0) {
                StaticConfirm({
                    title: "Appeal Rates",
                    content: "One or more rates are not finalized; they will not be copied. Do you want to continue?",
                    buttons: ["Ok", "Cancel"]
                }).then((response) => {
                    if (response != 0) return;
                    CopyFinalizedRatesRequest();
                });
            }
            else CopyFinalizedRatesRequest(); //If there are no unfinalized rates, go ahead and start request
        })
    }

    /** function for handling server request for Appeal Rates (Copy All) button */
    function CopyFinalizedRatesRequest() {
        return LoadNotificationDialog("Appealing Rates...").then(() => {
            return new Promise((resolve, reject) => {
                $.ajax({
                    url: "@Url.AbsoluteAction("CopyFinalizedRates", "Rate")",
                    data: JSON.stringify({ redDate: $("#drpRedDateList option:selected").text() }),
                    type: 'POST',
                    contentType: "application/json;charset=utf-8",
                    dataType: 'json',
                    success: (response) => {
                        if (response.Success) {
                            GetREDRateInfoRefreshGrid();
                            selectedRowArray = [];
                            $("#divProviderDetailsHeader").hide();
                            $("#divProviderDetails").hide();
                            resolve();
                        } else {
                            StaticAlert({ content: response.Message || "Unknown error" }).then(() => {
                                resolve();
                            });
                        }
                    },
                    error: function (errormessage) {
                        StaticAlert({ content: errormessage.responseText || errormessage }).then(() => {
                            resolve();
                        });
                    }
                })
            });
        }).then(() => {
            return ClearNotificationDialog();
        });
    }

    // ***** Begin - Button Events below the Grid *****
    // TODO Calculation integration
    function RecalculateRate() {
        // Create grid object.
        var gridObj = selectedRowArray;
        if (gridObj.length >= 1)
        {
            return StaticConfirm({
				title: "Calculate Selected Rates",
				content: "Run calculations for selected rate(s). If several are selected, this may take some time.",
                buttons: ["Ok", "Cancel"]
            }).then((response) => {
                if (response != 0) return;

                return LoadNotificationDialog("Calculate Selected...").then(() => {
                    return new Promise((resolve, reject) => {

                        // Gets the names of primary key columns
                        $.ajax({
                            url: "@Url.AbsoluteAction("CalculateRates", "Rate")",
                            data: JSON.stringify({ providerData: gridObj }),
                            type: "POST",
                            contentType: "application/json;charset=utf-8",
                            dataType: "json",
                            success: function (result) {
                                if (result.Success) {
                                    GetREDRateInfoRefreshGrid();
                                    selectedRowArray = [];
                                    $("#divProviderDetailsHeader").hide();
                                    $("#divProviderDetails").hide();
                                    resolve();
                                }
                                else {
                                    StaticAlert({ content: result.Message || "Unknown error" }).then(() => {
                                        resolve();
                                    });
                                }
                            },
                            error: function (errormessage) {
                                StaticAlert({ content: errormessage.responseText || errormessage }).then(() => {
                                    resolve();
                                });
                            }
                        });
                    });
                }).then(() => {
                    return ClearNotificationDialog();
                });
            });
        }
    }

     // TODO Calculation integration
    function CalculateAll() {
        return StaticConfirm({
			title: "Calculate For All Rates",
			content: "Run calculations for ALL rates. This may take some time.",
            buttons: ["Ok", "Cancel"]
        }).then((response) => {
            if (response != 0) return;

            return LoadNotificationDialog("Calculate All...").then(() => {
                return new Promise((resolve, reject) => {
                    var gridObj = $("#tblProviderList").data("ejGrid");
