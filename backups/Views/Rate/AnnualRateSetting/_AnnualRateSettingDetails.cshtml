    function chkFinalize(RatePackageId, checkbox) {
        var gridObj = $("#tblProviderList").data("ejGrid");
        var args = $.grep(gridObj.model.dataSource, function (row) { return row.RatePackageId === RatePackageId })
        var data = args[0];
        var result = false;
        if (data.Issuance != '') {
            // This will return a promise object, not a value.
            result = UnFinalize(RatePackageId);
        }
        else if (data.Issuance === '') {
            // This will return a promise object, not a value.
            result = Finalize(RatePackageId);
        }

        // Once the promise is completed, get the value from the return.
        result.then((value) => {
            //data.IsFinalized
            if (value) {

                $(checkbox).prop("checked", true);
            }
            else {
                if (data.IsFinalized) {
                    $(checkbox).prop("checked", true);
                }
                else {
                    $(checkbox).prop("checked", false);
                }
            }
        });
    }

    function GetProviderRateInfoDetails() {
        var gridObj = $("#tblProviderList").ejGrid("getSelectedRecords");
        var redDateSelected = $("#drpRedDateList option:selected").text();
        $("#btnDeleteRate").prop("disabled", true);
        $("#divProviderDetails").hide();
        if (gridObj.length == 1) {
            var providerId = gridObj[0].ProviderId;
            var isFinalized = gridObj[0].IsFinalized;
            var ratePackageId = gridObj[0].RatePackageId;
            if (!isFinalized) {
                $("#btnDeleteRate").prop("disabled", false);
            }
            return LoadNotificationDialog("Get Provider Rate Info Details...").then(() => {
                return new Promise((resolve, reject) => {
                    $.ajax({
                        url: "@Url.AbsoluteAction("GetProviderRateInfoDetails", "Rate")",
                        data: JSON.stringify({ ratePackageId: ratePackageId, providerId: providerId, "redDate": redDateSelected }),
                        type: "POST",
                        contentType: "application/json;charset=utf-8",
                        dataType: "json",
                        success: function (result) {
                            if (result.Success) {
                                $("#AnnualRSDetailsLabelContainer").empty();
                                var providerRateInfoDetails = result.ProviderRateInfoDetailsVM;
                                // Load Dynamic Labels
                                LoadDynamicLabels(providerRateInfoDetails, ratePackageId, isFinalized);

                                $("#divProviderDetails").show();
                                resolve();
                            }
                            else {
                                StaticAlert({ content: result.Message || "Unknown error" }).then(() => {
                                    resolve();
                                });
                            }
                        },
                        error: function (errormessage) {
                            StaticAlert({ content: errormessage.responseText || errormessage }).then(() => {
                                resolve();
                            });
                        }
                    });
                });
            }).then(() => {
                return ClearNotificationDialog();
            });
        }
        else {
            // this needs to return a promise.
            return Promise.resolve();
        }
    }

    function LoadDynamicLabels(providerRateInfoDetails, ratePackageId, isFinalized) {
        let cnt = 1;
        let oddCnt = 1;
        let tValue;
        let fValue;
        let sValue;
        let flag = false;
        for (let i = 0; i < providerRateInfoDetails.length; i++) {

            // check if the number is even or odd
            let number = providerRateInfoDetails[i]["Sequence"];

            //check if the number is even
            if (number % 2 == 0) {
                sValue = providerRateInfoDetails[i];
                oddCnt++;
            }
            // if the number is odd
            else {
                if (cnt === 2 && !flag) {
                    tValue = providerRateInfoDetails[i];

                }
                else {

                    if (oddCnt === 2) {
                        $("#AnnualRSDetailsLabelContainer").append(GetDynamicLabel(fValue, sValue, tValue, ratePackageId, isFinalized));
                        fValue = '';
                        tValue = '';
                        sValue = '';
                        cnt = 0;
                        fValue = providerRateInfoDetails[i];
                        oddCnt = 1;
                    }
                    else {
                        oddCnt = 1;
                        fValue = providerRateInfoDetails[i];
                    }
                    oddCnt++;
                }
            }

            if (((cnt === 3) && (!flag))) {
                if (cnt != 3) {
                    sValue = '';
                }
                $("#AnnualRSDetailsLabelContainer").append(GetDynamicLabel(fValue, sValue, tValue, ratePackageId, isFinalized));
                flag = true;
                fValue = '';
                sValue = '';
                tValue = '';
                cnt = 0;
                oddCnt = 1;
            }
            else if ((cnt === 2) && (flag)) {
                if (cnt != 2) {
                    if ((fValue === '') && (sValue !== '')) {
                        fValue = '';
                    }
                    else {
                        sValue = '';
                    }
                }
                tValue = '';

                $("#AnnualRSDetailsLabelContainer").append(GetDynamicLabel(fValue, sValue, tValue, ratePackageId, isFinalized));
                fValue = '';
                sValue = '';
                cnt = 0;
                oddCnt = 1;
            }
            else if ((cnt !== 2) && (flag)) {
                if ((fValue === '') && (sValue !== '')) {
                    fValue = '';
                    tValue = '';

                    $("#AnnualRSDetailsLabelContainer").append(GetDynamicLabel(fValue, sValue, tValue, ratePackageId, isFinalized));
                    sValue = '';
                    cnt = 0;
                    oddCnt = 1;

                }
                else if ((fValue !== '') && (i === providerRateInfoDetails.length - 1)) {
                    sValue = '';
                    tValue = '';

                    $("#AnnualRSDetailsLabelContainer").append(GetDynamicLabel(fValue, sValue, tValue, ratePackageId, isFinalized));
                    fValue = '';
                    cnt = 0;
                }
            }
            cnt++;
        }
    }

