                            if (result.Success) {
                                GetREDRateInfoRefreshGrid();
                                $("#divProviderDetailsHeader").hide();
                                $("#divProviderDetails").hide();
                                resolve();
                            }
                            else {
                                StaticAlert({ content: result.Message || "Unknown error" }).then(() => {
                                    resolve();
                                })
                            }
                        },
                        error: function (errormessage) {
                            StaticAlert({ content: errormessage.responseText || errormessage }).then(() => {
                                resolve();
                            });
                        }
                    });
                });
            }).then(() => {
                return ClearNotificationDialog();
            });
        });
    }

    function FinalizeAll() {
        var returnValue = false
        return StaticConfirm({
            title: "Finalizing/Locking All Rates",
            content: "Finalize/Lock all providers.",
            buttons: ["Ok", "Cancel"]
        }).then((response) => {
            if (response != 0) return;

            return LoadNotificationDialog("Finalizing All...").then(() => {
                return new Promise((resolve, reject) => {
                    var gridObj = $("#tblProviderList").ejGrid("instance");
                    $.ajax({
                        url: "@Url.AbsoluteAction("FinalizeAll", "Rate")",
                        data: JSON.stringify({ providerData: gridObj.model.dataSource }),
                        type: "POST",
                        contentType: "application/json;charset=utf-8",
                        dataType: "json",
                        success: function (result) {
                            if (result.Success) {
                                GetREDRateInfoRefreshGrid();
                                $("#divProviderDetailsHeader").hide();
                                $("#divProviderDetails").hide();
                                $("#chkFinalized").prop("checked", true);
                                returnValue = true;
                                resolve();
                            }
                            else {
                                StaticAlert({ content: result.Message || "Unknown error" }).then(() => {
                                    resolve();
                                });
                            }
                        },
                        error: function (errormessage) {
                            StaticAlert({ content: errormessage.responseText || errormessage }).then(() => {
                                resolve();
                            });
                        }
                    });
                });
            }).then(() => {
                return ClearNotificationDialog();
            }).then(() => {
                return returnValue;
            });
        });
    }

    function Finalize(ratePackageId) {
        var returnValue = false;
        return StaticConfirm({
            title: "Finalizing/Locking Rates",
            content: "Finalize/Lock selected provider rates?",
            buttons: ["Ok", "Cancel"],
        }).then((response) => {
            if (response != 0) {
                return;
            }
            return LoadNotificationDialog("Finalizing...").then(() => {
                return new Promise((resolve, reject) => {
                    var gridObj = $("#tblProviderList").ejGrid("instance");
                    $.ajax({
                        url: "@Url.AbsoluteAction("Finalize", "Rate")",
                        data: JSON.stringify({ ratePackageId: ratePackageId }),
                        type: "POST",
                        contentType: "application/json;charset=utf-8",
                        dataType: "json",
                        success: function (result) {
                            if (result.Success) {
                                GetREDRateInfoRefreshGrid();
                                $("#divProviderDetailsHeader").hide();
                                $("#divProviderDetails").hide();
                                returnValue = true;
                                resolve();
                            }
                            else {
                                StaticAlert({ content: result.Message || "Unknown error" }).then(() => {
                                    resolve();
                                });
                            }

                        },
                        error: function (errormessage) {
                            StaticAlert({ content: errormessage.responseText || errormessage }).then(() => {
                                resolve();
                            });
                        }

                    });
                });
            }).then((response) => {
                return ClearNotificationDialog();
            }).then(() => {
                return returnValue;
            });
        });
    }

