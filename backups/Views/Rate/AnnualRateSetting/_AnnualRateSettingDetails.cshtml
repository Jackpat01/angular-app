    function StateChangeUIElements(result) {
        // Disable Buttons when Grid Data is empty
        var array = result.AnnualRateSettingViewModel.RatePackageViewModelList;
        if (array != null &&
            array.length == 0) {
            $("#btnReCalculate").prop("disabled", true);
            $("#btnCalcAllProviders").prop("disabled", true);
            $("#btnFinalizeAll").prop("disabled", true);
            $("#btnUnFinalizeAll").prop("disabled", true);
            $("#divProviderDetailsHeader").hide();
        }
        else if (array.every(x => x.IsFinalized == true)) {
            $("#btnReCalculate").prop("disabled", true);
            $("#btnCalcAllProviders").prop("disabled", true);
            $("#btnFinalizeAll").prop("disabled", true);
            $("#btnDeleteRate").prop("disabled", true);
        }
        else if (array.some(x => x.IsFinalized == true)) {
            $("#btnCalcAllProviders").prop("disabled", true);
            $("#btnDeleteRate").prop("disabled", true);
            $("#btnReCalculate").prop("disabled", false);
            $("#btnFinalizeAll").prop("disabled", false);
            $("#btnUnFinalizeAll").prop("disabled", false);
        }
        else {
            $("#btnReCalculate").prop("disabled", false);
            $("#btnCalcAllProviders").prop("disabled", false);
            $("#btnFinalizeAll").prop("disabled", false);
            $("#btnUnFinalizeAll").prop("disabled", false);
            $("#divProviderDetailsHeader").show();
        }
        //IsBaseYear Checkbox condition
        if (array.every(x => x.IsBaseYear == true)) {
            $("#chkIsBaseYear").prop("checked", true);
        }
        else {
            $("#chkIsBaseYear").prop("checked", false);
        }
    }


