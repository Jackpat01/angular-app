            td2.attr("style", "width: 30%");
            td2.attr("align", "right");
            td2.attr("padding", "10px");

            var label1 = $("<label />");
            label1.attr("style", "font-weight: bold;");
            label1.text(sValue["DisplayName"]);
            td2.append(label1);

            var td3 = $("<td />");
            td3.attr("style", "width: 20%");
            td3.attr("align", "left");
            td3.attr("padding", "10px");

            var textBox1 = $("<input />").attr("type", "text").attr("name", sValue["Key"]).attr("id", sValue["DatabaseLookupVariableId"]).attr("style", "width: 150px;");
            textBox1.val(sValue["Value"]);
            td3.append(textBox1);

            tr.append(td2);
