@*
    DO NOT MODIFY OUTSIDE OF MSLC.STATLOG
    This file comes from MSLC.Statlog, any changes to it will be wiped out when the nuget package is updated.
    Please make the appropriate enhancements to MSLC.Statlog instead of here.
*@

@using MSLC.Portal.MVC.Utility
@model MSLC.StatLog.MVC.ViewModels.SendEmailViewModel.View
@Styles.Render("~/Content/StatLog.css")
@{
    Layout = null;
    bool userIsReadOnly = false;
}

<script src="~/Scripts/jquery.validate.js" type="text/javascript"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.js" type="text/javascript"></script>
<link href="~/Content/south-street/jquery-ui-1.9.2.custom.min.css" rel="stylesheet" />


<script src="~/Scripts/jHtmlArea-0.8.js" type="text/javascript"></script> @*Used for editing bulletin boards*@
<script src="~/Scripts/jHtmlArea.ColorPickerMenu-0.8.js" type="text/javascript"></script> @*Used for editing bulletin boards*@

<link href="~/Content/jHtmlArea/jHtmlArea.ColorPickerMenu.css" rel="stylesheet" type="text/css" />
<link href="~/Content/jHtmlArea/jHtmlArea.css" rel="stylesheet" type="text/css" />
<link href="~/Content/jHtmlArea/jHtmlArea.Editor.css" rel="stylesheet" type="text/css" />

@Html.Script("~/Scripts/Pages/Communication/SendEmail.js", "jquery")

<style>
    .datepicker {
        z-index: 1151 !important;
    }
</style>

<div id="GetUsersByType" data-url="@Url.AbsoluteAction("GetUsersByType","Communication")"></div>

@using (Html.BeginForm("Send", "Communication", FormMethod.Post, new { id = "frmEmailSubmit", enctype = "multipart/form-data", @class = "modal-form", defaultbutton = "btnSend" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.sCostReportID, new { id = "sCostReportID" })

    <div class="modal-content">
        <div class="modal-header">
            <h3 id="myModalLabel" style="text-align: left;">Send Email - @(Model.ProviderName)</h3>
            <button href="#" class="close" data-dismiss="modal">&times;</button>
        </div>
        <div class="modal-body">
            <div style="padding-left: 15px; padding-right: 35px; margin: 8px;" class="ui-tabs ui-widget ui-widget-content ui-corner-all">
                <table class="w-100">
                    <tr><td colspan="2" style="height: 5px;"></td></tr>
                    <tr>
                        <td>
                            <label for="txtEmail_Type" class="FormLabel">Type:</label>
                        </td>
                        <td align="left">
                            @Html.DropDownListFor(x => x.Email_Type, Model.TypeList, new { id = "txtEmail_Type", @style = "width: 50%;" })
                            <div class="errorLabelSml">@Html.ValidationMessageFor(model => model.Email_Type)</div>
                        </td>
                        <td></td>
                    </tr>
                    @*<tr>
                            <td>
                                <label class="FormLabel">To:</label>
                            </td>
                            <td align="left">
                                <input id="btnAdd" type="button" value="Add" onclick="AddTextBox()" />
                                <div id="TextBoxContainer">
                                    <!--Textboxes will be added here -->
                                </div>
                                <div class="errorLabelSml">@Html.ValidationMessageFor(model => model.Email_To)</div>
                            </td>
                            <td></td>
                        </tr>*@

                    <tr><td colspan="2" style="height: 10px;"></td></tr>
                    <tr>
                        <td>
                            <label class="FormLabel" for="Email_To_hidden">To:</label>
                        </td>
                        <td align="left">

                            @(Html.EJ().DropDownList("Email_To")
                                .DropDownListFields(
                                    df => df.ID("Value").Text("Text").Value("Value"))
                                .Width("300px")
                                .MultiSelectMode(MultiSelectModeTypes.VisualMode)
                                .ShowCheckbox(true)
                                .Enabled(false)
                                .WatermarkText("Select recipients"))
                        </td>
                        <td></td>
                    </tr>
                    @*<tr>
                            <td>
                                <label class="FormLabel">CC:</label>
                            </td>
                            <td align="left">
                                @Html.TextBoxFor(x => x.Email_CC, new { id = "txtEmail_CC", @style = "width: 50%;" })
                                <div class="errorLabelSml">@Html.ValidationMessageFor(model => model.Email_CC)</div>
                            </td>
                        </tr>*@
                    @*<tr>
                            <td>
                                <label class="FormLabel">BCC:</label>
                            </td>
                            <td align="left">
                                @Html.TextBoxFor(x => x.Email_BCC, new { id = "txtEmail_BCC", @style = "width: 50%;" })
                                <div class="errorLabelSml">@Html.ValidationMessageFor(model => model.Email_BCC)</div>
                            </td>
                        </tr>*@

                    <tr><td colspan="2" style="height: 10px;"></td></tr>

                    <tr>
                        <td>
                            <label for="txtEmail_SenderName" class="FormLabel">From:</label>
                        </td>
                        <td align="left" rowspan="2">
                            @Html.TextBoxFor(x => x.Email_SenderName, new { id = "txtEmail_SenderName", @style = "width: 40%;" })
                            <label for="txtEmail_SenderEmail">Email</label>
                            <text><</text>
                            @Html.TextBoxFor(x => x.Email_SenderEmail, new { id = "txtEmail_SenderEmail", @style = "width: 40%;" })
                            <text>></text>
                            <div class="errorLabelSml">@Html.ValidationMessageFor(model => model.Email_SenderName)</div>
                        </td>
                    </tr>
                    <tr><td colspan="2" style="height: 10px;"></td></tr>
                    <tr>
                        <td>
                            <label for="txtEmail_ReplyTo" class="FormLabel">Reply To:</label>
                        </td>
                        <td align="left">
                            @Html.TextBoxFor(x => x.Email_ReplyTo, new { id = "txtEmail_ReplyTo", @style = "width: 100%;" })
                            <div class="errorLabelSml">@Html.ValidationMessageFor(model => model.Email_ReplyTo)</div>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label for="txtEmail_Subject" class="FormLabel">Subject:</label>
                        </td>
                        <td align="left">
                            @Html.TextBoxFor(x => x.Email_Subject, new { id = "txtEmail_Subject", @style = "width: 100%;" })
                            <div class="errorLabelSml">@Html.ValidationMessageFor(model => model.Email_Subject)</div>
                        </td>
                    </tr>
                    <tr><td colspan="2" style="height: 10px;"></td></tr>
                    <tr>
                        <td>
                            <label for="txtEmail_Message" class="FormLabel">Message:</label>
                        </td>
                        <td class="customHtmlArea">
                            @Html.TextAreaFor(x => x.Email_Message, new { id = "txtEmail_Message", @style = "height: 300px;", @class = "w-100" })
                            <div class="errorLabelSml">@Html.ValidationMessageFor(model => model.Email_Message)</div>
                        </td>
                    </tr>
                    <tr><td colspan="2" style="height: 10px;"></td></tr>

                    <tr>
                        <td>
                            <label for="txtEmail_MinsToWait" class="FormLabel">Delay Sending:</label>
                        </td>
                        <td align="left">
                            @Html.TextBoxFor(x => x.Email_MinsToWait, new { id = "txtEmail_MinsToWait", @style = "width: 20%;" })
                            <text>min(s)</text>
                            <div class="errorLabelSml">@Html.ValidationMessageFor(model => model.Email_MinsToWait)</div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <div id="dvFooter" class="modal-footer mslcModalFooter">
            <div style="margin-left: auto; margin-right: auto;">
                <div class="myImage" style="display: none; text-align: center;">
                    <img src="~/Images/loading.gif" alt="Loading" width="32" height="32" />
                </div>
                <div class="myControls">
                    <button class="btn btn-basic BoldMe" data-dismiss="modal" aria-hidden="true" style="color:black">Close</button>&nbsp;&nbsp;

                    @if (!userIsReadOnly)
                    {
                        <button id="btnSend" type="submit" class="btn btn-success BoldMe" name="Command" value="Send">Send</button><text>&nbsp;&nbsp;</text>
                    }
                </div>
            </div>
        </div>
    </div>
}

<div id="SyncFusionScript">
    <script src="@Url.AbsoluteContent("~/Scripts/ej/common/ej.unobtrusive.min.js")"></script>
</div>